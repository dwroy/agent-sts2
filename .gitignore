# agent-sts2: one repo since 2026-10-04 (docs/layout.md).

# Project-root data that is not in git: raw logs, rebuildable data (game data cache, log database and its venv), the
# package's node_modules. In a worktree they are links to the main checkout's.
/logs
/data
/node_modules
/agent/node_modules
node_modules/
dist/
logs/
fixtures/
.cache/
.env
.env.local
*.log
# ops' own logs are tracked (autoplay.log, refresh.log, stop-after-*.log, restarts.log).
!ops/*.log

# Worktrees of this repo, and the old code repo with its worktrees until they are removed.
/.worktrees/
/jev-sts2/
/jev-sts2-*/

# Large or duplicated archives (backed up to the Windows drive instead).
paper/raw/
paper/materials/session/
paper/materials/code/
# Local tool state and runtime output.
.claude/
ops/autoplay.out
ops/*.lock
ops/.auto-relaunch-fails*
ops/STOP
# The codex ops session's runtime state: queue, broker, wake logs, session id (docs/codex-ops.md).
ops/codex-ops/
*.pyc
__pycache__/

# local scratch: upstream docs snapshots used while writing PLAN.md
research-notes/

# brain replay raw outputs (summaries are committed)
experiments/brain-replay/**/results.jsonl
experiments/brain-replay/**/brain*.jsonl
experiments/brain-replay/**/deepseek-reasoning*.jsonl
# build-facts replay raw outputs and rendered questions (summaries and targets are committed)
experiments/build-facts-m2/**/results.jsonl
experiments/build-facts-m2/**/brain*.jsonl
experiments/build-facts-m2/**/deepseek-reasoning*.jsonl
experiments/build-facts-m2/**/dataset.jsonl
# M2 route replay raw outputs (summary committed)
experiments/route-m2/*.jsonl
# MECH_DEATH_MOVE replay: the frozen log copy, per-turn rows and run logs (the report, boards and digests are committed)
experiments/deathmove/frozen/
experiments/deathmove/*.jsonl
experiments/deathmove/*.log
# Lizard Tail replay raw outputs (tools/lizard-tail-replay.ts)
experiments/lizard-tail/*.jsonl
experiments/insatiable/*.jsonl
experiments/insatiable/*.log
# SL judge bounds replay raw outputs (tools/sl-judge-bounds-replay.ts; the summary is committed)
experiments/sl-judge-bounds/*.jsonl
experiments/sl-judge-bounds/*.txt
# Waterfall Giant rollout replay raw rows (tools/giant-replay.ts; the summary is committed)
experiments/giant-replay/*.jsonl
# DEATH_MOVES replay for the other enemies (tools/living-death-moves-replay.ts; the summary is committed)
experiments/living-death-moves/*.jsonl
# CARD_CONDITIONS replay raw rows (tools/card-conditions-replay.ts; the summary and the frame sets are committed)
experiments/card-conditions/*.jsonl
