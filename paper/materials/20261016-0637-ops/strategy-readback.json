        {
          "id": "silent-proposal-19a5cff2094e2d8f",
          "state": "waiting",
          "reason": "MTQ同盘换线与7X复活血池仅有局部观测；缺未截断入伤、持续实体归属和同输入整战校准，不能由死亡率饱和拟新SL/终局规则。"
        },
        {
          "id": "silent-proposal-3540bf4360bf80af",
          "state": "waiting",
          "reason": "已有HP增加边界和离线资源链；尚缺完整回血来源/逐槽归因及原路线、休息消费者的联合读回，不能以净变化代已到资源或整项实现。"
        },
        {
          "id": "silent-proposal-0ea5c0b9c030fdd6",
          "state": "waiting",
          "reason": "懒惰奇巧提示及限定恶魔6毒入口已存在；完整合法后继仍标continuation_verified=false，缺自动重放/后继收益及多轮消费者校准，不能把局部覆盖当整项重复。"
        },
        {
          "id": "silent-proposal-f915ec544ab94b6e",
          "state": "waiting",
          "reason": "既有离线工具可关联原答、SL替换和重问，但完整候选收益仍null；KFR T6整轮开端未核、F12原护栏线中断，缺可归属的完整实线及排序对照。"
        },
        {
          "id": "silent-proposal-8fb51933639faf90",
          "state": "waiting",
          "reason": "限定毒药及力敏/覆甲局部模型已有；覆甲完整减层条件未隔离，叠加药效、能力、能量的多入口联合校准和完整时点收益仍不足。"
        },
        {
          "id": "silent-proposal-b3bc0eb09211af6c",
          "state": "waiting",
          "reason": "奇巧资源提示已有，完整后继与未建立收益仍未知；六次T7和局部SL均未证明替顺序可存活，缺整战兑现与终局价值校准。"
        },
        {
          "id": "silent-proposal-fdc3a505fe5e1a55",
          "state": "waiting",
          "reason": "KFR实际休息、幕间、开场和SL恢复可分列，现有观测器已覆盖部分；完整路线/休息消费链、逐源归因及替路线对照仍缺，不能关闭整项。"
        },
        {
          "id": "silent-proposal-5a95725089f53cd8",
          "state": "waiting",
          "reason": "GX局部复活后3/13血、0/7挡及药槽变化已有审计；缺复活瞬时逐击、未截断入伤、前三出口和完整候选归属，不能据10血/8伤差改规则。"
        },
        {
          "id": "silent-proposal-51fa8bc34774f72d",
          "state": "waiting",
          "reason": "四次假inserted与升级键作差路径可复现；缺仅改标瞬时帧、稳定物理副本身份和并发抽牌/插入次序，不能仅按基ID守恒延长SL已知前缀。"
        },
        {
          "id": "silent-proposal-29b7b36dffbcb017",
          "state": "waiting",
          "reason": "GX已建触媒两层的84毒伤和末战未建立能力可核，既有局部模型不缺；头骨/毒雾/覆甲/力敏联合多轮校准及完整时点对照仍不足。"
        }
      ],
