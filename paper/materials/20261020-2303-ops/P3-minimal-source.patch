+    metrics: [{ reflex_id: entry.id, n: s.n.take + s.n.not_take, method: "Synthetic run-cluster fixture", design: "observational",
+      effect_size: s.value, se: s.se, frequency: { n: 40, total: 100 }, evidence: entry.evidence.observations }],
