diff --git a/agent/tests/run-config-git-failure.test.ts b/agent/tests/run-config-git-failure.test.ts
new file mode 100644
index 000000000..a7e58ecfe
--- /dev/null
+++ b/agent/tests/run-config-git-failure.test.ts
@@ -0,0 +1,54 @@
+import { execFileSync } from "node:child_process";
+import { beforeEach, expect, it, vi } from "vitest";
+import { codeInfo } from "../src/eye/run-config.js";
+
+vi.mock("node:child_process", async (original) => ({
+  ...await original<typeof import("node:child_process")>(), execFileSync: vi.fn(),
+}));
+
+const head = "1234567890abcdef1234567890abcdef12345678";
+let dirty: boolean | "unavailable";
+let finalHead: string;
+let detached: boolean;
+let unavailableHead: boolean;
+
+beforeEach(() => {
+  dirty = true; finalHead = head; detached = false; unavailableHead = false;
+  let headReads = 0;
+  vi.mocked(execFileSync).mockReset().mockImplementation((_file, args, options) => {
+    const command = (args as string[]).slice(2);
+    if (command[0] === "status") throw new Error("spawnSync git ENOBUFS");
+    expect(options).toMatchObject({ maxBuffer: 4096, timeout: 10_000 });
+    if (command[0] === "rev-parse") {
+      if (unavailableHead) throw new Error("not a repository");
+      return headReads++ === 0 ? head : finalHead;
+    }
+    if (command[0] === "symbolic-ref") {
+      if (detached) throw Object.assign(new Error("detached"), { status: 1 });
+      return "live\n";
+    }
+    expect(command).toEqual(["diff", "--quiet", "--no-ext-diff", "HEAD", "--"]);
+    if (dirty) throw Object.assign(new Error("diff failed"), { status: dirty === true ? 1 : 128 });
+    return "";
+  });
+});
+
+// R417: all sixteen configuration rows from eight runs lost their source identity.
+it("retains verified HEAD and bounded dirty provenance after status ENOBUFS", () => {
+  expect(codeInfo("/fixed/live")).toEqual({ commit: head, code: "1234567+dirty", branch: "live",
+    dirty: true, dirty_files: [], worktree: "live", error: "git status failed: spawnSync git ENOBUFS" });
+});
+
+it("distinguishes clean detached HEAD, unavailable dirty state and unavailable HEAD", () => {
+  dirty = false; detached = true;
+  expect(codeInfo("/fixed/live")).toMatchObject({ commit: head, code: "1234567", branch: null, dirty: false });
+  dirty = "unavailable";
+  expect(codeInfo("/fixed/live")).toMatchObject({ commit: head, code: null, dirty: null });
+  unavailableHead = true;
+  expect(codeInfo("/fixed/live")).toMatchObject({ commit: null, code: null, dirty: null });
+});
+
+it("rejects mixed source identities when HEAD changes between bounded probes", () => {
+  finalHead = "a".repeat(40);
+  expect(codeInfo("/fixed/live")).toMatchObject({ commit: null, code: null, branch: null, dirty: null });
+});
