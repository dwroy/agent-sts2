+/** 9Z9H2EXKLF3T A10 F48 T10, silent-0180: only the measured three-card preview/Forge combination. */
+function observedLegionDeflectPreview(runRaw: unknown, combat: Record<string, unknown>): boolean {
+  const run = asRecord(runRaw);
+  if (str(run["character_id"]).toLowerCase() !== "silent" || num(run["ascension"]) !== 10 || num(run["floor"]) !== 48) return false;
+  const player = asRecord(combat["player"]);
+  if (num(player["block"]) !== 0 || powerAmount(player, "DEXTERITY_POWER") !== 2) return false;
+  const powers = new Set(["THORNS_POWER", "NOXIOUS_FUMES_POWER", "MASTER_PLANNER_POWER", "ACCELERANT_POWER", "DEXTERITY_POWER"]);
+  if (asArray(player["powers"]).map(asRecord).some((power) => num(power["amount"]) !== 0 && !powers.has(str(power["power_id"])))) return false;
+  const enemies = asArray(combat["enemies"]).map(asRecord).filter((enemy) => enemy["is_alive"] !== false);
+  if (enemies.length !== 1 || str(enemies[0]!["enemy_id"]) !== "AEONGLASS") return false;
+  const faces = asArray(combat["hand"]).map(asRecord).flatMap((card) => {
+    const block = asArray(card["dynamic_values"]).map(asRecord).find((value) => str(value["name"]) === "Block");
+    return block ? [{ card, block }] : [];
+  });
+  if (faces.length !== 3) return false;
+  return [["DEFLECT", true, 7], ["DEFLECT", false, 4], ["DEFEND_SILENT", false, 5]].every(([id, upgraded, base]) =>
+    faces.some(({ card, block }) => str(card["card_id"]) === id && bool(card["upgraded"]) === upgraded &&
+      num(block["base_value"]) === base && num(block["enchanted_value"]) === base && num(block["current_value"]) === 2 * (Number(base) + 2)));
+}
