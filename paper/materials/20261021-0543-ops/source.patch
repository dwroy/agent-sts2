@@ -0,0 +1,91 @@
+/** 9Z9H2EXKLF3T A10 F48 T10, silent-0180: 18 + 9 + 10 Block, not 50. */
+import { resolve } from "node:path";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { loadConfig } from "../src/core/config.js";
+import { parseGameState } from "../src/hand/mod/schema.js";
+import { setCardUpgradesForTests } from "../src/knowledge/card-upgrades.js";
+import { makeKnowledge } from "../src/knowledge/index.js";
+import { buildRunBrief } from "../src/memory/run-brief.js";
+import { createScreenMemory, type DecisionEnv } from "../src/memory/types.js";
+import { paelsLegionPreview, planCombatTurn } from "../src/reflex/combat-plan.js";
+import { replaySteps, solveTap, type SolverInput } from "../src/reflex/turn-solver.js";
+import evidence from "./silent-legion-forge-evidence.json";
+
+vi.mock("node:fs", async (original) => {
+  const fs = await original<typeof import("node:fs")>();
+  const { KNOWLEDGE_DIR } = await import("../src/knowledge/files.js");
+  const readFileSync = ((path: Parameters<typeof fs.readFileSync>[0], ...args: unknown[]) => {
+    if (typeof path === "string" && resolve(path).startsWith(resolve(KNOWLEDGE_DIR) + "/")) {
+      throw Object.assign(new Error("ENOENT: frozen Legion/Forge evidence"), { code: "ENOENT" });
+    }
+    return (fs.readFileSync as (...args: unknown[]) => unknown)(path, ...args);
+  }) as typeof fs.readFileSync;
+  return { ...fs, readFileSync, default: { ...fs, readFileSync } };
+});
+
+const knowledge = makeKnowledge({ cards: evidence["287999"].state.run.deck.map((card) => ({ id: card.card_id, type: card.card_type })),
+  monsters: [{ id: "AEONGLASS", type: "Boss" }] }, "cache");
+beforeEach(() => {
+  // Both differences are visible in the same frozen drink, before and after.
+  setCardUpgradesForTests({ DEFLECT: { n: [1, 1], vars: { Block: [4, 7] } },
+    DEFEND_SILENT: { n: [1, 1], vars: { Block: [5, 8] } },
+    STRIKE_SILENT: { n: [1, 1], vars: { Damage: [6, 9] } } });
+});
+afterEach(() => { solveTap.onSolve = null; setCardUpgradesForTests(null); });
+
+function captured(key: "287999" | "288000", character = "SILENT"): SolverInput {
+  const raw: Record<string, any> = structuredClone(evidence[key].state);
+  raw.run.character_id = character;
+  const state = parseGameState(raw);
+  const env: DecisionEnv = { state, knowledge, brief: buildRunBrief(state, knowledge),
+    thresholds: loadConfig({}).thresholds, runStart: "auto", characterPreference: null,
+    allowFtueModals: false, strictJev: true, screenMemory: createScreenMemory("COMBAT"), shopDiscardPotions: [] };
+  let input: SolverInput | undefined;
+  const capturedInput = new Error("captured production solver input");
+  solveTap.onSolve = (value) => { input = value; throw capturedInput; };
+  try { planCombatTurn(env); } catch (error) { if (error !== capturedInput) throw error; }
+  finally { solveTap.onSolve = null; }
+  if (!input) throw new Error("the observed frame was not solved");
+  return input;
+}
+
+function plays(input: SolverInput, keys: (number | "forge")[]) {
+  return keys.map((key) => {
+    const card = input.hand.find((entry) => key === "forge" ? entry.cardId === "POTION:BLESSING_OF_THE_FORGE:1" : entry.index === key)!;
+    if (!card) throw new Error(`missing observed step ${key}`);
+    return { cardIndex: card.index, cardId: card.cardId, name: card.name, upgraded: card.upgraded,
+      ...(card.target === "single" ? { target: 0 } : {}) };
+  });
+}
+
+it("the original production input predicts the observed 37 Block across the drink", () => {
+  const input = captured("287999");
+  expect(replaySteps(input, plays(input, [0, "forge", 2, 3, 4]))!.outcome.blockGained).toBe(37);
+});
+
+it("re-planning after the first Block adds only nine plus ten", () => {
+  const input = captured("288000");
+  expect(replaySteps(input, plays(input, ["forge", 1, 2, 3]))!.outcome).toMatchObject({ blockGained: 19, hpLoss: 15, hpAfter: 3 });
+});
+
+it("the same raw frame retains Ironclad's existing displayed-Block calculation", () => {
+  const input = captured("287999", "IRONCLAD");
+  expect(replaySteps(input, plays(input, [0, "forge", 2, 3, 4]))!.outcome.blockGained).toBe(50);
+});
+
+it("keeps different ascensions, enemies, enchanted faces and extra modifiers outside the new scope", () => {
+  const test = (edit: (raw: Record<string, any>) => void) => {
+    const raw: Record<string, any> = structuredClone(evidence["287999"].state);
+    edit(raw);
+    return paelsLegionPreview(raw.run, raw.combat);
+  };
+  expect(test(() => {})).toBe(true);
+  expect(test((raw) => { raw.run.ascension = 9; })).toBe(false);
+  expect(test((raw) => { raw.run.floor = 33; })).toBe(false);
+  expect(test((raw) => { raw.combat.enemies[0].enemy_id = "OTHER_ENEMY"; })).toBe(false);
+  expect(test((raw) => { raw.combat.hand[0].dynamic_values.find((v: any) => v.name === "Block").enchanted_value += 1; })).toBe(false);
+  expect(test((raw) => { raw.combat.player.powers.push({ power_id: "AFTERIMAGE_POWER", amount: 1 }); })).toBe(false);
+  expect(test((raw) => { raw.run.relics.find((relic: any) => relic.relic_id === "PAELS_LEGION").stack = 2; })).toBe(false);
+  expect(test((raw) => { raw.run.relics.push({ relic_id: "VAMBRACE" }); })).toBe(false);
+  expect(paelsLegionPreview(evidence["288000"].state.run, evidence["288000"].state.combat)).toBe(false);
+});
