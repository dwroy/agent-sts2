    "dispositions": [
      {
        "id": "silent-proposal-08eaa60bcc449852",
        "state": "waiting",
        "reason": "缺KEN同入口资源、同后续牌序的不饮用/留药至boss整战对照；已核资源结转不能校准药水持有价格。"
      },
      {
        "id": "silent-proposal-92920295a648b540",
        "state": "waiting",
        "reason": "缺固定后续抽牌和生成牌的连续通关替线；T6省3血同时少扣9，首boss赢且余4血不能证明SL或连战排序改善。"
      },
      {
        "id": "silent-proposal-a327449c331efbc1",
        "state": "waiting",
        "reason": "缺血量与沙坑双边界的完整受控后继及独立成功验证；同轮9血/15伤和4血/一沙坑不能拟成固定换线阈值。"
      },
      {
        "id": "silent-proposal-a099e89437e942bb",
        "state": "waiting",
        "reason": "确定生成和当前容量已实现；缺计划妥当保留选择、完整候选派发与实际SL恢复的联合消费者验证，不能把局部容量实现当整项duplicate。"
      },
      {
        "id": "silent-proposal-47910f82a1fdd98f",
        "state": "waiting",
        "reason": "开场扣4及连战接续已有实现；缺留药、路线、SL完整受控后继与未知回复/复活组合结算顺序，不能关闭整个资源价值提案。"
      },
      {
        "id": "silent-proposal-f1374df72d8e6a25",
        "state": "waiting",
        "reason": "缺隔离机制误差后的同预算完整后继，以及未用、早用、留药的成对整战结果；两条资源链不足拟合终局或药水权重。"
      },
      {
        "id": "silent-proposal-38a49e6c97f31eea",
        "state": "waiting",
        "reason": "普通紧勒和磨蚀主动预览已有实现；缺弃牌自动触发、增益分源、重接、逐击反伤及再生的完整联合消费者校准，不能以一个子公式关闭整项。"
      },
      {
        "id": "silent-proposal-ef0e38a5dbd3bc07",
        "state": "waiting",
        "reason": "缺另选营火、事件、路线及用药时机的完整受控结果；现有资源端点与计划条件变化不能拟合资源权重或因果收益。"
      },
      {
        "id": "silent-proposal-7f820c02d39bfaea",
        "state": "waiting",
        "reason": "预测比较已有实现；缺成对完整后继、整候选派发归属与同预算饱和排序校准；原计划被弃牌重规划，六次全败不能证明新门槛。"
      },
      {
        "id": "silent-proposal-04b6b430759815ed",
        "state": "waiting",
        "reason": "油灯缺可靠首次消费来源及跨动作、新战、SL恢复联合验证；朝向取整仅局部观察，能力完整后继未证，不能把现场放大套到每次施用。"
      }
    ],
