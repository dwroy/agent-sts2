      "proposal_results": [
        {
          "id": "silent-proposal-89354805ee4d7e77",
          "state": "waiting",
          "reason": "已有普通神化和已观察升级配对子实现；仍缺跨重问、选牌、药水、SL与换战边界的实际施放持续归属及完整消费者校准，actual_cast_this_fight仍为null。"
        },
        {
          "id": "silent-proposal-f2bfceddb1898dca",
          "state": "waiting",
          "reason": "缺同起点、同随机池、同总预算的MC先行与预留非药预算配对，以及候选稳定性随预算的曲线；d269748与d269754指纹不同，不能拿两问样本1→12当受控收益。"
        },
        {
          "id": "silent-proposal-283a164780d11e69",
          "state": "waiting",
          "reason": "与89354805ee4d7e77共享原神化证据，但原经验要求的实际施放归属和后继消费仍未闭环；已有局部源码不足将整项记duplicate，且不能只因同主题就关闭。"
        },
        {
          "id": "silent-proposal-ebbfe3b97548756d",
          "state": "waiting",
          "reason": "本批可核局部敏捷/勒紧/毒/临时减力及资源事实，但缺15子项逐来源、持续期限、升级属性组合与战斗/路线/休息生产调用的联合校准，不能以若干窄修复覆盖全项。"
        },
        {
          "id": "silent-proposal-e5b87be50f28f311",
          "state": "waiting",
          "reason": "已有候选、护栏、单动作回执、相邻观测和终局/整轮端点；本批离线读回58段候选均无完整执行归属。缺跨选牌、抽牌、重问和SL的持续候选执行认证及整线兑现，不据同盘局部差改探索阈值。"
        },
        {
          "id": "silent-proposal-49632bc4878fb597",
          "state": "waiting",
          "reason": "加压0→4→8力与喷水11→15→19、弱后11/14可重核；但本批无正敏捷建立，缺力量逐击、正负敏捷、虚弱和独立成长的生产联合固定校准，单步法提交不能关闭复合请求。"
        },
        {
          "id": "silent-proposal-66532328a585941f",
          "state": "waiting",
          "reason": "末试无毒冒泡实付1能零施毒可核，既有组件事实已分账；缺同起始HP/资源/构筑和完整抽序下不同启动顺序的受控整战比较及收益函数，不能从另一场建立组件后获胜拟合启动权重。"
        },
        {
          "id": "silent-proposal-43a76a31ba7bdcfa",
          "state": "waiting",
          "reason": "本局首试胜利及吸取后负2敏双防各3、毒17+16可核；缺同起始HP/构筑/完整抽序下另一条完整SL线路及生产配对，本局没有该场SL，不能验证换线偏好或扩大SL范围。"
        },
        {
          "id": "silent-proposal-5264153a4a4b0e5c",
          "state": "waiting",
          "reason": "已有召唤子实现；A10本局航行后各实体力3→6、T4本体线47伤/15损和幻象余2可核，但缺召唤/航行/复现/退场全链生产校准及另一focus完整后继，不能据未选39伤/零损候选强制首杀。"
        },
        {
          "id": "silent-proposal-bddfa690a84e03d0",
          "state": "waiting",
          "reason": "四试均败，睡3/2/1后T4醒、T5临减后T6回4力/22攻可核；缺伤害唤醒、眩晕接续和当前进阶成长的完整生产校准，以及同抽换序完整后继，不能拟合固定杀序或输出血价。"
        }
      ],
