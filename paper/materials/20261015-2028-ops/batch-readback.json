    "proposal_results": [
      {
        "id": "silent-proposal-9952ee8e8df9a0fe",
        "state": "waiting",
        "reason": "NHA同首手换线已核多16伤、多损6血；缺跨重规划完整实线、能力累计兑现及同条件后轮/路线分支，不能确定新SL或终局HP门槛。"
      },
      {
        "id": "silent-proposal-47be799a87af03be",
        "state": "waiting",
        "reason": "P74四个合法弃牌选项和精确切击离手后的死亡已核；当前计划失效提示/手牌快照只覆盖子项，缺四分支动态伤害、目标、后继与生存结果的联合生产回放。"
      },
      {
        "id": "silent-proposal-3a5274da3c42672a",
        "state": "waiting",
        "reason": "召唤复活21血、赢战耗44血、滑溜下火焰仅1伤及毒扣2/23已核；缺召唤/复活、一次格挡翻倍与连续用药联合回放，主怪末次归零中间来源仍缺帧。"
      },
      {
        "id": "silent-proposal-bc4b92d590f2c4ce",
        "state": "waiting",
        "reason": "投斧首牌身份和普通单弃消费已有真实live源码；宽项仍缺跨重规划完整归属、余像累计兑现与动态弃牌分支的联合消费者验证。"
      },
      {
        "id": "silent-proposal-f52fbbab4dccc3b4",
        "state": "waiting",
        "reason": "G33的F31耗37/F33耗59及P74的F22耗44后9血接战已核；缺分源消费者账及同条件路线、休息、SL和保药整战分支，不能从净血差拟合因果HP价格。"
      },
      {
        "id": "silent-proposal-10f37c0edd3d24a6",
        "state": "waiting",
        "reason": "尖啸临时减力、触媒/滑溜、余像与卡牌挡及开场净扣血有局部实帧；缺完整遗物集合、持续能力、牌挡/被动挡/翻倍及回复的联合生产回放和独立校准。"
      },
      {
        "id": "silent-proposal-3f82387e2e179703",
        "state": "waiting",
        "reason": "RC同指纹T1替线实少7伤、多损4血且两候选24/24失败已核；缺同抽序、同预算整战对照和累计能力收益，不足调整保血/铺能力排序。"
      },
      {
        "id": "silent-proposal-aee21084c991abd3",
        "state": "waiting",
        "reason": "BTS醒虫睡层、力量成长和T4需损16/至少差3HP已核；原逐样本抽序/动作及实际线路配对回放未记录，一次死亡与3/4预测并存不足证明模型偏差或校准新权重。"
      },
      {
        "id": "silent-proposal-df37594e9b12debf",
        "state": "waiting",
        "reason": "普通单弃取消唯一后继已有live源码；宽项仍缺跨重规划完整执行归属、能力累计与呼唤自损的联合消费者验收。"
      },
      {
        "id": "silent-proposal-42e81c83b2e1e56b",
        "state": "waiting",
        "reason": "RC实际三火回63及F29赢战耗31、F32到52血已核；缺回复/药槽/存档事件完整分源消费者账和同条件后战反事实，不能确定路线或终局HP价格。"
      }
    ],
