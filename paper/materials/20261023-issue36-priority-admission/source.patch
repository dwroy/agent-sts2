diff --git a/agent/tests/learner-native-prelude.test.ts b/agent/tests/learner-native-prelude.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c6a108114a6db673503515e369f2d56f80f0664f
--- /dev/null
+++ b/agent/tests/learner-native-prelude.test.ts
@@ -0,0 +1,111 @@
+/** Fixed Codex 0.163 event order; no real credentials, panes, sessions or models. */
+import { createHash } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import { NativeBatch } from "../../learner/lib/herdr.js";
+
+const cwd = "/fixture/learner";
+const marker = "[learner-batch:fixture]";
+const prompt = `${marker}\n原始完整任务`;
+const row = (type: string, payload: Record<string, unknown>) => ({ type, payload });
+const context = (turn = "turn-1", dir = cwd) => row("turn_context", { turn_id: turn, cwd: dir, model: "gpt-6.1-sol", effort: "high" });
+function prelude(dir = cwd) {
+  return row("response_item", { type: "message", role: "user", content: [
+    { type: "input_text", text: `# AGENTS.md instructions for ${dir}\n\n<INSTRUCTIONS>\n固定仓库说明。\n</INSTRUCTIONS>` },
+    { type: "input_text", text: `<environment_context>\n  <cwd>${dir}</cwd>\n  <shell>bash</shell>\n</environment_context>` },
+  ] });
+}
+function fixture() {
+  const b = new NativeBatch(marker); b.expectPrompt(marker, prompt);
+  const start = [row("session_meta", { id: "session", cwd }), row("event_msg", { type: "task_started", turn_id: "turn-1" })];
+  return { b, start };
+}
+const user = (text = prompt) => row("response_item", { type: "message", role: "user", content: [{ type: "input_text", text }] });
+const complete = row("event_msg", { type: "task_complete", turn_id: "turn-1", last_agent_message: "报告已保存" });
+const activities = [
+  { kind: "function_call", item: row("response_item", { type: "function_call", name: "foreign" }) },
+  { kind: "custom_tool_call", item: row("response_item", { type: "custom_tool_call", name: "foreign" }) },
+  { kind: "local_shell_call", item: row("response_item", { type: "local_shell_call", call_id: "foreign" }) },
+  { kind: "function_call_output", item: row("response_item", { type: "function_call_output", output: "Earlier result" }) },
+  { kind: "custom_tool_call_output", item: row("response_item", { type: "custom_tool_call_output", output: "Earlier result" }) },
+  { kind: "reasoning", item: row("response_item", { type: "reasoning", summary: [] }) },
+  { kind: "assistant", item: row("response_item", { type: "message", role: "assistant", content: [{ type: "output_text", text: "Earlier answer" }] }) },
+];
+
+describe("native bootstrap before the dispatched prompt", () => {
+  it("stages only the bootstrap, binds its context, then accepts the exact dispatched body", () => {
+    const { b, start } = fixture(); start.forEach((r) => b.feed(r));
+    const p = prelude(); b.feed(p);
+    expect(b.accepted).toBe(false); expect(b.foreignActivity).toBe(false); expect(b.preludes).toEqual([]);
+    b.feed(row("world_state", { full: true, state: {} })); b.feed(context());
+    expect(b.accepted).toBe(false);
+    const text = (p.payload.content as { text: string }[]).map((part) => part.text).join("\n");
+    expect(b.preludes).toEqual([{ turn_id: "turn-1", cwd, sha256: createHash("sha256").update(text).digest("hex") }]);
+    b.feed(user()); b.feed(complete);
+    expect(b.successful()).toBe(true); expect(b.bindings).toHaveLength(1);
+  });
+  it.each(["unknown", "event-user", "wrong-cwd", "extra-part", "trailing-text", "duplicate", "after-context", "no-context", "wrong-turn", "changed-context-cwd", "tool-before-prompt"])(
+    "rejects %s without clearing foreign activity on the later real marker", (kind) => {
+      const { b, start } = fixture(); start.forEach((r) => b.feed(r));
+      let p = prelude();
+      if (kind === "unknown") p = user("Human request");
+      if (kind === "event-user") p = row("event_msg", { type: "user_message", message: (p.payload.content as { text: string }[]).map((part) => part.text).join("\n") });
+      if (kind === "wrong-cwd") p = prelude("/foreign");
+      if (kind === "extra-part") (p.payload.content as unknown[]).push({ type: "input_text", text: "Human request" });
+      if (kind === "trailing-text") (p.payload.content as { text: string }[])[1]!.text += "\nHuman request";
+      if (kind === "after-context") b.feed(context());
+      b.feed(p);
+      if (kind === "tool-before-prompt") b.feed(row("response_item", { type: "function_call", name: "unexpected" }));
+      if (kind === "duplicate") b.feed(prelude());
+      if (kind !== "no-context") b.feed(context(kind === "wrong-turn" ? "human-turn" : "turn-1", kind === "changed-context-cwd" ? "/foreign" : cwd));
+      b.feed(user()); b.feed(complete);
+      expect(b.foreignActivity).toBe(true); expect(b.successful()).toBe(false);
+    });
+  it.each(["same-turn", "new-turn", "continuation"])("does not ignore prelude-shaped human input in %s", (kind) => {
+    const { b, start } = fixture(); [...start, prelude(), context(), user(), complete].forEach((r) => b.feed(r));
+    if (kind === "continuation") b.expectPrompt("retry", "retry\ncontinue");
+    if (kind !== "same-turn") b.feed(row("event_msg", { type: "task_started", turn_id: "turn-2" }));
+    b.feed(prelude());
+    expect(b.foreignActivity).toBe(true); expect(b.successful()).toBe(false);
+  });
+  it("requires session metadata and a started turn before accepting bootstrap framing", () => {
+    for (const include of ["session", "turn", "neither"]) {
+      const { b, start } = fixture();
+      if (include === "session") b.feed(start[0]!);
+      if (include === "turn") b.feed(start[1]!);
+      b.feed(prelude()); b.feed(user()); b.feed(complete);
+      expect(b.foreignActivity).toBe(true); expect(b.successful()).toBe(false);
+    }
+  });
+});
+
+describe("activity in the entire unbound dispatch window", () => {
+  const positions = ["before-prelude", "after-prelude", "after-context", "no-prelude", "continuation-before-context", "continuation-after-context"];
+  it.each(activities.flatMap((activity) => positions.map((position) => ({ ...activity, position }))))(
+    "retains $kind at $position despite a later correct marker", ({ item, position }) => {
+      const { b, start } = fixture(); start.forEach((r) => b.feed(r));
+      if (position.startsWith("continuation")) {
+        [prelude(), context(), user(), complete].forEach((r) => b.feed(r));
+        b.expectPrompt("retry", "retry\ncontinue");
+        b.feed(row("event_msg", { type: "task_started", turn_id: "turn-2" }));
+        if (position === "continuation-after-context") b.feed(context("turn-2"));
+        b.feed(item);
+        if (position === "continuation-before-context") b.feed(context("turn-2"));
+        b.feed(user("retry\ncontinue"));
+        b.feed(row("event_msg", { type: "task_complete", turn_id: "turn-2", last_agent_message: "later report" }));
+      } else {
+        const tail = position === "no-prelude" ? [context(), user(), complete] : [prelude(), context(), user(), complete];
+        const at = position === "before-prelude" ? 0 : position === "after-context" ? 2 : 1;
+        tail.splice(at, 0, item); tail.forEach((r) => b.feed(r));
+      }
+      expect(b.foreignActivity).toBe(true); expect(b.accepted).toBe(false); expect(b.successful()).toBe(false);
+    });
+  it.each(activities)("allows bound $kind work in the original and explicitly continued turns", ({ item }) => {
+    const { b, start } = fixture(); [...start, prelude(), context(), user(), item, complete].forEach((r) => b.feed(r));
+    expect(b.successful()).toBe(true);
+    b.expectPrompt("retry", "retry\ncontinue");
+    b.feed(row("event_msg", { type: "task_started", turn_id: "turn-2" })); b.feed(context("turn-2"));
+    b.feed(user("retry\ncontinue")); b.feed(item);
+    b.feed(row("event_msg", { type: "task_complete", turn_id: "turn-2", last_agent_message: "continued report" }));
+    expect(b.successful()).toBe(true); expect(b.bindings).toHaveLength(2);
+  });
+});
diff --git a/agent/tests/learner-tui-reconciliation.test.ts b/agent/tests/learner-tui-reconciliation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..add6f57d69a32c80325edec9de7137687c65f7f7
--- /dev/null
+++ b/agent/tests/learner-tui-reconciliation.test.ts
@@ -0,0 +1,114 @@
+import { createHash } from "node:crypto";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { learnerAgentName } from "../../learner/lib/herdr.js";
+import { reconcileTuiReceipt, reconciliationMain } from "../../learner/lib/tui-reconciliation.js";
+
+const roots: string[] = [];
+afterEach(() => { for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true }); });
+const hash = (text: string) => createHash("sha256").update(text).digest("hex");
+function fixture() {
+  const cwd = "/fixture/learner", label = "learner-20261023-032433-strategy-proposal", pane = "w1:p2";
+  const marker = "[learner-batch:fixture]", prompt = `${marker}\nOriginal task`;
+  const receipt = { state: "needs-attention", submitted: true, cwd, label, pane, agent_name: learnerAgentName(label, pane, cwd), agent_name_version: 1,
+    submissions: [{ marker, prompt_sha256: hash(prompt) }], bindings: [], result: { code: 75 } };
+  const rows = [
+    { type: "session_meta", payload: { id: "session", cwd } },
+    { type: "event_msg", payload: { type: "task_started", turn_id: "turn" } },
+    { type: "response_item", payload: { type: "message", role: "user", content: [
+      { type: "input_text", text: `# AGENTS.md instructions for ${cwd}\n\n<INSTRUCTIONS>\nFixed instructions.\n</INSTRUCTIONS>` },
+      { type: "input_text", text: `<environment_context>\n  <cwd>${cwd}</cwd>\n  <shell>bash</shell>\n</environment_context>` },
+    ] } },
+    { type: "turn_context", payload: { turn_id: "turn", cwd } },
+    { type: "response_item", payload: { type: "message", role: "user", content: [{ type: "input_text", text: prompt }] } },
+  ];
+  return { receipt, rows };
+}
+
+describe("read-only reconciliation of an already submitted TUI", () => {
+  const activities = [
+    { kind: "function_call", payload: { type: "function_call", name: "foreign" } },
+    { kind: "custom_tool_call", payload: { type: "custom_tool_call", name: "foreign" } },
+    { kind: "local_shell_call", payload: { type: "local_shell_call", call_id: "foreign" } },
+    { kind: "function_call_output", payload: { type: "function_call_output", output: "Earlier result" } },
+    { kind: "custom_tool_call_output", payload: { type: "custom_tool_call_output", output: "Earlier result" } },
+    { kind: "reasoning", payload: { type: "reasoning", summary: [] } },
+    { kind: "assistant", payload: { type: "message", role: "assistant", content: [{ type: "output_text", text: "Earlier answer" }] } },
+  ];
+  const positions = ["before-prelude", "after-prelude", "after-context", "no-prelude", "continuation-before-context", "continuation-after-context"];
+  it.each(activities.flatMap((activity) => positions.map((position) => ({ ...activity, position }))))(
+    "rejects $kind at $position in the original receipt audit", ({ payload, position }) => {
+      const { receipt, rows } = fixture();
+      const item = { type: "response_item", payload };
+      if (position.startsWith("continuation")) {
+        rows.push({ type: "event_msg", payload: { type: "task_complete", turn_id: "turn", last_agent_message: "first report" } });
+        receipt.submissions.push({ marker: "retry", prompt_sha256: hash("retry\ncontinue") });
+        rows.push({ type: "event_msg", payload: { type: "task_started", turn_id: "turn-2" } });
+        if (position === "continuation-after-context") rows.push({ type: "turn_context", payload: { turn_id: "turn-2", cwd: receipt.cwd } });
+        rows.push(item);
+        if (position === "continuation-before-context") rows.push({ type: "turn_context", payload: { turn_id: "turn-2", cwd: receipt.cwd } });
+        rows.push({ type: "response_item", payload: { type: "message", role: "user", content: [{ type: "input_text", text: "retry\ncontinue" }] } });
+      } else {
+        if (position === "no-prelude") rows.splice(2, 1);
+        rows.splice(position === "before-prelude" ? 2 : position === "after-context" ? 4 : 3, 0, item);
+      }
+      const original = JSON.stringify(receipt), audit = reconcileTuiReceipt(receipt, rows);
+      expect(audit.observed).toMatchObject({ accepted: false, foreign_activity: true });
+      expect(audit.finish_authorized).toBe(false); expect(JSON.stringify(receipt)).toBe(original);
+    });
+  it("reconstructs native acceptance without rewriting old 75/bindings or authorizing lifecycle actions", () => {
+    const { receipt, rows } = fixture(); const before = JSON.stringify(receipt);
+    const audit = reconcileTuiReceipt(receipt, rows);
+    expect(audit.observed).toMatchObject({ session: "session", cwd: receipt.cwd, turn: "turn", accepted: true, foreign_activity: false, open: true, complete: false });
+    expect(audit.observed.bindings).toHaveLength(1); expect(audit.observed.native_preludes).toHaveLength(1);
+    expect(audit).toMatchObject({ original_result_code: 75, original_receipt_modified: false, prompt_send_authorized: false,
+      retirement_authorized: false, finish_authorized: false, pane_pid_lease_revalidated: false });
+    expect(JSON.stringify(receipt)).toBe(before);
+  });
+  it.each(["unsubmitted", "wrong-name", "wrong-cwd", "wrong-hash", "wrong-session", "missing-proof"])("does not reconcile %s", (kind) => {
+    const { receipt, rows } = fixture();
+    if (kind === "unsubmitted") receipt.submitted = false;
+    if (kind === "wrong-name") receipt.agent_name = "foreign";
+    if (kind === "wrong-cwd") receipt.cwd = "/foreign";
+    if (kind === "wrong-hash") receipt.submissions[0]!.prompt_sha256 = "0".repeat(64);
+    if (kind === "wrong-session") Object.assign(receipt, { session: "foreign" });
+    if (kind === "missing-proof") receipt.submissions = [];
+    let accepted = false;
+    try { const audit = reconcileTuiReceipt(receipt, rows); accepted = audit.observed.accepted && !audit.observed.foreign_activity; } catch { /* deferred */ }
+    expect(accepted).toBe(false);
+  });
+  it("retains a subsequent human turn even when the initial dispatch was proved", () => {
+    const { receipt, rows } = fixture();
+    rows.push({ type: "event_msg", payload: { type: "task_started", turn_id: "human" } });
+    const audit = reconcileTuiReceipt(receipt, rows);
+    expect(audit.observed.foreign_activity).toBe(true); expect(audit.observed.accepted).toBe(false);
+  });
+  it("audits a bounded durable snapshot without writing either source file or treating partial rows as acceptance", () => {
+    const { receipt, rows } = fixture();
+    const root = mkdtempSync(join(tmpdir(), "tui-reconcile-")); roots.push(root);
+    const receiptFile = join(root, "original.json"), nativeFile = join(root, "native.jsonl");
+    const original = JSON.stringify(receipt), native = rows.map((r) => JSON.stringify(r) + "\n").join("") + '{"type":';
+    writeFileSync(receiptFile, original); writeFileSync(nativeFile, native);
+    const output: string[] = [], errors: string[] = [];
+    expect(reconciliationMain(["--receipt", receiptFile, "--native", nativeFile], (s) => output.push(s), (s) => errors.push(s))).toBe(0);
+    const audit = JSON.parse(output[0]!);
+    expect(audit.original_receipt_sha256).toBe(hash(original)); expect(audit.trailing_partial_bytes).toBe(8);
+    expect(audit.finish_authorized).toBe(false); expect(errors).toEqual([]);
+    expect(readFileSync(receiptFile, "utf8")).toBe(original); expect(readFileSync(nativeFile, "utf8")).toBe(native);
+  });
+  it("returns 75 for pre-prelude activity without changing the source receipt or native snapshot", () => {
+    const { receipt, rows } = fixture();
+    rows.splice(2, 0, { type: "response_item", payload: { type: "function_call", name: "foreign" } });
+    const root = mkdtempSync(join(tmpdir(), "tui-reconcile-foreign-")); roots.push(root);
+    const receiptFile = join(root, "original.json"), nativeFile = join(root, "native.jsonl");
+    const original = JSON.stringify(receipt), native = rows.map((r) => JSON.stringify(r) + "\n").join("");
+    writeFileSync(receiptFile, original); writeFileSync(nativeFile, native);
+    const output: string[] = [];
+    expect(reconciliationMain(["--receipt", receiptFile, "--native", nativeFile], (s) => output.push(s))).toBe(75);
+    expect(JSON.parse(output[0]!)).toMatchObject({ observed: { accepted: false, foreign_activity: true },
+      original_receipt_modified: false, finish_authorized: false });
+    expect(readFileSync(receiptFile, "utf8")).toBe(original); expect(readFileSync(nativeFile, "utf8")).toBe(native);
+  });
+});
