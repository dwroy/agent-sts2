import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import assert from 'node:assert/strict';
import { parseStrategyLibrary, retrieveStrategies } from '../../../../agent/src/knowledge/strategy-entries.ts';
import { validateV6Draft } from '../../../../agent/src/v6/draft.ts';
import { validateReflexEntry, validateReflexVocab } from '../../../../agent/src/v6/formats.ts';
import { evaluatePredicate } from '../../../../agent/src/v6/predicate.ts';
import { parseGameState } from '../../../../agent/src/hand/mod/schema.ts';
import { combatPredicateFacts } from '../../../../agent/src/reflex/jev/predicate-context.ts';
const root=dirname(fileURLToPath(import.meta.url));
const read=(p:string)=>JSON.parse(readFileSync(join(root,p),'utf8'));
const strategies=parseStrategyLibrary(read('strategy-candidates.json'));
const original=read('baseline/strategy-entries.json');
const replacementIds=new Set(strategies.entries.map(e=>e.id));
const combined=parseStrategyLibrary({...original,entries:[...original.entries.filter((e:any)=>!replacementIds.has(e.id)),...strategies.entries]});
assert.equal(combined.entries.length,49);
const reflex=read('reflex-candidates.json'),vocab=read('reflex-vocab-candidates.json');
assert.equal(validateReflexVocab(vocab).ok,true);
const draft=validateV6Draft('reflex',read('reflex-draft.json'),read('validation-context.json'));
assert.equal(draft.ok,true,JSON.stringify(draft));
const config=read('candidate-config.json'),inventory=read('replay-inventory.json');
const results=[];
for(const cfg of config){
 const row=inventory.cases.find((c:any)=>c.id===cfg.key);
 const raw=JSON.parse(readFileSync(row.original_mod_state.path,'utf8'));
 const decision=JSON.parse(readFileSync(row.original_decision.path,'utf8'));
 assert.equal(raw.fingerprint,decision.fingerprint);
 const state=parseGameState(raw.state),facts=combatPredicateFacts(state);
 const rk=reflex.entries.find((e:any)=>e.id===cfg.rid);
 assert.equal(validateReflexEntry(rk).ok,true,JSON.stringify(validateReflexEntry(rk)));
 // The actual source has current-state facts, but no original candidate Plan.
 const statePredicate={op:'and',args:rk.predicate.args.filter((a:any)=>a.field!=='option.kind').map((a:any)=>a.op==='and'?{...a,args:a.args.filter((p:any)=>p.field!=='option.kind'&&p.field!=='option.actions')}:a)};
 const stateMatch=evaluatePredicate(statePredicate,facts.context);
 assert.equal(stateMatch,true,cfg.key+' current predicate facts must actually hold');
 const noPlan=evaluatePredicate(rk.predicate,facts.context);
 assert.equal(noPlan,null,cfg.key+' no Plan stays unknown');
 const noEnemy=structuredClone(facts.context) as any;
 noEnemy.enemies.items=noEnemy.enemies.items.map((e:any)=>({...e,id:'UNOBSERVED_CONTROL_ID'}));
 assert.equal(evaluatePredicate(rk.predicate,noEnemy),false);
 const singleton=parseStrategyLibrary({schema:'brain-strategies-v1',character:'silent',entries:strategies.entries.filter(e=>e.id===cfg.sid)});
 const payload={act:cfg.act,floor:cfg.floor,boss:raw.state.run.boss_id};
 const textHits=retrieveStrategies(singleton,'fight-plan',payload);
 assert.deepEqual(textHits.map(e=>e.id),[cfg.sid]);
 assert.equal(retrieveStrategies(singleton,'reward/card',payload).length,0);
 results.push({context:cfg.key,strategy_format:true,rk_format:true,raw_fingerprint_match:true,current_state_predicate:stateMatch,full_predicate_without_original_Plan:noPlan,wrong_enemy:false,isolated_structural_strategy_retrieval:textHits.map(e=>e.id),actual_production_tool_readback:false,original_legal_Plan:false,legal_capture_or_replay:false});
}
const output={schema:'encounter-scratch-validation-v1',strategies:6,rk_descriptive_tags:6,combined_strategy_format_entries:49,draft_format:true,contexts:results,simulation_or_model_calls:0,production_tool_calls:0,source_changes:0,not_tsc_or_vitest:true,limits:'Current-state and format checks only. No candidate action context synthesized; missing Plan predicates remain unknown. Isolated retrieval is not formal production readback, legal comparison or replay.'};
writeFileSync(join(root,'validation.json'),JSON.stringify(output,null,2)+'\n');
console.log(JSON.stringify({strategies:6,rk_tags:6,current_state_matches:6,missing_Plan_unknown:6,wrong_enemy_rejected:6,isolated_structural_retrieval:6,legal_replays:0}));
