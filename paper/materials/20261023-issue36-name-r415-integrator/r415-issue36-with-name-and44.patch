   close) [ $# -ge 1 ] || die "usage: close <label>" 2; close_pane "$@" ;;
   stop) [ $# -ge 1 ] || die "usage: stop <label> [--keep-pane]" 2; available || die "herdr unavailable"; stop "$@" ;;
   list|status) status "${1:-}" ;;
