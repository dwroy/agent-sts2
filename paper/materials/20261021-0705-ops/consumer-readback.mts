import assert from 'node:assert/strict';
import {readFileSync,writeFileSync} from 'node:fs';
import {pathToFileURL} from 'node:url';
globalThis.fetch=async()=>{throw new Error('No network in publication readback');};
const [codeRoot,knowledgeRoot,output]=process.argv.slice(2);
const imp=(p:string)=>import(pathToFileURL(codeRoot+'/agent/src/'+p).href);
const {v6Config}=await imp('v6/config.ts'); const config=v6Config();
assert.deepEqual(config.deciders,{card:'brain',potion:'brain',shop:'brain',rest:'brain'});
assert.equal(config.reflex,'off'); assert.equal(config.direction_replan,'off');
assert.equal(process.env.V6_COMBAT_ENTRIES,'off'); assert.equal(config.budgets.brain_ms,90000);assert.equal(config.budgets.pick_ms,5000);
const {loadV6Knowledge}=await imp('v6/knowledge.ts');const {loadV6HistoryPack}=await imp('sim/v6-history-pack.ts');
const formal=loadV6Knowledge(knowledgeRoot,'silent'),history=loadV6HistoryPack(knowledgeRoot,'silent',config);
assert.equal(formal.cores.status,'loaded'); assert.equal(history.status,'loaded');assert.equal(history.value.data.combo_metrics.length,17);
const {cardCriteria}=await imp('v6/card-criteria.ts');const unknown=JSON.parse(cardCriteria({skip:'跳过'},null).skip);
assert.deepEqual(unknown.A_vs_skip,[]);assert.deepEqual(unknown.B_progress,[]);
const {V6ProjectionRuntime}=await imp('v6/projection-runtime.ts');let providerCalls=0;
const forbidden=async()=>{providerCalls++;throw new Error('readback forbids provider work');};
const runtime=new V6ProjectionRuntime({evaluate:forbidden,precompute:forbidden},forbidden,()=>{},forbidden,{engine:{},context:forbidden,record:()=>{}});
assert.equal(await runtime.evaluateCard({}),null); assert.equal(runtime.peekCompletedCore({}),null);assert.equal(providerCalls,0);
assert.equal(typeof runtime.duringModelWait,'function');assert.equal(typeof runtime.startCardBackground,'function');
const loop=readFileSync(codeRoot+'/agent/src/hand/loop.ts','utf8');assert.ok(loop.includes('duringModelWait'));
const raw=readFileSync(codeRoot+'/agent/src/v6/projection-runtime.ts','utf8');assert.ok(raw.includes('v6-core-cache.jsonl'));
writeFileSync(output,JSON.stringify({config,knowledge:{cores:formal.cores.status,history:history.status,combos:17,content_sha256:history.value.content_sha256},consumer:{criteria_unknown_not_zero:true,brain_no_card_provider:true,pure_getter_miss_null:true,existing_model_wait_hook:true,audit_sink:true},providerCalls,network:'forbidden',simulation:'not invoked',natural_cache_audit:'pending first new run',quality_or_performance_all_passed:false},null,2)+'\n');
console.log('Current knowledge loader, brain gate, pure getter, criteria, wait hook and audit sink read back; no provider, simulation or network.');
