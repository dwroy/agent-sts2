+class FightCheckpoints:
+    """Resume the original reducer before finish(), including pending fights.
+
+    Keep boundaries before the two most recently observed runs as well as EOF.
+    A newly ended run can change its summary or end-turn evidence: an earlier
+    verified boundary then remains reusable. Rewrites, changed evidence, code or
+    game data miss the cache; the original ordered reducer is the fallback.
+    """
+    def __init__(self, cache, module, builder, states, code, game):
+        self.cache, self.module, self.builder = cache, module, builder
+        self.stream = cache.ready(states)
+        self.stamp = cache.index.directory / 'monster-checkpoints.json'
+        end = cache.index.metadata(self.stream)['source_size']
+        recent = cache.index.db.execute(
+            'SELECT min(offset) FROM rows WHERE stream=? AND rid IS NOT NULL '
+            'GROUP BY rid ORDER BY max(offset) DESC LIMIT 2', (self.stream,))
+        self.targets = {end, *(row[0] for row in recent)} - {0}
+        try:
+            previous = json.loads(self.stamp.read_text())['offsets']
+            if not isinstance(previous, list):
+                previous = []
+        except (OSError, ValueError, KeyError, TypeError):
+            previous = []
+        candidates = self.targets | {n for n in previous if type(n) is int and 0 < n <= end}
+        self.keys = {}
+        digest, identities = hashlib.sha256(), set()
+        by_run = defaultdict(list)
+        for rid, ts in sorted(module.END_TURNS or ()):
+            by_run[rid].append(ts)
+        def key(offset):
+            return [cache.code, code, str(cache.logs), offset, digest.hexdigest(), game,
+                    module.END_TURNS is not None, module.MECHANICS.ok, module.MECHANICS.error,
+                    [[rid, builder.runs.get(rid), by_run[rid]] for rid in sorted(identities)]]
+        # update() has byte-verified the old prefix. Hash indexed row identities
+        # once, rather than reading the multi-GB source again for each boundary.
+        for ref, rid, _reason in cache.index.references(self.stream):
+            offset = ref['offset']
+            if offset in candidates:
+                self.keys[offset] = key(offset)
+            digest.update(json.dumps([offset, ref['bytes'], ref['sha256']]).encode())
+            if rid is not None:
+                identities.add(rid)
+        self.keys[end] = key(end)
+        self.resumed = 0
+        def missing():
+            raise LookupError('checkpoint not present')
+        for offset in sorted(self.keys, reverse=True):
+            try:
+                value = cache.index.cached('legacy:monster-prefix', self.keys[offset], missing)
+            except LookupError:
+                continue
+            builder.__dict__.update(unpack(value['builder'], module.Fight))
+            module.MECHANICS.__dict__.update(unpack(value['mechanics'], module.Fight))
+            self.resumed = offset
+            break
+        cache.timings.append(dict(name='monster-prefix', resumed_bytes=self.resumed,
+                                  source_bytes=end))
+
+    def save(self, offset):
+        if offset not in self.targets or offset < self.resumed:
+            return
+        self.cache.index.cached('legacy:monster-prefix', self.keys[offset], lambda: dict(
+            builder=pack({k:v for k,v in self.builder.__dict__.items() if k not in ('runs','commit')}),
+            mechanics=pack({k:v for k,v in self.module.MECHANICS.__dict__.items() if k != 'frame'})))
+
+    def finish(self):
+        self.save(self.cache.index.metadata(self.stream)['source_size'])
+        temporary = self.stamp.with_suffix('.tmp')
+        temporary.write_text(json.dumps(dict(offsets=sorted(self.targets))))
+        temporary.replace(self.stamp)
+
+
+def consume_fights(module, builder, states, extra_code=None):
+    cache = context(states)
+    if not cache:
+        for screen, entry in module.iter_entries(states): builder.feed(screen, entry)
+        return
+    code = implementation(module.__file__, *([extra_code] if extra_code else []))
+    original_commit = builder.commit
+    mechanics = module.MECHANICS
+    original_frame = mechanics.frame
+    game_identity = token(pack([module.GAME_TYPES,module.GAME_POWER_TYPES,module.STATUS_CARDS,module.TEMPORARY_POWERS]))
+    checkpoints = FightCheckpoints(cache,module,builder,states,code,game_identity) if type(builder) is module.Builder else None
+    row_output = hasattr(builder, 'replay_cached_rows')
+    for rid, refs in cache.segments(states):
+        if checkpoints:
+            if refs[-1]['offset'] + refs[-1]['bytes'] <= checkpoints.resumed:
+                continue
+            refs = [r for r in refs if r['offset'] >= checkpoints.resumed]
+            checkpoints.save(refs[0]['offset'])
+        started = time.monotonic()
+        # A segment can touch its own pending fights and close another open fight.
+        # Unrelated pending runs are immutable until their own next segment or finish.
+        involved = {rid, *builder.open}
+        local_await = {r:fights for r,fights in builder.await_map.items() if r in involved}
+        carry = pack((builder.open,local_await))
+        extra = dict(carry=carry, await_order=list(builder.await_map), runs={r:builder.runs.get(r) for r in involved if r},
+                     end_turns=sorted(t for t in module.END_TURNS or () if t[0] in involved),
+                     checked=module.END_TURNS is not None, ok=mechanics.ok, error=mechanics.error,
+                     game=game_identity)
+        if row_output:
+            extra['row_character'] = builder.character
+        # Commits are replayed by the original reducer, in original order. The only
+        # frame-level global accumulator is stuns; all other frame state is on Fight.
+        identity = [cache.code,code,str(cache.logs),extra,[[r['offset'],r['bytes'],r['sha256']] for r in refs]]
+        produced = False
+        def produce():
+            nonlocal produced
+            produced = True
+            committed = []
+            output = builder.out if row_output else None
+            counts = (builder.rows, builder.fights, builder.by_asc.copy()) if row_output else None
+            if row_output:
+                builder.out = io.StringIO()
+            frames = module.Mechanics(quiet=True)
+            def frame(*args, **kwargs):
+                frames.ok = mechanics.ok
+                frames.frame(*args, **kwargs)
+                if not frames.ok:
+                    mechanics.ok,mechanics.error=frames.ok,frames.error
+            def commit(fight):
+                if not row_output:
+                    committed.append(dict(fight=pack(fight),ok=mechanics.ok,error=mechanics.error))
+                original_commit(fight)
+            builder.commit, mechanics.frame = commit, frame
+            try:
+                for screen, entry in module.iter_entries(states, cache.raw(states,refs)):
+                    builder.feed(screen,entry)
+                value = dict(committed=committed, carry=pack((builder.open,{r:fights for r,fights in builder.await_map.items() if r in involved})),
+                             await_order=list(builder.await_map), stuns=pack(frames.stuns),ok=mechanics.ok,error=mechanics.error)
+                if row_output:
+                    value['rows'] = dict(text=builder.out.getvalue(), rows=builder.rows-counts[0],
+                                         fights=builder.fights-counts[1], by_asc=pack(builder.by_asc-counts[2]))
+                    output.write(value['rows']['text'])
+                    # RowBuilder's original reducer has already emitted its data.
+                    value['committed'] = []
+                return value
+            finally:
+                builder.commit,mechanics.frame=original_commit,original_frame
+                if row_output:
+                    builder.out = output
+        value = cache.index.cached('legacy:fights',identity,produce)
+        builder.open,local_await=unpack(value['carry'],module.Fight)
+        remaining = {r:fights for r,fights in builder.await_map.items() if r not in involved}
+        remaining.update(local_await)
+        builder.await_map = defaultdict(list,((r,remaining[r]) for r in value['await_order']))
+        merge_stuns(mechanics.stuns,unpack(value['stuns']),module.EVIDENCE)
+        if not produced:
+            if row_output:
+                builder.replay_cached_rows(value['rows'], unpack)
+            for item in value['committed']:
+                mechanics.ok,mechanics.error=item['ok'],item['error']
+                original_commit(unpack(item['fight'],module.Fight))
+        mechanics.ok,mechanics.error=value['ok'],value['error']
+        phase = cache.extractions.setdefault('fights', dict(seconds=0,hits=0,misses=0))
+        phase['seconds'] += time.monotonic()-started
+        phase['misses' if produced else 'hits'] += 1
+    if checkpoints:
+        checkpoints.finish()
+
+
+def choice_lines(path, fallback):
+    cache=context(path)
+    if not cache:
+        yield from fallback
+        return
+    code=implementation(Path(__file__).with_name('build-fight-value.py'))
+    parts=[]
+    for rid,refs in cache.groups(path):
+        def produce():
+            out=[]
+            for ref,raw in zip(refs,cache.raw(path,refs)):
+                if b'"combat/plan-choice' not in raw: continue
+                try: row=json.loads(raw)
+                except ValueError: continue
+                out.append((ref['offset'],{k:row.get(k) for k in ('ts','turn','decider')}))
+            return out
+        parts.extend(cache.cached('fight-choices',refs,produce,code=code))
+    for _off,row in sorted(parts,key=lambda p:p[0]):
+        yield json.dumps(dict(row,label='combat/plan-choice'))
