+type TurnScript = (server: AppServer, params: any, turn: number) => Promise<void> | void;
+function fixture(script: TurnScript, holdFirstStart = false) {
+  const dir = mkdtempSync(join(tmpdir(), "brain-evidence-")); dirs.push(dir);
