+            self.git('add', path)
+            self.git('commit', '-q', '-m', 'Fixed implementation change')
+            self.assertIsNone(self.accept(report={**self.report, 'base': self.git('rev-parse', 'HEAD')}))
+            self.git('reset', '--hard', 'HEAD^')
