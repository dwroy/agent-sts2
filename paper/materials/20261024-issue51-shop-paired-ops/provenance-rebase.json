      {
        "id": "silent-brain-shop-joint-budget",
        "version": "2026-10-24.1",
        "trigger": {
          "question_types": [
            "shop"
          ]
        },
        "strategy": "购买与删牌各自买得起时，先比较同一笔金币能完成的整套方案，再决定把预算给哪边。证据局100金币买51金币翻越撑击后剩49，原100删牌已不可付；另一局162金币先删100后仍能买52药。A10无重试证据购买互斥125机会/84局、选择删牌28/27；重试或判死组522/280、142/127。\n范围：Silent A10/自有版本unknown；只证明预算互斥与实际执行，不证明买牌或删牌更好，不固定删牌优先。",
        "evidence": [
          {
            "type": "own",
            "run": "MGA0CZDDKC0P",
            "floor": 11,
            "ref": "paper/materials/20261024-issue51-shop-paired-ops/original/scratch/joint-budget-evidence.json#/0",
            "role": "support"
          },
