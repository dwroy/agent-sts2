+}
+const record = { ts: "fixed", decision_id: "fixed", fingerprint: "fixed", label: "reward/card", decider: "codex",
+  chosen: { action: "skip_reward_cards" }, deepseek: { choice: "skip" } } as unknown as DecisionRecord;
