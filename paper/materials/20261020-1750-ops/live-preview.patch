diff --git a/agent/tests/temp-fixtures.ts b/agent/tests/temp-fixtures.ts
new file mode 100644
index 000000000..207ad6064
--- /dev/null
+++ b/agent/tests/temp-fixtures.ts
@@ -0,0 +1,16 @@
+import { mkdtempSync as createDirectory, rmSync } from "node:fs";
+import { afterAll } from "vitest";
+
+const directories = new Set<string>();
+
+// Some fixtures are allocated at module scope and shared across tests in the file.
+afterAll(() => {
+  for (const directory of directories) rmSync(directory, { recursive: true, force: true });
+  directories.clear();
+});
+
+export function mkdtempSync(prefix: string): string {
+  const directory = createDirectory(prefix);
+  directories.add(directory);
+  return directory;
+}
