+it.each([true, false])("reports the observed A10 one-to-six refuelling without changing HP or choices (oneshot=%s)", (oneshot) => {
+  const raw = structuredClone(positiveFixture.states["312605"]);
+  const before = JSON.stringify(raw);
+  const { decision, rest, options } = question(raw, oneshot);
+  expect(rest.candle_refuel.current_charges).toBe(1);
+  expect(rest.candle_refuel.actions).toEqual([
+    { key: "o0", kind: "HEAL", charges_after_action_reference: 1 },
+    { key: "o1", kind: "SMITH", charges_after_action_reference: 1 },
+    { key: "o2", kind: "KINDLE", charges_after_action_reference: 6 },
+  ]);
+  expect(rest.candle_refuel.source).toContain("J8PHG72DGD90");
+  expect(rest.candle_refuel.source).toContain("silent-0328");
+  expect(rest.candle_refuel.limits).toContain("其他正充能");
+  expect(rest.candle_refuel.simulation_scope).toContain("没有模拟KINDLE");
+  expect(Object.keys(options)).toContain("o2");
+  expect(decision.resolve({ pick: { type: "choice", choice: "o2", reason: "固定验证", confidence: 1 } }).intent)
+    .toEqual({ action: "choose_rest_option", option_index: 2 });
+  const after = positiveFixture.states["312606"];
+  expect(after.run.relics.find((r: any) => r.relic_id === "PUMPKIN_CANDLE").stack).toBe(6);
+  expect(after.run.current_hp).toBe(raw.run.current_hp);
+  expect(after.run.max_hp).toBe(raw.run.max_hp);
+  const absentRaw = structuredClone(raw);
+  absentRaw.run.relics = absentRaw.run.relics.filter((r: any) => r.relic_id !== "PUMPKIN_CANDLE");
+  const absent = question(absentRaw, oneshot);
+  expect(options).toEqual(absent.options);
+  const { candle_refuel, ...otherFacts } = rest;
+  expect(otherFacts).toEqual(absent.rest);
+  expect(JSON.stringify(raw)).toBe(before);
