+                                 "FIXTURE000001", "silent", env["FIXTURE_TASK"], str(self.root)],
+                                env=env, capture_output=True, text=True, timeout=10)
+        self.assertEqual((self.directory / "queue/old-event.md").read_text(), "ops busy: original pending event\n")
+        return result
