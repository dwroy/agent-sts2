+def prerequisite_frame_inputs(runs, combos, cache=None, run_keys=None, algorithm=None):
+    """Cache holding checks per run; only verified predicates remain in TypeScript."""
+    definitions = [dict(id=c['id'], cards=c['cards']) for c in combos if c.get('prerequisites') is not None]
+    frames, owners = {}, defaultdict(set)
+    for run in runs:
+        def collect():
+            rows = []
+            for frame in run['states']:
+                ids = [c['id'] for c in definitions if holding(c['cards'], frame['state']['run'].get('deck')) is True]
+                if ids:
+                    rows.append(dict(source=frame['_source'], combos=ids))
+            return rows
+        rows = collect() if cache is None else cache.cached('combo-prerequisite-frames',
+            [algorithm, definitions, run_keys[run['run_id']]], collect)
+        for row in rows:
+            sha = row['source']['sha256']
+            frames[sha] = row
+            owners[sha].add(run['run_id'])
+    return frames, owners
+
+
+def prerequisite_cache_keys(runs, results, owners=None):
+    """Partition verified predicate results once, rather than rescan per combo."""
+    if owners is None:
+        owners = defaultdict(set)
+        for run in runs:
+            for frame in run['states']:
+                owners[frame['_source']['sha256']].add(run['run_id'])
+    keys = {}
+    for combo, conditions in results.items():
+        grouped = {run['run_id']: {} for run in runs}
+        for frame, condition in conditions.items():
+            for rid in owners.get(frame, ()):
+                grouped[rid][frame] = condition
+        keys[combo] = {rid: token(rows) for rid, rows in grouped.items()}
+    return keys
+
+
+def availability_contribution(requirements, run, attempt):
+    """One run's visible offers, including runs that never formed the combo."""
+    cutoff = run['first_cut'] if attempt == 'first' else None
+    visits = defaultdict(list)
+    for row in run['states']:
+        if cutoff is not None and row['ts'] > cutoff:
+            continue
+        s = row['state']; r = s.get('run') or {}
+        act = act_index(r.get('act_id'))
+        if act is None or not isinstance(r.get('floor'), int):
+            continue
+        cards = (s.get('reward') or {}).get('card_options') if s.get('screen') == 'REWARD' else (s.get('shop') or {}).get('cards') if s.get('screen') == 'SHOP' else None
+        if not isinstance(cards, list) or not cards or any(not c.get('card_id') for c in cards):
+            continue
+        if s['screen'] == 'SHOP':
+            if any(not isinstance(c.get('is_stocked'), bool) for c in cards):
+                continue
+            cards = [c for c in cards if c['is_stocked']]
+            if not cards:
+                continue
+        visits[(act+1, r['floor'], s['screen'])].extend(cards)
+    rows = []
+    for act in sorted({a for a, _, _ in visits}):
+        visible = [c for (a, _, _), cards in visits.items() if a == act for c in cards]
+        floor = min(f for a, f, _ in visits if a == act)
+        for card, upgraded in requirements.items():
+            candidates = [c for c in visible if c['card_id'] == card]
+            needs_upgrade = all(upgraded)
+            if needs_upgrade and candidates and any(not isinstance(c.get('upgraded'), bool) for c in candidates):
+                continue
+            seen = any(not needs_upgrade or c.get('upgraded') is True for c in candidates)
+            rows.append(dict(card=card, act=act, value=int(seen), evidence=dict(run_id=run['run_id'], floor=floor)))
+    return rows
+
