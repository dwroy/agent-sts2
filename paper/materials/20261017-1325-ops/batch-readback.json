      {
        "id": "silent-proposal-89354805ee4d7e77",
        "state": "waiting",
        "reason": "缺跨抽牌、选牌、用药、重问、SL及换战的实际施放持续身份与生产读回；未覆盖升级交互没有本批新实测。既有配对转换不能证明整项完成。"
      },
      {
        "id": "silent-proposal-f2bfceddb1898dca",
        "state": "waiting",
        "reason": "缺完整模型下同起点、同随机池、同总预算的分阶段MC配对与样本成熟曲线，亦缺留药及另一focus的完整后继；H1工程发布不能充作本提案收益证明。"
      },
      {
        "id": "silent-proposal-283a164780d11e69",
        "state": "waiting",
        "reason": "同源神化请求仍缺跨中断的实际施放归属及未知升级组合校准；没有覆盖全部原请求的实际live源码提交，不能登记duplicate。"
      },
      {
        "id": "silent-proposal-ebbfe3b97548756d",
        "state": "waiting",
        "reason": "缺十五子项逐来源属性、升级组合、期限及战斗—路线—休息的联合生产校准；本批原帧没有隔离出新的确定数值失配，局部实现不足关闭整条复合请求。"
      },
      {
        "id": "silent-proposal-e5b87be50f28f311",
        "state": "waiting",
        "reason": "缺跨抽牌、选择、用药、重问、SL的完整候选持续归属和全过程生产校准；原113个片段的actual_full_candidate_result均为null，不能据此认成长收益或整战改线因果。"
      },
      {
        "id": "silent-proposal-49632bc4878fb597",
        "state": "waiting",
        "reason": "缺逐击力量、正负敏捷、虚弱与独立成长四路径在同一冻结生产调用中的联合校准；本局未实测正敏捷，也未发现新的确定子公式失配。"
      },
      {
        "id": "silent-proposal-66532328a585941f",
        "state": "waiting",
        "reason": "缺相同HP、牌组、药水和完整抽序下不同启动顺序的受控整战对照及可复现收益函数；局部空打端点不足拟合启动阈值或构筑权重。"
      },
      {
        "id": "silent-proposal-43a76a31ba7bdcfa",
        "state": "waiting",
        "reason": "缺同起始HP、构筑、完整抽序的生产整战配对与另一可核SL线路；负敏捷及毒端点不足支持变更SL范围或阈值。"
      },
      {
        "id": "silent-proposal-5264153a4a4b0e5c",
        "state": "waiting",
        "reason": "缺A10召唤、航行、复现与退场全链的冻结生产校准及另一focus完整后继；已有召唤源码和T4净扣不能证明目标排序整战收益。"
      },
      {
        "id": "silent-proposal-bddfa690a84e03d0",
        "state": "waiting",
        "reason": "缺伤害唤醒、眩晕接续及当前进阶成长的冻结生产全链校准和同抽换序完整后继；四次相关失败不足拟合血价、全败排序或固定杀序。"
      }
