+"""Fixed producers publish D1 objects under their own lock, never live-merge.lock.
+
+The control explicitly admits a producer's method fingerprint. Changing its
+algorithm/validator requires engineering and a new admitted fingerprint.
+"""
+from contextlib import contextmanager
+import fcntl
+import json
+import os
+from pathlib import Path
+import subprocess
+
+from learning_runtime import capture
+from learning_runtime_store import Store, atomic, checked_file, packed, sha
+
+# Exact consumers/files, not a directory-wide knowledge import.
+OUTPUTS = {
+    "monster-db": ["common/monster-db.json", "common/move-model.json", "characters/{character}/monster-records.json"],
+    "card-upgrades": ["common/card-upgrades.json"],
+    "outcome": ["characters/{character}/outcome-stats.json"],
+    "construction-opportunities": ["characters/{character}/construction-opportunities.json"],
+    "room-costs": ["characters/{character}/room-costs.json"],
+    "boss-damage": ["characters/{character}/boss-damage.json"],
+    "potion-equivalents": ["characters/{character}/potion-equivalents.json"],
+    "v6-history": ["characters/{character}/v6-history.json"],
+    "fight-value": ["characters/{character}/fight-value.json", "characters/{character}/fight-value-gates.json"],
+    "silent-boss-calibration": ["characters/silent/boss-trust.json"],
+    "move-model": ["common/move-model.json"],
+    "event-pages": ["common/event-pages.json"],
+    "opening-value": ["characters/{character}/opening-value.json"],
+}
+
+
+def managed_paths(chosen):
+    producers = set(chosen.get("refresh", []))
+    if "silent-boss-calibration" in chosen.get("entries", []):
+        producers.add("silent-boss-calibration")
+    if producers - set(OUTPUTS):
+        raise ValueError("unknown fixed-data consumer capability")
+    return sorted({name for producer in producers for name in OUTPUTS[producer]})
+
+
+def launch_selection(root, state_dir=None):
+    """A queued/restarted fixed worker keeps the original control contract."""
+    path = os.environ.get("STS2_REFRESH_SELECTION_FILE")
+    if not path:
+        return capture(root, state_dir)
+    base = Path(root).resolve()
+    selected = Path(path)
+    if selected.parent != base / "data/learning-runtime-launches":
+        raise ValueError("foreign refresh launch contract")
+    raw = checked_file(base, selected)
+    if sha(raw) != os.environ.get("STS2_REFRESH_SELECTION_SHA256"):
+        raise ValueError("refresh launch contract hash mismatch")
+    body = json.loads(raw)
+    if body.get("schema") != "fixed-refresh-launch-v1" or body.get("root") != str(base) or body.get("request") != os.environ.get("STS2_REFRESH_CYCLE"):
+        raise ValueError("refresh launch identity mismatch")
+    return body["selection"]
+
+
+def bind_launch(root, code_root, request, options):
+    """Persist before resource admission; a retry of one request never rebinds."""
+    base = Path(root).resolve()
+    directory = base / "data/learning-runtime-launches"
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / (sha(request.encode()) + ".json")
+    identity = {"schema": "fixed-refresh-launch-v1", "root": str(base), "code_root": str(Path(code_root).resolve()),
+                "request": request, "options": options}
+    with (directory / (path.stem + ".lock")).open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        if path.exists():
+            raw = checked_file(base, path)
+            body = json.loads(raw)
+            if any(body.get(k) != v for k, v in identity.items()):
+                raise ValueError("refresh retry changed original launch")
+        else:
+            raw = (packed({**identity, "selection": capture(base)}) + "\n").encode()
+            atomic(path, raw)
+    os.environ["STS2_REFRESH_SELECTION_FILE"] = str(path)
+    os.environ["STS2_REFRESH_SELECTION_SHA256"] = sha(raw)
+    return launch_selection(base)
+
+
+def method(root, producer):
+    root = Path(root)
+    if producer not in OUTPUTS:
+        raise ValueError("unknown fixed producer")
+    # Include helper implementations, model code and validators. Never include
+    # their generated knowledge/data, so ordinary data refreshes remain data.
+    paths = [*sorted((root / "knowledge/builders").glob("*.py")),
+             *sorted((root / "agent/src").rglob("*.ts")),
+             *sorted((root / "agent/tools/boss-sim").glob("*.py")),
+             *sorted((root / "agent/tools/boss-sim").glob("*.ts")),
+             root / "ops/learning_runtime_data.py", root / "ops/learning_runtime_store.py",
+             root / "ops/learning_runtime.py", root / "ops/knowledge_runtime_env.py"]
+    return sha(packed({"producer": producer, "inputs": {str(p.relative_to(root)): sha(checked_file(root, p)) for p in paths if p.is_file()}}).encode())
+
+
+def source_cut(root, producer=None, characters=None):
+    """Name actual input bytes, including independent role denominators in JSON outputs."""
+    root = Path(root)
+    names = ["knowledge/common/move-model.json"] if producer == "fight-value" else []
+    if producer == "v6-history":
+        names += [f"knowledge/characters/{c}/build-cores.json" for c in characters or []]
+    result = {}
+    for name in names:
+        selected = knowledge_input(root, name.removeprefix("knowledge/")) if producer == "v6-history" else root / name
+        if selected.is_file():
+            base = Path(os.environ["STS2_FIXED_KNOWLEDGE_SNAPSHOT"]) if producer == "v6-history" and os.environ.get("STS2_FIXED_KNOWLEDGE_SNAPSHOT") else root
+            result[name] = sha(checked_file(base, selected, 128 * 1024 * 1024))
+    return result
+
+
+def knowledge_input(root, relative):
+    selected = os.environ.get("STS2_FIXED_KNOWLEDGE_SNAPSHOT")
+    return Path(selected) / relative if selected else Path(root) / "knowledge" / relative
+
+
+def knowledge_binding(root):
+    from knowledge_runtime_env import snapshot
+    directory = snapshot(root).get("STS2_KNOWLEDGE_RUNTIME")
+    if not directory:
+        return None
+    # Read K1 with the repaired Node SQLite, never the host's older Python SQLite.
+    # No TypeScript/esbuild child is needed for this bounded read-only query.
+    script = """import {DatabaseSync} from 'node:sqlite';
+const d=new DatabaseSync(process.argv[1],{readOnly:true});
+try { const s=String(d.prepare('select sqlite_version() v').get().v).split('.').map(Number);
+if(!(s[0]>3||s[0]===3&&(s[1]>51||s[1]===51&&s[2]>=3||s[1]===50&&s[2]>=7||s[1]===44&&s[2]>=6)))throw Error('unrepaired SQLite');
+d.exec('BEGIN'); const v=d.prepare("select value from metadata where key='current'").get()?.value;
+const r=d.prepare('select manifest from releases where version=?').get(v); d.exec('COMMIT');
+if(!r)throw Error('missing K1 baseline');console.log(JSON.stringify({version:v,manifest:JSON.parse(r.manifest)}));
+}finally{d.close();}"""
+    result = subprocess.run([os.environ.get("STS2_NODE_BIN", "node"), "--input-type=module", "-e", script, str(Path(directory) / "knowledge.sqlite")],
+                            capture_output=True, text=True, check=True, timeout=20)
+    body = json.loads(result.stdout)
+    version = body["version"]
+    if not isinstance(version, str) or not version.startswith("K1-") or len(version) != 67:
+        raise ValueError("invalid fixed producer knowledge binding")
+    path = Path(directory) / "snapshots" / version
+    # The original K1 publisher owns snapshot construction. Verify, never create
+    # or replace a formal knowledge source from a fixed data refresh.
+    for name, digest in body["manifest"]["files"].items():
+        if name.endswith("/build-cores.json") and sha(checked_file(path, path / name)) != digest:
+            raise ValueError("fixed producer K1 source hash mismatch")
+    return {"version": version, "snapshot": str(path), "manifest": body["manifest"]["files"]}
+
+
+def formal_document(root, relative):
+    binding = knowledge_binding(root)
+    if binding is None or relative not in binding["manifest"]:
+        return None  # An unmigrated role/document retains its original source.
+    path = Path(binding["snapshot"]) / relative
+    raw = checked_file(binding["snapshot"], path)
+    if sha(raw) != binding["manifest"][relative]:
+        raise ValueError("formal source hash mismatch")
+    return json.loads(raw)
+
+
+def validate_output(name, raw):
+    value = json.loads(raw, parse_constant=lambda _: (_ for _ in ()).throw(ValueError("nonfinite data")))
+    if not isinstance(value, dict):
+        raise ValueError("fixed data must be an object")
+    # Fixed producer selection is the authority; arbitrary JSON/scripting is never
+    # accepted through learner candidates. Existing producer gates remain intact.
+    character = name.split("/")[1] if name.startswith("characters/") else None
+    if character and "character" in value and str(value["character"]).lower() != character:
+        raise ValueError("wrong-character fixed data")
+    return value
+
+
+def active(root, step, state_dir=None):
+    chosen = launch_selection(root, state_dir)
+    producer = step.split(":")[0]
+    return chosen if chosen.get("enabled") and producer in chosen.get("refresh", []) else None
+
+
+def output_paths(root, producer, characters):
+    return [Path(root) / "knowledge" / name.format(character=c)
+            for name in OUTPUTS[producer] for c in (characters if "{character}" in name else [""])]
+
+
+def publish_outputs(store, request, base, paths, root, provenance):
+    files = {}
+    for path in paths:
+        if path.is_file():
+            raw = checked_file(Path(root) / "knowledge", path, 128 * 1024 * 1024)
+            name = str(path.relative_to(Path(root) / "knowledge"))
+            validate_output(name, raw)
+            files[name] = raw
+    if not files:
+        raise ValueError("fixed producer has no output")
+    return store.publish(request, base, files, provenance)
+
+
+@contextmanager
+def refresh_step(root, code_root, step, characters, request, chosen_override=None, method_root=None):
+    """Wrap the existing successful producer, including its original scientific gates.
+
+    Legacy files are compatibility views. On admission they have exactly one
+    writer, this adapter; newly bound consumers use only immutable D1 bytes.
+    The journal restores preimages after an interrupted/failed producer. No
+    automatic source lock removal or replay of the computation occurs.
+    """
+    chosen = chosen_override if chosen_override is not None else active(root, step)
+    if chosen is None:
+        yield None
+        return
+    producer = step.split(":")[0]
+    method_root = Path(method_root or code_root).resolve()
+    fingerprint = method(method_root, producer)
+    directory = Path(chosen["directory"])
+    if not (directory / "learning.sqlite").is_file():
+        raise ValueError("original fixed-data database unavailable; restore rather than reinitialize")
+    journal = directory / ("refresh-journal-" + sha(str(Path(code_root).resolve()).encode())[:12] + ".json")
+    with (directory / "data-publication.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        store = Store(directory)
+        old_env = os.environ.get("STS2_FIXED_DATA_LEASE")
+        old_journal = os.environ.get("STS2_FIXED_DATA_JOURNAL")
+        old_knowledge = os.environ.get("STS2_FIXED_KNOWLEDGE_SNAPSHOT")
+        old_fd = os.environ.get("STS2_FIXED_DATA_LOCK_FD")
+        was_inheritable = os.get_inheritable(lock.fileno())
+        try:
+            recover(store, journal, code_root)
+            if not store.current():
+                raise ValueError("fixed-data baseline missing; seed original published bytes before switching")
+            previous = store.data_receipt(request)
+            if previous:
+                # A restart checks the durable result; it must not recompute or
+                # republish completed data under a newer method/base.
+                yield {"rc": 0, "version": previous["version"], "already_completed": True}
+                return
+            if chosen["methods"].get(producer) != fingerprint:
+                raise ValueError("unadmitted fixed method/consumer capability; engineering required")
+            knowledge = knowledge_binding(root) if producer == "v6-history" else None
+            if knowledge:
+                os.environ["STS2_FIXED_KNOWLEDGE_SNAPSHOT"] = knowledge["snapshot"]
+            else:
+                os.environ.pop("STS2_FIXED_KNOWLEDGE_SNAPSHOT", None)
+            paths = output_paths(code_root, producer, characters)
+            before = {}
+            # Preimages use the same immutable object store as releases, without
+            # duplicating large JSON as a hex-expanded journal or losing recovery
+            # at the consumer's maximum 128 MiB payload size.
+            with store.transaction():
+                for p in paths:
+                    raw = checked_file(Path(code_root) / "knowledge", p, 128 * 1024 * 1024) if p.is_file() else None
+                    before[str(p)] = sha(raw) if raw is not None else None
+                    if raw is not None:
+                        store.db.execute("INSERT OR IGNORE INTO objects VALUES(?,?)", (sha(raw), raw))
+            inputs = source_cut(code_root, producer, characters)
+            base = store.current()
+            state = {"schema": "fixed-data-journal-v1", "request": request, "base": base, "paths": before,
+                     "root": str(Path(code_root).resolve()), "status": "preparing"}
+            atomic(journal, (packed(state) + "\n").encode())
+            os.environ["STS2_FIXED_DATA_LEASE"] = str(directory)
+            os.environ["STS2_FIXED_DATA_JOURNAL"] = str(journal)
+            os.set_inheritable(lock.fileno(), True)
+            os.environ["STS2_FIXED_DATA_LOCK_FD"] = str(lock.fileno())
+            result = {"rc": None, "version": None}
+            yield result
+            if result["rc"] != 0:
+                raise ValueError("fixed producer failed; previous data retained")
+            if method(method_root, producer) != fingerprint or source_cut(code_root, producer, characters) != inputs:
+                raise ValueError("fixed method/knowledge inputs changed during refresh")
+            provenance = {"producer": producer, "method_sha256": fingerprint, "consumer_capability": "fixed-data-v1",
+                          "characters": characters, "knowledge_inputs": inputs,
+                          "method_source_root": str(method_root), "compatibility_root": str(Path(code_root).resolve()),
+                          "knowledge_version": knowledge["version"] if knowledge else None,
+                          "knowledge_dependencies": {name.removeprefix("knowledge/"): digest for name, digest in inputs.items()
+                                                     if Path(name).name in ("build-cores.json",)},
+                          "model_inputs": {name: digest for name, digest in inputs.items() if Path(name).name != "build-cores.json"},
+                          "control_sha256": chosen["control_sha256"], "scientific_gates": "original producer unchanged",
+                          "samples": "original per-character/ascension fields and source references in immutable output"}
+            unchanged = all((sha(checked_file(Path(code_root) / "knowledge", p, 128 * 1024 * 1024)) if p.is_file() else None) == before[str(p)] for p in paths)
+            result["version"] = base if unchanged else publish_outputs(store, request, base, paths, code_root, provenance)
+            receipt = {"schema": "fixed-data-completion-v1", "request": request, "version": result["version"],
+                       "status": "unchanged" if unchanged else "published", "producer": producer,
+                       "method_sha256": fingerprint, "control_sha256": chosen["control_sha256"]}
+            with store.transaction():
+                store.db.execute("INSERT INTO data_attempts VALUES(?,?,?)", (request, result["version"], packed(receipt)))
+            state.update(status="committed", version=result["version"])
+            atomic(journal, (packed(state) + "\n").encode())
+        except BaseException:
+            recover(store, journal, code_root)
+            raise
+        finally:
+            if old_env is None:
+                os.environ.pop("STS2_FIXED_DATA_LEASE", None)
+            else:
+                os.environ["STS2_FIXED_DATA_LEASE"] = old_env
+            if old_journal is None:
+                os.environ.pop("STS2_FIXED_DATA_JOURNAL", None)
+            else:
+                os.environ["STS2_FIXED_DATA_JOURNAL"] = old_journal
+            if old_knowledge is None:
+                os.environ.pop("STS2_FIXED_KNOWLEDGE_SNAPSHOT", None)
+            else:
+                os.environ["STS2_FIXED_KNOWLEDGE_SNAPSHOT"] = old_knowledge
+            if old_fd is None:
+                os.environ.pop("STS2_FIXED_DATA_LOCK_FD", None)
+            else:
+                os.environ["STS2_FIXED_DATA_LOCK_FD"] = old_fd
+            os.set_inheritable(lock.fileno(), was_inheritable)
+            store.close()
+
+
+def recover(store, journal, root):
+    if not journal.exists():
+        return
+    row = json.loads(checked_file(store.directory, journal, 1024 * 1024))
+    if row["root"] != str(Path(root).resolve()):
+        raise ValueError("foreign refresh journal")
+    # The commit may have succeeded before the process could persist its receipt.
+    committed = store.db.execute("SELECT version,provenance FROM data_releases WHERE request=?", (row["request"],)).fetchone()
+    if committed and not store.data_receipt(row["request"]):
+        provenance = json.loads(committed[1])
+        receipt = {"schema": "fixed-data-completion-v1", "request": row["request"], "version": committed[0],
+                   "status": "published", "producer": provenance["producer"], "method_sha256": provenance["method_sha256"],
+                   "control_sha256": provenance["control_sha256"]}
+        with store.transaction():
+            store.db.execute("INSERT INTO data_attempts VALUES(?,?,?)", (row["request"], committed[0], packed(receipt)))
+    if not committed and row["status"] == "preparing":
+        allowed = Path(root).resolve() / "knowledge"
+        for name, digest in row["paths"].items():
+            path = Path(name)
+            path.relative_to(allowed)
+            if path.is_symlink() or path.parent.resolve() != path.parent:
+                raise ValueError("unsafe interrupted compatibility path")
+            if digest is None:
+                path.unlink(missing_ok=True)
+            else:
+                original = store.db.execute("SELECT body FROM objects WHERE digest=?", (digest,)).fetchone()
+                if original is None or sha(original[0]) != digest:
+                    raise ValueError("fixed preimage object unavailable; preserve journal")
+                atomic(path, original[0])
+        row["status"] = "restored"
+        atomic(journal, (packed(row) + "\n").encode())
+    elif committed and row["status"] == "preparing":
+        row.update(status="committed", version=committed[0])
+        atomic(journal, (packed(row) + "\n").encode())
+
+
+def seed(root, directory, request):
+    """Explicit natural-boundary initial adapter: exact published bytes, no retuning."""
+    root = Path(root).resolve()
+    characters = [p.name for p in (root / "knowledge/characters").iterdir() if p.is_dir()]
+    paths = set(p for producer in OUTPUTS for p in output_paths(root, producer, characters) if p.is_file())
+    store = Store(directory)
+    try:
+        inputs = source_cut(root, "v6-history", characters)
+        return publish_outputs(store, request, None, sorted(paths), root,
+                               {"producer": "initial-adapter", "consumer_capability": "fixed-data-v1", "scope_change": False,
+                                "knowledge_dependencies": {name.removeprefix("knowledge/"): digest for name, digest in inputs.items()}})
+    finally:
+        store.close()
+
+
+def current_file(root, state_dir, relative, legacy_root=None):
+    chosen = capture(root, state_dir)
+    if not chosen.get("enabled") or not any(pattern == relative or pattern.replace("{character}", relative.split("/")[1]) == relative for pattern in managed_paths(chosen)):
+        return Path(legacy_root or root) / "knowledge" / relative
+    store = Store(chosen["directory"], readonly=True)
+    try:
+        version = store.current()
+        if not version or relative not in store.manifest(version):
+            raise ValueError("fixed data baseline missing")
+        return Path(store.snapshot(version)) / relative
+    finally:
+        store.close()
+
+
+if __name__ == "__main__":
+    import argparse
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("command", choices=["method", "seed"])
+    p.add_argument("--root", required=True)
+    p.add_argument("--producer")
+    p.add_argument("--runtime")
+    p.add_argument("--request")
+    a = p.parse_args()
+    print(method(a.root, a.producer) if a.command == "method" else seed(a.root, a.runtime, a.request))
diff --git a/ops/learning_runtime_launch.py b/ops/learning_runtime_launch.py
new file mode 100644
index 000000000..24e873ab5
--- /dev/null
+++ b/ops/learning_runtime_launch.py
@@ -0,0 +1,89 @@
+"""Pin fixed data for a new run; a resumed run recovers its original directory/version."""
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import sys
+
+from learning_runtime import capture
+from learning_runtime_store import Store
+from learning_runtime_data import managed_paths
+
+
+def launch(root, screen, run_id, session, config_log, code, command):
+    original = None
+    if screen not in ("MAIN_MENU", "CHARACTER_SELECT", "GAME_OVER"):
+        if not Path(config_log).exists():
+            selected = capture(root)
+            if not selected.get("enabled") or not managed_paths(selected):
+                had_binding = False
+                for old in selected.get("read_directories", []):
+                    store = Store(old, readonly=True)
+                    try:
+                        had_binding = had_binding or bool(store.db.execute("SELECT 1 FROM data_bindings LIMIT 1").fetchone())
+                    finally:
+                        store.close()
+                if not had_binding:
+                    return command, {k: v for k, v in os.environ.items() if not k.startswith("STS2_DATA_")}
+            raise ValueError("original data/run config unavailable")
+        if not re.fullmatch(r"[A-Z0-9]{12}", run_id):
+            raise ValueError("unknown existing run")
+        with Path(config_log).open("rb") as stream:
+            stream.seek(0, 2)
+            size = stream.tell()
+            stream.seek(max(0, size - 2 * 1024 * 1024))
+            if size > 2 * 1024 * 1024:
+                stream.readline()
+            rows = stream.read().splitlines()
+        row = next((json.loads(raw) for raw in reversed(rows) if json.loads(raw).get("run_id") == run_id), None)
+        if row is None:
+            raise ValueError("missing original run config")
+        original = row.get("knowledge", {}).get("fixed_data")
+        if original is None:
+            # An existing run without D1 keeps the old file contract even if a
+            # new control has enabled D1 in the meantime.
+            return command, {k: v for k, v in os.environ.items() if not k.startswith("STS2_DATA_")}
+        directory = Path(original["directory"])
+        directory.relative_to(Path(root).resolve() / "data")
+        if directory.resolve() != directory:
+            raise ValueError("original fixed-data directory redirected")
+        key = original["run"]
+        patterns = None
+    else:
+        selected = capture(root)
+        patterns = managed_paths(selected)
+        if not selected.get("enabled") or not patterns:
+            return command, {k: v for k, v in os.environ.items() if not k.startswith("STS2_DATA_")}
+        directory = Path(selected["directory"])
+        key = "launch:" + session
+    if not (directory / "learning.sqlite").is_file():
+        raise ValueError("original fixed-data runtime unavailable")
+    store = Store(directory)
+    try:
+        bound = store.bind(key, code, patterns)
+        dependencies = store.knowledge_dependencies(bound["version"], bound["managed_paths"])
+        if original and original["version"] != bound["version"]:
+            raise ValueError("original data version mismatch")
+        if original and "managed_paths" in original and original["managed_paths"] != bound["managed_paths"]:
+            raise ValueError("original data consumer selection mismatch")
+    finally:
+        store.close()
+    return command, {**os.environ, "STS2_DATA_VERSION": bound["version"], "STS2_DATA_SNAPSHOT": bound["snapshot"],
+                     "STS2_DATA_RUNTIME": str(directory), "STS2_DATA_RUN_KEY": key,
+                     "STS2_DATA_KNOWLEDGE_DEPENDENCIES": json.dumps(dependencies), "STS2_DATA_MANAGED_PATHS": json.dumps(bound["managed_paths"])}
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser(description=__doc__)
+    for key in ("root", "screen", "run-id", "session", "config-log", "code"):
+        p.add_argument("--" + key, required=True)
+    a, command = p.parse_known_args()
+    if not command or command[0] != "--" or len(command) < 2:
+        p.error("requires -- command")
+    try:
+        argv, env = launch(a.root, a.screen, a.run_id, a.session, a.config_log, a.code, command[1:])
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        print("fixed data launch held: original binding/config unavailable (" + type(error).__name__ + ")", file=sys.stderr)
+        sys.exit(78)
+    os.execvpe(argv[0], argv, env)
diff --git a/ops/learning_runtime_store.py b/ops/learning_runtime_store.py
new file mode 100644
index 000000000..656318e92
--- /dev/null
+++ b/ops/learning_runtime_store.py
@@ -0,0 +1,384 @@
+"""Immutable operational records and fixed-method data releases, separate from decision knowledge.
+
+Uses DELETE journaling: the Python SQLite shipped on this host predates the WAL
+reset fix required by the knowledge runtime. No connection is shared with K1.
+"""
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sqlite3
+import tempfile
+
+ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:+-]{0,180}")
+SHA = re.compile(r"[a-f0-9]{64}")
+KINDS = {"postmortem", "audit", "finding", "evidence", "counterevidence", "proposal-link", "audit-status", "refresh"}
+
+
+def packed(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def checked_file(base, path, limit=32 * 1024 * 1024, *, offset=0, length=None):
+    """Do not follow a scratch/evidence link or read credential-named inputs."""
+    base, path = Path(base).resolve(), Path(path)
+    if not path.is_absolute():
+        path = base / path
+    path.relative_to(base)
+    if any(part in (".", "..") or part.startswith(".env") or "api_key" in part.lower() for part in path.relative_to(base).parts):
+        raise ValueError("unsafe artifact path")
+    current = path
+    while current != base:
+        if current.is_symlink():
+            raise ValueError("linked artifact retained")
+        current = current.parent
+    if type(offset) is not int or offset < 0 or length is not None and (type(length) is not int or not 1 <= length <= limit):
+        raise ValueError("invalid artifact byte range")
+    size = path.stat().st_size if path.is_file() else -1
+    if size < 0 or length is None and size > limit or length is not None and offset + length > size:
+        raise ValueError("missing or oversized artifact")
+    # Open the final component without following links; verify its identity after read.
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    try:
+        before = os.fstat(fd)
+        with os.fdopen(fd, "rb", closefd=False) as stream:
+            stream.seek(offset)
+            raw = stream.read(length if length is not None else limit + 1)
+        after = os.fstat(fd)
+        stable = (before.st_dev, before.st_ino) == (after.st_dev, after.st_ino)
+        if length is None:
+            stable = stable and (before.st_size, before.st_mtime_ns) == (after.st_size, after.st_mtime_ns)
+        if len(raw) > limit or length is not None and len(raw) != length or not stable:
+            raise ValueError("artifact changed during read")
+        current = path.stat()
+        if (current.st_dev, current.st_ino) != (before.st_dev, before.st_ino):
+            raise ValueError("artifact replaced during read")
+        return raw
+    finally:
+        os.close(fd)
+
+
+def atomic(path, raw):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, temp = tempfile.mkstemp(prefix=".learning-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp, path)
+        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(directory)
+        finally:
+            os.close(directory)
+    finally:
+        Path(temp).unlink(missing_ok=True)
+
+
+class Store:
+    def __init__(self, directory, readonly=False):
+        self.directory = Path(directory).resolve()
+        path = self.directory / "learning.sqlite"
+        if path.is_symlink():
+            raise ValueError("linked runtime database")
+        if not readonly:
+            self.directory.mkdir(parents=True, exist_ok=True)
+        self.db = sqlite3.connect(path.as_uri() + ("?mode=ro" if readonly else "?mode=rwc"), uri=True, timeout=5)
+        self.db.row_factory = sqlite3.Row
+        version = self.db.execute("PRAGMA user_version").fetchone()[0]
+        if version not in (0, 1) or readonly and version != 1 or version == 0 and self.db.execute("SELECT count(*) FROM sqlite_master WHERE type='table'").fetchone()[0]:
+            self.db.close()
+            raise ValueError("unknown operational database schema")
+        self.db.execute("PRAGMA foreign_keys=ON")
+        if not readonly:
+            self.db.execute("PRAGMA journal_mode=DELETE")
+            self.db.execute("PRAGMA synchronous=FULL")
+            self.db.executescript("""
+            PRAGMA user_version=1;
+            CREATE TABLE IF NOT EXISTS objects(digest TEXT PRIMARY KEY, body BLOB NOT NULL);
+            CREATE TABLE IF NOT EXISTS completions(
+              id TEXT PRIMARY KEY, digest TEXT NOT NULL, task TEXT NOT NULL, character TEXT NOT NULL,
+              body TEXT NOT NULL CHECK(json_valid(body)), receipt TEXT NOT NULL CHECK(json_valid(receipt)));
+            CREATE TABLE IF NOT EXISTS submissions(
+              batch TEXT NOT NULL, digest TEXT NOT NULL REFERENCES objects(digest), task TEXT NOT NULL, character TEXT NOT NULL,
+              PRIMARY KEY(batch,digest));
+            CREATE TABLE IF NOT EXISTS submission_events(
+              id INTEGER PRIMARY KEY, batch TEXT NOT NULL, digest TEXT NOT NULL, state TEXT NOT NULL, error TEXT,
+              created TEXT NOT NULL DEFAULT(strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+              FOREIGN KEY(batch,digest) REFERENCES submissions(batch,digest));
+            CREATE INDEX IF NOT EXISTS submission_scope ON submissions(character,task,batch);
+            CREATE INDEX IF NOT EXISTS submission_history ON submission_events(batch,digest,id);
+            CREATE TABLE IF NOT EXISTS records(
+              character TEXT NOT NULL, id TEXT NOT NULL, revision TEXT NOT NULL,
+              completion TEXT NOT NULL REFERENCES completions(id), kind TEXT NOT NULL,
+              status TEXT, payload TEXT NOT NULL CHECK(json_valid(payload)), PRIMARY KEY(character,id,revision));
+            CREATE INDEX IF NOT EXISTS records_scope ON records(character,kind,completion);
+            CREATE INDEX IF NOT EXISTS records_status ON records(character,kind,status);
+            CREATE TABLE IF NOT EXISTS record_evidence(
+              completion TEXT NOT NULL REFERENCES completions(id), record_id TEXT NOT NULL, ordinal INTEGER NOT NULL,
+              role TEXT NOT NULL, source_path TEXT NOT NULL, source_sha256 TEXT NOT NULL REFERENCES objects(digest),
+              character TEXT NOT NULL, run TEXT, ascension INTEGER, payload TEXT NOT NULL CHECK(json_valid(payload)),
+              PRIMARY KEY(completion,record_id,ordinal));
+            CREATE INDEX IF NOT EXISTS operational_evidence_scope ON record_evidence(character,run,ascension,role);
+            CREATE INDEX IF NOT EXISTS operational_evidence_source ON record_evidence(source_sha256,completion,record_id);
+            CREATE TABLE IF NOT EXISTS links(
+              completion TEXT NOT NULL REFERENCES completions(id), kind TEXT NOT NULL, target TEXT NOT NULL,
+              PRIMARY KEY(completion,kind,target));
+            CREATE INDEX IF NOT EXISTS links_target ON links(kind,target,completion);
+            CREATE TABLE IF NOT EXISTS data_releases(
+              version TEXT PRIMARY KEY, parent TEXT, request TEXT UNIQUE NOT NULL, digest TEXT NOT NULL,
+              manifest TEXT NOT NULL CHECK(json_valid(manifest)), provenance TEXT NOT NULL CHECK(json_valid(provenance)));
+            CREATE TABLE IF NOT EXISTS pointers(name TEXT PRIMARY KEY, version TEXT NOT NULL REFERENCES data_releases(version));
+            CREATE TABLE IF NOT EXISTS data_bindings(
+              run TEXT PRIMARY KEY, version TEXT NOT NULL REFERENCES data_releases(version), code TEXT NOT NULL,
+              managed_paths TEXT NOT NULL CHECK(json_valid(managed_paths)));
+            CREATE TABLE IF NOT EXISTS switches(request TEXT PRIMARY KEY, version TEXT NOT NULL REFERENCES data_releases(version));
+            CREATE TABLE IF NOT EXISTS data_attempts(request TEXT PRIMARY KEY, version TEXT,
+              payload TEXT NOT NULL CHECK(json_valid(payload)));
+            """)
+
+    def close(self):
+        self.db.close()
+
+    @contextmanager
+    def transaction(self):
+        self.db.execute("BEGIN IMMEDIATE")
+        try:
+            yield
+            self.db.commit()
+        except BaseException:
+            self.db.rollback()
+            raise
+
+    def completion(self, ident):
+        row = self.db.execute("SELECT receipt FROM completions WHERE id=?", (ident,)).fetchone()
+        return json.loads(row[0]) if row else None
+
+    def submit_raw(self, batch, task, character, raw):
+        digest = sha(raw)
+        with self.transaction():
+            self.db.execute("INSERT OR IGNORE INTO objects VALUES(?,?)", (digest, raw))
+            inserted = self.db.execute("INSERT INTO submissions VALUES(?,?,?,?) ON CONFLICT(batch,digest) DO NOTHING", (batch, digest, task, character)).rowcount
+            if inserted:
+                self.db.execute("INSERT INTO submission_events(batch,digest,state) VALUES(?,?,'received')", (batch, digest))
+        return digest
+
+    def submission_state(self, batch, digest, state, error=None):
+        if state not in ("pending", "published"):
+            raise ValueError("invalid submission outcome")
+        with self.transaction():
+            previous = self.db.execute("SELECT state,error FROM submission_events WHERE batch=? AND digest=? ORDER BY id DESC LIMIT 1", (batch, digest)).fetchone()
+            if previous is None or tuple(previous) != (state, error):
+                self.db.execute("INSERT INTO submission_events(batch,digest,state,error) VALUES(?,?,?,?)", (batch, digest, state, error))
+
+    def submission_history(self, batch):
+        return [dict(row) for row in self.db.execute("SELECT digest,state,error,created FROM submission_events WHERE batch=? ORDER BY id", (batch,))]
+
+    def complete(self, body, objects, engineering=False):
+        identity = body["id"]
+        digest = sha(packed(body).encode())
+        receipt = {"schema": "operational-completion-v1", "id": identity, "digest": digest,
+                   "task": body["task"], "character": body["character"], "records": len(body["records"]),
+                   "source_delivery": False, "parent_closed": False, "engineering_required": engineering}
+        with self.transaction():
+            prior = self.db.execute("SELECT digest,receipt FROM completions WHERE id=?", (identity,)).fetchone()
+            if prior:
+                if prior[0] != digest:
+                    raise ValueError("completion ID reused with different bytes")
+                return json.loads(prior[1])
+            for digest_key, raw in objects.items():
+                if sha(raw) != digest_key:
+                    raise ValueError("corrupt object")
+                self.db.execute("INSERT OR IGNORE INTO objects VALUES(?,?)", (digest_key, raw))
+            self.db.execute("INSERT INTO completions VALUES(?,?,?,?,?,?)", (identity, digest, body["task"], body["character"], packed(body), packed(receipt)))
+            for record in body["records"]:
+                payload = packed(record)
+                status = record["payload"].get("status")
+                self.db.execute("INSERT INTO records VALUES(?,?,?,?,?,?,?) ON CONFLICT(character,id,revision) DO NOTHING", (body["character"], record["id"], sha(payload.encode()), identity, record["kind"], status if isinstance(status, str) else None, payload))
+                for ordinal, evidence in enumerate(record["evidence"]):
+                    self.db.execute("INSERT INTO record_evidence VALUES(?,?,?,?,?,?,?,?,?,?)", (identity, record["id"], ordinal,
+                                    "contradict" if record["kind"] == "counterevidence" else "source", evidence["path"], evidence["sha256"],
+                                    body["character"], evidence.get("run"), evidence.get("ascension"), packed(evidence)))
+            for kind in ("parents", "proposals", "ledger_ids", "runs"):
+                for target in body[kind]:
+                    self.db.execute("INSERT INTO links VALUES(?,?,?)", (identity, kind, target))
+        return receipt
+
+    def records(self, character, kind=None, limit=100, offset=0, run=None):
+        if not 1 <= limit <= 100 or not 0 <= offset <= 100000:
+            raise ValueError("query bounds")
+        rows = self.db.execute("SELECT completion,payload FROM records WHERE character=? AND (? IS NULL OR kind=?) AND (? IS NULL OR EXISTS(SELECT 1 FROM links WHERE links.completion=records.completion AND links.kind='runs' AND links.target=?)) ORDER BY rowid LIMIT ? OFFSET ?",
+                               (character, kind, kind, run, run, limit, offset))
+        return [{"completion": r[0], **json.loads(r[1])} for r in rows]
+
+    def report(self, ident):
+        row = self.db.execute("SELECT body FROM completions WHERE id=?", (ident,)).fetchone()
+        if row is None:
+            raise ValueError("unknown operational completion")
+        digest = json.loads(row[0])["report"]["sha256"]
+        result = self.db.execute("SELECT body FROM objects WHERE digest=?", (digest,)).fetchone()
+        if result is None or sha(result[0]) != digest:
+            raise ValueError("report object corrupt/missing")
+        return result[0]
+
+    def run_ids(self, character):
+        return {row[0] for row in self.db.execute("SELECT l.target FROM links l JOIN completions c ON c.id=l.completion WHERE l.kind='runs' AND c.character=? AND c.task='postmortem'", (character,))}
+
+    def current(self):
+        row = self.db.execute("SELECT version FROM pointers WHERE name='data'").fetchone()
+        return row[0] if row else None
+
+    def manifest(self, version):
+        row = self.db.execute("SELECT manifest FROM data_releases WHERE version=?", (version,)).fetchone()
+        if not row:
+            raise ValueError("unknown data version")
+        return json.loads(row[0])
+
+    def knowledge_dependencies(self, version, managed_paths=None):
+        """Resolve effective leaves' origin metadata along this D1 ancestry only."""
+        remaining = self.manifest(version)
+        if managed_paths is not None:
+            remaining = {name: digest for name, digest in remaining.items() if any(
+                pattern == name or pattern.replace("{character}", name.split("/")[1]) == name for pattern in managed_paths)}
+        required = {}
+        while remaining and version:
+            row = self.db.execute("SELECT parent,manifest,provenance FROM data_releases WHERE version=?", (version,)).fetchone()
+            if row is None:
+                raise ValueError("broken data ancestry")
+            parent = self.manifest(row[0]) if row[0] else {}
+            touched = [name for name, digest in remaining.items() if parent.get(name) != digest]
+            if touched:
+                for name, digest in json.loads(row[2]).get("knowledge_dependencies", {}).items():
+                    if name.replace("build-cores.json", "v6-history.json") not in touched:
+                        continue
+                    if name in required and required[name] != digest:
+                        raise ValueError("conflicting data knowledge dependencies")
+                    required[name] = digest
+                for name in touched:
+                    remaining.pop(name)
+            version = row[0]
+        return required
+
+    def snapshot(self, version, manifest=None):
+        manifest = manifest if manifest is not None else self.manifest(version)
+        destination = self.directory / "data-snapshots" / version
+        for name, digest in manifest.items():
+            if not re.fullmatch(r"(?:common|characters/[a-z][a-z0-9_]*)/[a-z0-9-]+\.json", name) or not SHA.fullmatch(digest):
+                raise ValueError("unsafe snapshot manifest")
+            row = self.db.execute("SELECT body FROM objects WHERE digest=?", (digest,)).fetchone()
+            if row is None or sha(row[0]) != digest:
+                raise ValueError("missing/corrupt snapshot object")
+            path = destination / name
+            current = path
+            while current != self.directory:
+                if current.is_symlink():
+                    raise ValueError("linked immutable snapshot path")
+                current = current.parent
+            if path.exists():
+                if sha(checked_file(destination, path, 128 * 1024 * 1024)) != digest:
+                    raise ValueError("immutable snapshot changed")
+            else:
+                atomic(path, row[0])
+        return str(destination)
+
+    def publish(self, request, base, files, provenance):
+        if not ID.fullmatch(request) or not files:
+            raise ValueError("data request identity/outputs missing")
+        signature = sha(packed({"base": base, "files": {p: sha(raw) for p, raw in files.items()}, "provenance": provenance}).encode())
+        with self.transaction():
+            prior = self.db.execute("SELECT version,digest FROM data_releases WHERE request=?", (request,)).fetchone()
+            if prior:
+                if prior[1] != signature:
+                    raise ValueError("data request ID conflict")
+                self.snapshot(prior[0])
+                return prior[0]
+            if base != self.current():
+                raise ValueError("data version conflict; preserve candidate")
+            manifest = self.manifest(base) if base else {}
+            for name, raw in files.items():
+                digest = sha(raw)
+                self.db.execute("INSERT OR IGNORE INTO objects VALUES(?,?)", (digest, raw))
+                manifest[name] = digest
+            version = "D1-" + sha(packed({"manifest": manifest, "provenance": provenance, "request": request, "parent": base}).encode())
+            # Files are durable before a pointer can become visible. A crash here leaves only reusable orphan files.
+            self.snapshot(version, manifest)
+            self.db.execute("INSERT INTO data_releases VALUES(?,?,?,?,?,?)", (version, base, request, signature, packed(manifest), packed(provenance)))
+            self.db.execute("INSERT OR REPLACE INTO pointers VALUES('data',?)", (version,))
+        return version
+
+    def bind(self, run, code, managed_paths=None):
+        if not ID.fullmatch(run) or not re.fullmatch(r"[a-f0-9]{40}", code):
+            raise ValueError("invalid data binding")
+        with self.transaction():
+            prior = self.db.execute("SELECT version,code,managed_paths FROM data_bindings WHERE run=?", (run,)).fetchone()
+            if prior:
+                version = prior[0]
+                selected = json.loads(prior[2])
+            else:
+                version = self.current()
+                if not version:
+                    raise ValueError("data baseline not installed")
+                selected = sorted(set(managed_paths if managed_paths is not None else self.manifest(version)))
+                self.db.execute("INSERT INTO data_bindings VALUES(?,?,?,?)", (run, version, code, packed(selected)))
+        return {"version": version, "snapshot": self.snapshot(version), "run": run, "code": prior[1] if prior else code, "managed_paths": selected}
+
+    def rollback(self, version, request):
+        self.manifest(version)
+        self.snapshot(version)
+        with self.transaction():
+            prior = self.db.execute("SELECT version FROM switches WHERE request=?", (request,)).fetchone()
+            if prior:
+                if prior[0] != version:
+                    raise ValueError("rollback ID conflict")
+                return version
+            self.db.execute("INSERT INTO switches VALUES(?,?)", (request, version))
+            self.db.execute("INSERT OR REPLACE INTO pointers VALUES('data',?)", (version,))
+        return version
+
+    def backup(self, destination):
+        destination = Path(destination)
+        if destination.exists():
+            raise ValueError("backup destination exists")
+        target = sqlite3.connect(destination)
+        try:
+            self.db.backup(target)
+        finally:
+            target.close()
+
+    def data_receipt(self, request):
+        row = self.db.execute("SELECT payload FROM data_attempts WHERE request=?", (request,)).fetchone()
+        return json.loads(row[0]) if row else None
+
+    @classmethod
+    def restore(cls, backup, directory):
+        directory = Path(directory)
+        if directory.exists():
+            raise ValueError("restore requires a new directory")
+        store = cls(directory)
+        source = sqlite3.connect(Path(backup).resolve().as_uri() + "?mode=ro", uri=True)
+        try:
+            source.backup(store.db)
+            if store.db.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
+                raise ValueError("backup integrity failure")
+            for digest, raw in store.db.execute("SELECT digest,body FROM objects"):
+                if sha(raw) != digest:
+                    raise ValueError("backup object checksum failure")
+            for ident, digest, body, receipt in store.db.execute("SELECT id,digest,body,receipt FROM completions"):
+                if sha(packed(json.loads(body)).encode()) != digest or json.loads(receipt).get("id") != ident or json.loads(receipt).get("digest") != digest:
+                    raise ValueError("backup completion checksum failure")
+            for version, in store.db.execute("SELECT version FROM data_releases"):
+                store.snapshot(version)
+            return store
+        except BaseException:
+            store.close()
+            raise
+        finally:
+            source.close()
