+        self.save()
+
+    def test_disabled_keeps_original_argv_and_does_not_initialize_machine_state(self):
+        argv = ['flock', '-F', str(self.root / 'lock'), 'python3', 'fixed.py']
+        self.assertEqual(board_heavy.queued_argv(self.root, 'other', argv), argv)
