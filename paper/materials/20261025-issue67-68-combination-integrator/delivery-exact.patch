+            publish.assert_not_called()
+
+    def test_business_lock_owner_cannot_wait_for_a_machine_slot(self):
+        self.enabled()
+        path = self.root / 'ops/codex-ops/learn.lock'
+        path.parent.mkdir(parents=True)
