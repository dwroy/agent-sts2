{
  "schema": "brain-strategies-v1",
  "character": "silent",
  "entries": [
    {
      "id": "silent-brain-accelerant-external-prefix-context",
      "version": "1.0.0",
      "trigger": {
        "question_types": [
          "card_reward"
        ],
        "acts": [
          2
        ]
      },
      "strategy": "仅Silent A10/v0.111，幕2出现ACCELERANT时，比较现场牌文、真实牌组、备选与跳过，不把历史频率当拿牌规则。幕2/奖励前缀含SNAKEBITE：拿17/40胜，Boss到达39/42机会；不拿34/84胜，Boss到达83/91机会。幕2/奖励前缀含BACKFLIP：拿15/33胜，Boss到达29/33机会；不拿47/101胜，Boss到达110/120机会，差值反向。前缀只是此前奖励获取记录，不是完整牌组；同局跨格，玩家未知。以上为观察关联，Boss到达非通过或双Boss准备度；其他幕/版本另账。",
      "evidence": [
