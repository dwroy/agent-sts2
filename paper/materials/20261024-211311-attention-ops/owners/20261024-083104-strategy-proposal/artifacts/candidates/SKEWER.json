  "entries": [
    {
      "id": "silent-brain-skewer-external-prefix-context",
      "version": "1.0.0",
      "trigger": {
        "question_types": [
          "card_reward"
        ],
        "acts": [
          1
        ]
      },
      "strategy": "仅Silent A10/v0.111，幕1出现SKEWER时，比较现场牌文、真实牌组、备选与跳过，不把历史频率当拿牌规则。幕1/奖励前缀0张：拿3/10胜，Boss到达9/10机会；不拿5/29胜，Boss到达25/29机会。幕1/奖励前缀1张：拿3/10胜，Boss到达9/10机会；不拿17/57胜，Boss到达50/58机会，另格并非独立复验。前缀只是此前奖励获取记录，不是完整牌组；同局跨格，玩家未知。以上为观察关联，Boss到达非通过或双Boss准备度；其他幕/版本另账。",
      "evidence": [
