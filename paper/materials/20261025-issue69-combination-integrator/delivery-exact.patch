diff --git a/agent/tests/learner-public-web-launcher.test.ts b/agent/tests/learner-public-web-launcher.test.ts
new file mode 100644
index 000000000..5a5a3053d
--- /dev/null
+++ b/agent/tests/learner-public-web-launcher.test.ts
@@ -0,0 +1,92 @@
+import { createHash } from "node:crypto";
+import { chmodSync, mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { KnowledgeStore } from "../src/knowledge/runtime/store.js";
+const transport = vi.hoisted(() => vi.fn());
+vi.mock("../../learner/lib/herdr.js", async importOriginal => ({ ...await importOriginal<typeof import("../../learner/lib/herdr.js")>(), runLearnerTui: transport }));
+import { main } from "../../learner/lib/launcher.js";
+
+const roots: string[] = [];
+afterEach(() => { transport.mockReset(); roots.splice(0).forEach(root => rmSync(root, { recursive: true, force: true })); });
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), "web-launcher-")); roots.push(root);
+  const dir = join(root, "ops/codex-ops"); mkdirSync(dir, { recursive: true });
+  const tasks = join(root, "tasks"); mkdirSync(tasks);
+  const task = join(tasks, "strategy-proposal.md");
+  const raw = "---\ntools: Read, Grep, Glob, Bash, Edit, Write\npublic_web: sts2\ndefault.merge: no\n---\n固定研究 {{batch}} merge={{merge}}\n";
+  writeFileSync(task, raw);
+  const runtime = join(root, "data/runtime"), store = new KnowledgeStore(runtime);
+  store.submit({ schema: "knowledge-candidate-v1", id: "seed", base: null, character: "silent", source: "fixture", files: {
+    "characters/silent/strategy-entries.json": JSON.stringify({ schema: "brain-strategies-v1", character: "silent", entries: [] }) } });
+  store.validate("seed"); const version = store.publish("seed"); store.close();
+  const bid = "20261025-220000-strategy-proposal", state = join(dir, "learn.json"), receipt = join(dir, "fixed.tui.json");
+  const batch: Record<string, unknown> = { task: "strategy-proposal", character: "silent", reason: "ops", runs: [], state: "running", pid: process.pid, worktree: root,
+    knowledge_runtime: { enabled: true, directory: runtime }, public_web: { schema: "public-web-research-v1", template_sha256: createHash("sha256").update(raw).digest("hex") } };
+  const save = () => writeFileSync(state, JSON.stringify({ batches: { [bid]: batch } })); save();
+  const env = { HOME: root, LEARNER_CODEX_HOME: join(root, "codex-home"), LEARNER_CODEX_BIN: "/bin/true", STS2_KNOWLEDGE_RUNTIME: runtime,
+    LEARNER_HERDR_PANE: "w1:p2", LEARNER_HERDR_LABEL: `learner-${bid}`, LEARNER_TUI_RECEIPT: receipt, LEARNER_BATCH_ID: bid, LEARNER_STATE_FILE: state };
+  const out: string[] = [], err: string[] = [];
+  const deps = { projectRoot: root, tasksDir: tasks, runsDir: join(root, "runs"), secretFiles: [], env, refreshCodexAuth: undefined,
+    checkCodex: vi.fn(async () => ({ ok: true as const, version: "fixture" })), checkKeys: vi.fn(async () => ({ ok: true as const, checked: 0 })),
+    out: (s: string) => out.push(s), err: (s: string) => err.push(s) };
+  const run = (engine = "codex") => main(["--engine", engine, "--task", "strategy-proposal", "--character", "silent", "--cwd", root, "--set", `batch=${bid}`], deps);
+  return { root, batch, save, deps, run, version, out, err };
+}
+
+it("runs the original registered TUI chain, preserves runtime injection and records native web calls separately from requested mode", async () => {
+  const f = fixture();
+  transport.mockImplementation(async o => {
+    expect(o.request.publicWeb).toBe("sts2"); expect(o.lease.current()).toBe(true);
+    expect(o.prompt).toContain("Codex 内建 web_search"); expect(o.prompt).toContain(f.version);
+    expect(o.prompt).toContain("knowledge_candidate"); expect(o.prompt).toContain("classification-draft");
+    o.log({ type: "response_item", payload: { type: "web_search_call", id: "fixed-open", status: "completed", action: { type: "open_page", url: "https://example.org/fixed" } } });
+    const result = { code: 0, reason: "native-task-complete", message: "fixed research report", session: "019a1000-1234-7123-8123-123456789abc", stopped: true };
+    writeFileSync(o.receipt, JSON.stringify({ state: "session-ended", result })); return result;
+  });
+  expect(await f.run(), f.err.join("")).toBe(0);
+  const file = readdirSync(join(f.root, "runs")).find(n => n.endsWith(".jsonl"))!;
+  const rows = readFileSync(join(f.root, "runs", file), "utf8").trim().split("\n").map(s => JSON.parse(s));
+  expect(rows[0]).toMatchObject({ transport: "herdr-interactive", public_web: { requested: "live", observed: null, shell_network: false } });
+  expect(rows[0].command).toContain('web_search="live"');
+  const journal = readFileSync(rows[0].public_web.native_events, "utf8").trim().split("\n").map(s => JSON.parse(s));
+  expect(journal).toHaveLength(1); expect(journal[0].event.payload.id).toBe("fixed-open");
+  expect(rows.at(-1).summary.toolCalls.web_search).toBe(1);
+  expect(f.deps.checkKeys).toHaveBeenCalledOnce(); expect(transport).toHaveBeenCalledOnce();
+});
+
+it("refuses unauthorized ordinary registrations and unsupported engines before exposing any tools", async () => {
+  const f = fixture(); delete f.batch.public_web; f.save();
+  expect(await f.run()).toBe(2); expect(transport).not.toHaveBeenCalled();
+  expect(await f.run("claude")).toBe(2); expect(transport).not.toHaveBeenCalled();
+  expect(f.deps.checkKeys).not.toHaveBeenCalled();
+});
+
+it.each([true, false])("persists exec search projections and only harvests page calls after the exact original native prompt (match=%s)", async match => {
+  const f = fixture();
+  delete (f.deps.env as NodeJS.ProcessEnv).LEARNER_HERDR_PANE;
+  const binary = join(f.root, "fake-codex.cjs");
+  writeFileSync(binary, `#!${process.execPath}
+const fs = require('node:fs'), path = require('node:path');
+const prompt = fs.readFileSync(0,'utf8'), id = '019a1000-1234-7123-8123-123456789abc';
+const dir = path.join(process.env.CODEX_HOME,'sessions','2026','10','25'); fs.mkdirSync(dir,{recursive:true});
+const rows = [
+ {type:'session_meta',payload:{id,cwd:process.cwd()}},
+ {type:'response_item',payload:{type:'message',role:'user',content:[{type:'input_text',text:${match ? "prompt" : "'unrelated old prompt'"}}]}},
+ {type:'response_item',payload:{type:'web_search_call',id:'fixed-open',status:'completed',action:{type:'open_page',url:'https://example.org/fixed'}}}
+];
+fs.writeFileSync(path.join(dir,'rollout-'+id+'.jsonl'),rows.map(x=>JSON.stringify(x)).join('\\n')+'\\n');
+for (const row of [ {type:'thread.started',thread_id:id}, {type:'item.completed',item:{type:'web_search',id:'exec-search',query:'fixed'}},
+ {type:'item.completed',item:{type:'agent_message',text:'fixed result'}}, {type:'turn.completed',usage:{input_tokens:1,output_tokens:1}} ]) console.log(JSON.stringify(row));
+`);
+  chmodSync(binary, 0o700); f.deps.env.LEARNER_CODEX_BIN = binary;
+  expect(await f.run(), f.err.join("")).toBe(0);
+  expect(transport).not.toHaveBeenCalled();
+  const file = readdirSync(join(f.root, "runs")).find(n => n.endsWith(".jsonl"))!;
+  const rows = readFileSync(join(f.root, "runs", file), "utf8").trim().split("\n").map(s => JSON.parse(s));
+  expect(rows[0].transport).toBe("stdio"); expect(rows[0].command).toContain('web_search="live"');
+  const journal = readFileSync(rows[0].public_web.native_events, "utf8").trim().split("\n").map(s => JSON.parse(s));
+  expect(journal.some(e => e.event.item?.id === "exec-search")).toBe(true);
+  expect(journal.filter(e => e.event.payload?.id === "fixed-open")).toHaveLength(match ? 1 : 0);
+});
diff --git a/agent/tests/learner-public-web.test.ts b/agent/tests/learner-public-web.test.ts
new file mode 100644
index 000000000..5cd519f3d
--- /dev/null
+++ b/agent/tests/learner-public-web.test.ts
@@ -0,0 +1,92 @@
+import { createHash } from "node:crypto";
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { fileURLToPath } from "node:url";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { codexCommand, codexPermissions, learnerInteractiveArgs, claudeCommand, type EngineRequest } from "../../learner/lib/engines.js";
+import { loadTask, parseTask } from "../../learner/lib/task.js";
+import { publicWebEvent, publicWebPermission } from "../../learner/lib/public-web.js";
+import { NativeBatch } from "../../learner/lib/herdr.js";
+import { SummaryTracker } from "../../learner/lib/summary.js";
+import { codexConfig } from "../src/brain/engines/codex.js";
+
+const roots: string[] = [];
+afterEach(() => roots.splice(0).forEach(root => rmSync(root, { recursive: true, force: true })));
+const tasks = fileURLToPath(new URL("../../learner/tasks", import.meta.url));
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), "learner-web-")); roots.push(root);
+  const file = join(root, "ops/codex-ops/learn.json"); mkdirSync(join(root, "ops/codex-ops"), { recursive: true });
+  const spec = loadTask(join(tasks, "public-web/strategy-proposal.md"), tasks);
+  const batch = { task: "strategy-proposal", character: "silent", runs: [], reason: "ops", state: "running", pid: process.pid, worktree: root,
+    public_web: { schema: "public-web-research-v1", template_sha256: createHash("sha256").update(readFileSync(spec.path)).digest("hex") },
+    knowledge_runtime: { enabled: true, directory: join(root, "data/runtime") } };
+  const env = { LEARNER_BATCH_ID: "20261025-220000-strategy-proposal", LEARNER_STATE_FILE: file, STS2_KNOWLEDGE_RUNTIME: batch.knowledge_runtime.directory };
+  const save = () => writeFileSync(file, JSON.stringify({ batches: { [env.LEARNER_BATCH_ID]: batch } })); save();
+  return { root, spec, batch, env, save };
+}
+const request = (root = "/fixture"): EngineRequest => ({ engine: "codex", cwd: root, projectRoot: root, tools: ["Read", "Grep", "Glob", "Bash", "Edit", "Write"] });
+
+describe("explicit hosted public research", () => {
+  it("keeps ordinary/fixed/code/external tasks offline and rejects unrecognized declarations", () => {
+    for (const name of ["fix-batch", "postmortem", "experience-update", "strategy-proposal", "strategy-external", "smoke"]) {
+      const task = loadTask(name, tasks);
+      expect(task.publicWeb).toBeUndefined();
+      expect(publicWebPermission(task, "codex", "silent", "/fixture", "/fixture", {})).toBeUndefined();
+    }
+    expect(() => parseTask("---\ntools: Read\npublic_web: true\n---\nfixed", "x", "x.md")).toThrow("只支持 sts2");
+    expect(codexCommand(request(), "fixed").args).toContain('web_search="disabled"');
+  });
+  it("binds declaration, original live owner, task SHA, character and runtime before enabling web", () => {
+    const f = fixture();
+    const allow = () => publicWebPermission(f.spec, "codex", "silent", f.root, f.root, f.env);
+    expect(allow()).toBe("sts2");
+    expect(() => publicWebPermission(f.spec, "claude", "silent", f.root, f.root, f.env)).toThrow("其他引擎未接入");
+    expect(() => publicWebPermission(f.spec, "codex", "ironclad", f.root, f.root, f.env)).toThrow();
+    for (const mutation of [
+      () => { f.batch.public_web.template_sha256 = "a".repeat(64); },
+      () => { f.batch.reason = "tick"; },
+      () => { f.batch.task = "fix-batch"; },
+      () => { f.batch.state = "done"; },
+      () => { f.batch.knowledge_runtime.enabled = false; },
+    ]) {
+      const before = structuredClone(f.batch); mutation(); f.save(); expect(allow).toThrow(); Object.assign(f.batch, before); f.save();
+    }
+    for (const key of ["external_source", "backfill_source", "proposal_ids", "research_request", "implementation_request"]) {
+      const batch = f.batch as Record<string, unknown>; batch[key] = ["fixed"];
+      f.save(); expect(allow).toThrow(); delete batch[key]; f.save();
+    }
+    expect(() => allow()).not.toThrow();
+  });
+  it("uses the same explicit live setting for exec, TUI and resume without widening filesystem/network permissions", () => {
+    const req = { ...request(), publicWeb: "sts2" as const };
+    expect(codexPermissions(req)).toEqual(codexPermissions(request()));
+    for (const args of [codexCommand(req, "fixed").args, learnerInteractiveArgs(req),
+      codexCommand({ ...req, resumeThread: "019a1000-1234-7123-8123-123456789abc" }, "fixed").args]) {
+      expect(args).toContain('web_search="live"');
+      expect(args.join(" ")).not.toMatch(/network_access=true|danger-full-access/);
+      expect(args).toContain("browser_use"); expect(args[args.indexOf("browser_use") - 1]).toBe("--disable");
+    }
+    const prompt = codexCommand(req, "fixed").stdin;
+    expect(prompt).toContain("shell不联网"); expect(prompt).toContain("Codex 内建 web_search");
+    expect(() => claudeCommand({ ...req, engine: "claude" }, "fixed")).toThrow("未接入");
+    expect(codexConfig({ effort: "high", systemFile: "/fixture/system", catalogFile: "/fixture/catalog", stateDir: "/fixture/state", summary: "auto", serviceTier: null }).join(" ")).toContain('web_search="disabled"');
+  });
+  it("records actual completed/failed/empty search evidence separately from requested capability", () => {
+    const native = new NativeBatch("marker");
+    native.feed({ type: "event_msg", payload: { type: "task_started", turn_id: "one" } });
+    native.feed({ type: "event_msg", payload: { type: "user_message", message: "marker" } });
+    const tracker = new SummaryTracker("codex");
+    for (const status of ["completed", "failed"]) {
+      const event = { type: "response_item", payload: { type: "web_search_call", id: status, status, action: { type: "search", query: "fixed-empty-query" } } };
+      const saved = publicWebEvent(event)!;
+      expect(saved.event).toEqual(event);
+      expect(saved.sha256).toBe(createHash("sha256").update(JSON.stringify(event)).digest("hex"));
+      native.feed(event); tracker.feed(JSON.stringify(event));
+    }
+    expect(native.progress).toBe(2); expect(tracker.summary.toolCalls.web_search).toBe(1);
+    expect(publicWebEvent({ type: "learner_launch", public_web: { requested: "live" } })).toBeUndefined();
+    expect(publicWebEvent({ type: "item.completed", item: { type: "web_search", id: "exec", status: "completed", query: "fixed" } })).toBeDefined();
+    expect(publicWebEvent({ type: "item.completed", item: { type: "command_execution" } })).toBeUndefined();
+  });
+});
diff --git a/docs/learning-public-web.md b/docs/learning-public-web.md
new file mode 100644
index 000000000..d43aa28bc
--- /dev/null
+++ b/docs/learning-public-web.md
@@ -0,0 +1,66 @@
+# 学习侧公开资料研究（#69）
+
+只在原 `strategy-proposal` 槽位显式派发 Silent 纯内容研究。Codex 内建搜索与页面读取请求为 `web_search="live"`；shell 的网络、文件权限、账号、模型、档位、并发门和对局大脑的 `web_search="disabled"` 保持原合同。没有声明的普通任务、代码任务及旧外部冻结批次仍不开放。Claude 暂未接入，声明联网时启动器拒绝，不冒称支持。
+
+实际链：原 ops `write --public-web` → 原 `dispatch_write/start_learner`、登记屏障与独立工作树 → wrapper 核原登记并选择固定模板 → launcher 核任务声明/SHA、原批次/活owner/角色/runtime → exec 或 Herdr TUI 共用命令与前导说明 → 来源产物 → 原 `knowledge_runtime.complete` → K1 候选校验/事务发布 → 原只读工具。没有第二套调度器。队列接管不是本功能前置，仍按原发布顺序执行。
+
+## 原 ops 的自然验收入口
+
+集成/适用组合检查及宿主配套部署后，在已启用知识 runtime 的原运行根调用：
+
+```bash
+nice -n 19 python3 ops/codex-ops-learn.py write --task strategy-proposal --character silent --public-web
+```
+
+它使用原普通策略槽及原容量/发布/额度保护；不启额外槽位，不自动抢四道外部槽。仅手动 `write` 支持该标记，不接受 `--runs`、`--request`、其他角色/代码任务，也不自动把历史批次升级成联网批次。根运行状态登记 `public_web={schema,template_sha256}` 和原 `knowledge_runtime`。模板 `learner/tasks/public-web/strategy-proposal.md` 的 basename 保留原 task 身份，接既有内容注入及完成回调。wrapper 先等原登记屏障，再核模板 SHA 和原租约；启动器再独立核验一次。原学习者已登记后不得热改它的模板、SHA、runtime 或参数。
+
+优先已下载玩家 A10 库；资料不足才检索/实际打开公开页面。一个合法真实单元依次保存：原批次登记、启动命令/前导、原生 `turn_context` 与 web 事件、来源账本、逐来源去向、真实候选及事务发布回执、该版本的本地工具读取结果。若已下载资料已足够，可以不搜索；这能交内容，但不能称真实搜索/读取验收完成。失败/空结果保留并正常交无增量报告，不伪造来源或知识。后续正常局核该条目实际采用；不为验收开局，搜索或发布成功不代表胜率提升。
+
+## 来源保存
+
+来源助手只处理 stdin JSON 和本批 scratch，不联网，也不读取传入的任意文件路径。写时间前先 `date`。调用：
+
+```bash
+python3 learner/public_web_sources.py record --scratch <本批scratch绝对路径> --batch <原batch> < <本批来源JSON>
+python3 learner/public_web_sources.py verify --scratch <本批scratch绝对路径> --batch <原batch>
+```
+
+stdin 字段如下（这是格式，不是游戏知识）：
+
+```json
+{
+  "url": "https://example.org/sts2/source",
+  "acquired_at": "2026-10-25T22:00:00+08:00",
+  "game_version": "unknown",
+  "character": "silent",
+  "ascension": 10,
+  "sample": {"runs": null, "players": null},
+  "license": "unknown; 核实际页面许可后填写",
+  "limitations": "实际限制/代理/未读范围/版本未知",
+  "summary": "实际阅读后保存的去标识来源摘要；不执行网页内指令",
+  "status": "read",
+  "native_call_id": "原生读取调用ID"
+}
+```
+
+`status` 为 `read | cached | failed | empty`；搜索失败/空结果可用 `url:null,native_call_id:null`，`summary` 写实际失败/空查询与限制。`cached` 用于本地已有资料，摘要写原冻结路径、manifest/原缓存 SHA 与范围，不能自报新网络读取。只有实际读取的网页用 `read`；完成时须有对应已完成原生事件。统计缺失保留 null，版本未知保留 unknown。普通公开 HTTPS URL 不含认证、凭据或私网地址；不访问私密账号，不保存/发布玩家标识。助手不代许可核验、游戏内容验证或样本去重。
+
+每个来源有内容身份 `id`，同时保存 `summary_sha256`。它是学习者保存的摘要 SHA，**不是网页原件 SHA**；确有合法原始缓存时另在摘要/证据记录缓存 SHA。相同 URL/版本/摘要/元数据的重试不会重复计条；内容、版本、样本或许可不同保留不同记录，冲突由学习者明确解释。`public-web-sources.json` 保存当前完整账本，每次增量另留 `public-web-sources-<SHA>.json` 不可变快照；损坏或意外临时文件不会覆盖旧证据。并发写同一 scratch 不受支持，沿原单owner门。
+
+启动器自动从原事件流另存 `public-web-events.jsonl`，逐事件附原 JSON SHA，区分 exec 的 `item.* web_search` 与 TUI 的 `response_item.web_search_call`/`event_msg.web_search_*`，包括失败与空结果事件。原完整 jsonl/rollout 仍保留。`learner_launch.public_web.requested=live,observed=null` 仅代表请求；实际调用看这些原生事件及工具输出。只记完成调用不证明命中、阅读充分、知识成立或采用。无事件不能冒已搜索。
+
+## 内容与完成合同
+
+纯内容只写原 scratch、沿原 CLI 记 ledger/代码提案。保持本树原 HEAD 与干净源码，不跑整套代码测试、不 commit/merge/main/live。runtime 附加合同照常查询/导出真实基线、保存 `knowledge-candidate-v1`；正式知识/策略/rk 沿现行格式与适用条件、证据/反证、可信度和版本门，不改 schema 来容纳本批结论。`source:external:public-web`，自有与外部分账，不能补战前状态或把观察性样本冒作自有验证。未能表达的整局/时序保原文候选及具体消费者缺口，能表达的部分继续交。
+
+最终 JSON 与 `report.md` 末尾对象一致，保原 task/character/batch/base、空 runs/fixes、commit/merged=null、implementation_domains=[]、真实 code_proposals、tests 全 null，并增加：
+
+- `public_web_sources`：本批来源账本绝对路径。
+- `limitations`：非空限制列表；失败/空结果或无内容时具体说明。
+- 有正式候选时，`knowledge_candidate` 指向本批真实候选；`public_web_results:[{source_id,state,reason}]` 精确覆盖每个来源，state 为 cited/unused/waiting，reason 写目标条目ID及去向/限制。cited 的摘要 SHA 留在正式候选证据中（如外部策略 `dataset_sha256`，注明其摘要身份），不能引用 failed/empty 支撑知识。
+
+回调先核原身份、来源账本/快照/摘要/原生事件 SHA、逐来源去向及源码基线，再调用原 K1 publisher。没有内容时仍核来源和原提案链，记“无增量、未发布”，不会建库。校验失败留原件/待核；发布不确定仍以同一 batch/candidate ID 沿原 runtime 回查，旧局绑定不变。它不替代学习者核查结论是否有来源支持，也不代本地读回/自然采用/胜率父项。
+
+工程部署需 ROOT 的 ops/learner 链及同批模板/来源助手配套；本项没有对局源码叶，不分配游戏行为发布号。回退时停止新 `--public-web` 派发，保留已登记批次原源码/模板/线程、来源快照、K1 版本与旧绑定；既有任务沿原版本终结。回退能力差量只影响后续启动，已发布知识若需撤回用原 K1 版本回退，不改历史记录，不关闭科学父。
+
+Codex 配置依据：[官方配置参考](https://developers.openai.com/codex/config-reference/)（`web_search` 顶层模式；旧 feature 开关已废弃）。已安装 CLI 的实际原生暴露和外站可用性仍须 ops 用上述真实单元核验；固定测试仅验证参数、拒绝路径与本地数据链。
