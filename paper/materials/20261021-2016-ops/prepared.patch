@@ -0,0 +1,116 @@
+/** PD9AYQVMLQW6 A10 F49 final T10; silent-0268. Raw frames retain byte/SHA provenance. */
+import { readFileSync } from "node:fs";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { loadConfig } from "../src/core/config.js";
+import { parseGameState } from "../src/hand/mod/schema.js";
+import { makeKnowledge } from "../src/knowledge/index.js";
+import { setMonsterDbForTests } from "../src/knowledge/monster-db.js";
+import { buildRunBrief } from "../src/memory/run-brief.js";
+import { createScreenMemory, type DecisionEnv } from "../src/memory/types.js";
+import { modelHandCard } from "../src/reflex/card-model.js";
+import { planCombatTurn } from "../src/reflex/combat-plan.js";
+import { rolloutLiveOptions } from "../src/reflex/rollout-live.js";
+import { replaySteps, solveTap, type SolverInput, type Step } from "../src/reflex/turn-solver.js";
+
+vi.mock("../src/knowledge/files.js", async (original) => ({
+  ...await original<typeof import("../src/knowledge/files.js")>(),
+  knowledgeFile: (_dir: string, name: string) => `/__fixed_survivor_wither__/${name}`,
+}));
+vi.mock("../src/knowledge/experience.js", async (original) => ({
+  ...await original<typeof import("../src/knowledge/experience.js")>(), selectLessons: () => [],
+}));
+vi.mock("../src/reflex/potion-cost.js", async (original) => ({
+  ...await original<typeof import("../src/reflex/potion-cost.js")>(), potionCosts: () => new Map(),
+}));
+
+type Raw = Record<string, any>;
+const evidence = JSON.parse(readFileSync(new URL("./silent-survivor-wither-evidence.json", import.meta.url), "utf8")) as Raw;
+const frame = (line: number): Raw => structuredClone(evidence.frames.find((row: Raw) => row.line === line).row.state);
+const knowledge = makeKnowledge({ cards: [
+  { id: "DEFEND_SILENT", type: "Skill" }, { id: "STRIKE_SILENT", type: "Attack" },
+  { id: "SURVIVOR", type: "Skill" }, { id: "WITHER", type: "Status" },
+] }, "cache");
+const oldRollout = rolloutLiveOptions.enabled;
+beforeEach(() => { setMonsterDbForTests({ monsters: {}, bosses: {}, encounters: {} }); rolloutLiveOptions.enabled = false; });
+afterEach(() => { solveTap.onSolve = null; setMonsterDbForTests(null); rolloutLiveOptions.enabled = oldRollout; });
+
+function observed(line: number) {
+  const state = parseGameState(frame(line));
+  const memory = createScreenMemory("COMBAT");
+  // Frozen replayRun output from every prior state/accepted decision of this run, including SL resets.
+  memory.fightCards = structuredClone(evidence.memory[String(line)]);
+  const env: DecisionEnv = { state, knowledge, brief: buildRunBrief(state, knowledge), thresholds: loadConfig({}).thresholds,
+    runStart: "auto", characterPreference: null, allowFtueModals: false, strictJev: true,
+    screenMemory: memory, shopDiscardPotions: [] };
+  let input: SolverInput | undefined;
+  solveTap.onSolve = (value) => { input ??= value; };
+  try { planCombatTurn(env); } finally { solveTap.onSolve = null; }
+  if (!input) throw new Error(`no fixed solver input for ${line}`);
+  const step = (id: string): Step => {
+    const card = input!.hand.find((entry) => entry.cardId === id)!;
+    return { cardIndex: card.index, cardId: card.cardId, name: card.name, upgraded: card.upgraded,
+      target: card.target === "single" ? 0 : null, targetName: null };
+  };
+  return { input, step };
+}
+
+it("accounts for the newly generated Wither, one discard, Afterimage and the later enemy attack", () => {
+  const { input, step } = observed(291337);
+  expect(input.wither).toEqual({ every: 6, played: 35, damage: 12 });
+  const plan = replaySteps(input, [step("DEFEND_SILENT"), step("STRIKE_SILENT"), step("SURVIVOR")])!;
+  expect(plan.outcome).toMatchObject({ withersAdded: 1, heldDamage: 24, blockGained: 24,
+    hpLoss: 15, hpAfter: -12, damageDealt: 12, dies: true });
+  expect(plan.outcome.diesOwnTurn).not.toBe(true);
+  expect(plan.outcome.unknownCards).toContain("弃牌选择未确定");
+  expect(plan.steps.at(-1)?.discards).toEqual([]);
+});
+
+it("matches the real choice screen and selected hand without claiming a particular Wither instance", () => {
+  const { input, step } = observed(291339);
+  const before = frame(291340), after = frame(291341);
+  expect(before.selection.cards).toHaveLength(3);
+  expect(before.selection.cards.every((card: Raw) => card.card_id === "WITHER" && card.dynamic_values[0].current_value === 12)).toBe(true);
+  expect(after.combat.hand).toHaveLength(2);
+  expect(after.combat.player.block).toBe(32);
+  const plan = replaySteps(input, [step("SURVIVOR")])!;
+  expect(plan.outcome).toMatchObject({ heldDamage: 24, blockGained: 13, hpLoss: 15, hpAfter: -12,
+    damageDealt: 6, dies: true });
+  expect(plan.outcome.enemyHpAfter[0]?.hp).toBe(frame(291342).combat.enemies[0].current_hp);
+  expect(frame(291342).run.current_hp).toBe(0);
+});
+
+it("still stops at the real selection even if a synthetic potion could follow", () => {
+  const { input, step } = observed(291339);
+  const survivor = input.hand.find((card) => card.cardId === "SURVIVOR")!;
+  const potion = { ...survivor, key: "fixed-potion", index: 99, cardId: "FIXED_POTION", type: "Potion",
+    cost: 0, block: 0, survivorDiscard: false, survivorWitherDiscard: undefined } as typeof survivor;
+  input.hand.push(potion);
+  const after: Step = { cardIndex: 99, cardId: potion.cardId, name: potion.name, upgraded: false, target: null, targetName: null };
+  expect(replaySteps(input, [step("SURVIVOR"), after])).toBeNull();
+});
+
+it.each(["other-card", "different-damage", "unknown-draw", "new-wither-damage", "no-afterimage"])("%s keeps the existing unresolved forecast", (kind) => {
+  const { input, step } = observed(291339);
+  const held = input.hand.find((card) => card.cardId === "WITHER")!;
+  if (kind === "other-card") held.cardId = "FIXED_OTHER_STATUS";
+  if (kind === "different-damage") held.heldPenalty = 9;
+  if (kind === "new-wither-damage") input.wither!.damage = 9;
+  if (kind === "no-afterimage") input.player.afterImage = 0;
+  if (kind === "unknown-draw") input.hand.find((card) => card.cardId === "SURVIVOR")!.draw = 1;
+  const plan = replaySteps(input, [step("SURVIVOR")])!;
+  expect(plan.outcome.unknownCards).toContain("弃牌选择未确定");
+  if (kind === "different-damage") expect(plan.outcome.heldDamage).toBe(33);
+  else expect(plan.outcome.heldDamage).toBe(36);
+});
+
+it("keeps other roles, ascensions, upgrades and other discard cards outside the new scope", () => {
+  const raw = frame(291339).combat.hand.find((card: Raw) => card.card_id === "SURVIVOR");
+  expect(modelHandCard(raw, 0, knowledge, "silent", 10).survivorWitherDiscard).toBe(true);
+  for (const [character, ascension] of [["ironclad", 10], ["regent", 10], ["silent", 6], ["silent", 9], ["silent", null]] as const) {
+    expect(modelHandCard(raw, 0, knowledge, character, ascension).survivorWitherDiscard).toBeUndefined();
+  }
