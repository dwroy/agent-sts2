+    const events: BrainWaitEvent[] = [];
+    const wait = new BrainWait({ signal: abort.signal, now: () => now, sleep: async (ms) => { now += ms; abort.abort(); }, notify: (e) => events.push(e) });
+    const engine = vi.fn();
