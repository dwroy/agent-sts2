+def pending_experience_integration(root, character):
+    """Read Roy's approved integration independently of the ops TUI event queue."""
+    if character != "silent":
+        return None
+    project = Path(root).resolve()
+    path = project / "notes/experience-integration-silent.json"
+    try:
+        if not path.resolve().is_relative_to(project):
+            return None
+        raw = path.read_bytes()
+        request = json.loads(raw)
+        expected = {"request_id": "roy-20261010-silent-core-reuse-experience-integration",
+                    "authorized_by": "Roy", "character": character, "task": "experience-update",
+                    "state": "pending", "batch": None}
+        if not isinstance(request, dict) or any(request.get(k) != v for k, v in expected.items()):
+            return None
+        runs = request.get("dispatch_runs")
+        if (not isinstance(runs, list) or not 1 <= len(runs) <= 10
+                or any(not isinstance(run, str) or not RUN_ID.fullmatch(run) for run in runs)
+                or len(set(runs)) != len(runs)):
+            return None
+
+        def frozen(relative, digest):
+            if (not isinstance(relative, str) or not relative.startswith("paper/materials/")
+                    or not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest)):
+                raise ValueError("invalid integration artifact")
+            artifact = (project / relative).resolve()
+            if not artifact.is_relative_to(project / "paper/materials"):
+                raise ValueError("integration artifact outside materials")
+            content = artifact.read_bytes()
+            if hashlib.sha256(content).hexdigest() != digest:
+                raise ValueError("integration artifact changed")
+            return content
+
+        frozen(request.get("work_spec"), request.get("work_spec_sha256"))
+        report, source = request.get("source_report"), request.get("source_input")
+        if not isinstance(report, dict) or not isinstance(source, dict):
+            return None
+        frozen(report.get("path"), report.get("sha256"))
+        manifest = json.loads(frozen(source.get("path"), source.get("sha256")))
+        if not isinstance(manifest, dict) or manifest.get("character") != character:
+            return None
+        inventory = manifest.get("runs")
+        if not isinstance(inventory, list):
+            return None
+        ended = {row.get("run_id") for row in inventory if isinstance(row, dict) and row.get("ended")}
+        if not set(runs).issubset(ended):
+            return None
+        return {**request, "request_sha256": hashlib.sha256(raw).hexdigest()}
+    except (OSError, ValueError, TypeError):
+        return None
+
+
+def integration_job(state, root, scripts, character, alive, stamp):
+    """Use the existing writer slot, deduplication, backoff and completion channel."""
+    request = pending_experience_integration(root, character)
+    if request is None:
+        return None
+    # Older manually launched batches used the comma-separated case anchors as key.
+    # Keep that identity so a completed batch or three failed attempts cannot repeat.
+    runs = request["dispatch_runs"]
+    previous = [batch for batch in state["batches"].values()
+                if batch.get("task") == "experience-update" and batch.get("character") == character
+                and (batch.get("experience_integration", {}).get("request_id") == request["request_id"]
+                     or set(batch.get("runs", [])) == set(runs))]
+    if (any(batch.get("state") == "done" for batch in previous) or len(previous) >= 3
+            or any(batch.get("retry_at", 0) > time.time() for batch in previous)):
+        return None
+    result = dispatch_write(state, root, scripts, "experience-update", character, runs,
+                            ",".join(runs), "tick", alive, stamp)
+    if result:
+        state["batches"][result[0]]["experience_integration"] = {
+            "request_id": request["request_id"], "scope_revision": request.get("scope_revision"),
+            "request_sha256": request["request_sha256"], "work_spec": request["work_spec"],
+            "work_spec_sha256": request["work_spec_sha256"], "source_batch": request.get("source_batch")}
+    return result
+
