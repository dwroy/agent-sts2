+import { spawnSync } from "node:child_process";
+import { expect, it } from "vitest";
+
+it("prioritizes authorized report integration while preserving active work and retry history", () => {
+  const result = spawnSync("nice", ["-n", "19", "python3", "-B", "../ops/tests/test_experience_integration_dispatch.py"], {
+    encoding: "utf8", timeout: 30_000,
+  });
+  expect(result.status, result.stderr).toBe(0);
+  expect(result.stderr).toMatch(/Ran [1-9]\d* tests/);
+});
