@@ -0,0 +1,144 @@
+"""Fixed fixtures for report integration priority; no host processes or model calls."""
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+REPO = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location("integration_jobs", REPO / "ops/learner_jobs.py")
+jobs = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(jobs)
+RUNS = ["SILENT000001", "SILENT000002"]
+ORDINARY = ["SILENT000003"]
+IDENT = "roy-20261010-silent-core-reuse-experience-integration"
+
+
+class IntegrationDispatch(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        (self.root / "notes").mkdir()
+        (self.root / "paper/materials").mkdir(parents=True)
+        manifest = {"character": "silent", "runs": [{"run_id": r, "ended": "2026-01-01"} for r in RUNS]}
+        def artifact(name, content):
+            relative = "paper/materials/" + name
+            raw = content.encode()
+            (self.root / relative).write_bytes(raw)
+            return {"path": relative, "sha256": hashlib.sha256(raw).hexdigest()}
+        task = artifact("task.md", "Fixed authorized task")
+        self.request = {"request_id": IDENT, "authorized_by": "Roy", "task": "experience-update",
+                        "character": "silent", "state": "pending", "batch": None, "scope_revision": 3,
+                        "dispatch_runs": RUNS, "work_spec": task["path"], "work_spec_sha256": task["sha256"],
+                        "source_report": artifact("report.md", "Fixed report"),
+                        "source_input": artifact("input.json", json.dumps(manifest))}
+        self.path = self.root / "notes/experience-integration-silent.json"
+        self.save()
+        self.state = {"batches": {}}
+        self.launched = []
+
+    def save(self):
+        self.path.write_text(json.dumps(self.request))
+
+    def check(self, stamp="20260101-000001", available=True, character="silent"):
+        def launch(*args):
+            self.launched.append(args[0])
+            return 101, "wJ:pTEST"
+        with patch.object(jobs, "pending", return_value=ORDINARY), \
+                patch.object(jobs, "available", return_value=available), \
+                patch.object(jobs, "start_learner", side_effect=launch), \
+                patch.object(jobs, "fix_key", return_value=None), \
+                patch.object(jobs, "strategy_job", return_value=None), \
+                patch.object(jobs, "calibration_job", return_value=None), \
+                patch("strategy_research_jobs.dispatch", return_value=None), \
+                patch("boss_sim_jobs.check", return_value=None):
+            return jobs.check_jobs(self.state, str(self.root), str(REPO / "ops"), character, lambda pid: True, stamp)
+
+    def test_authorized_request_precedes_new_postmortems_and_keeps_identity(self):
+        before = self.path.read_bytes()
+        result = self.check()
+        batch = self.state["batches"][result["experience"][0]]
+        self.assertEqual(batch["runs"], RUNS)
+        self.assertEqual(batch["pane"], "wJ:pTEST")
+        self.assertEqual(batch["experience_integration"]["request_sha256"], hashlib.sha256(before).hexdigest())
+        self.assertEqual(batch["experience_integration"]["scope_revision"], 3)
+        self.assertEqual(self.path.read_bytes(), before)
+        self.check("20260101-000002")
+        self.assertEqual(len(self.launched), 1)
+
+    def test_active_ordinary_writer_is_preserved_then_request_gets_next_slot(self):
+        original = {"task": "experience-update", "character": "silent", "state": "running",
+                    "pid": 99, "runs": ORDINARY, "key": ",".join(ORDINARY)}
+        self.state["batches"]["ordinary"] = copy.deepcopy(original)
+        self.assertIsNone(self.check()["experience"])
+        self.assertEqual(self.state["batches"]["ordinary"], original)
+        self.state["batches"]["ordinary"]["state"] = "done"
+        result = self.check("20260101-000002")
+        self.assertEqual(self.state["batches"][result["experience"][0]]["runs"], RUNS)
+
+    def test_dirty_or_externally_owned_tree_does_not_launch(self):
+        self.assertIsNone(self.check(available=False)["experience"])
+        self.assertFalse(self.launched)
+
+    def test_completed_integration_is_not_repeated_after_anchor_reordering(self):
+        result = self.check()
+        self.state["batches"][result["experience"][0]]["state"] = "done"
+        self.request["dispatch_runs"] = list(reversed(RUNS))
+        self.save()
+        second = self.check("20260101-000002")
+        self.assertEqual(self.state["batches"][second["experience"][0]]["runs"], ORDINARY)
+
+    def test_old_manual_failure_backoff_and_three_attempt_limit_are_kept(self):
+        prior = {"task": "experience-update", "character": "silent", "state": "failed",
+                 "runs": list(reversed(RUNS)), "key": ",".join(reversed(RUNS)),
+                 "rc": 3, "retry_at": time.time() + 3600}
+        self.state["batches"]["old"] = copy.deepcopy(prior)
+        result = self.check()
+        self.assertEqual(self.state["batches"][result["experience"][0]]["runs"], ORDINARY)
+        self.assertEqual(self.state["batches"]["old"], prior)
+        self.state = {"batches": {str(i): {**prior, "retry_at": 0} for i in range(3)}}
+        result = self.check("20260101-000002")
+        self.assertEqual(self.state["batches"][result["experience"][0]]["runs"], ORDINARY)
+
+    def test_elapsed_backoff_reuses_standard_retry_without_rewriting_failure(self):
+        prior = {"task": "experience-update", "character": "silent", "state": "failed",
+                 "runs": RUNS, "key": ",".join(RUNS), "rc": 3, "retry_at": 0}
+        self.state["batches"]["old"] = copy.deepcopy(prior)
+        result = self.check()
+        self.assertEqual(self.state["batches"][result["experience"][0]]["runs"], RUNS)
+        self.assertEqual(self.state["batches"]["old"], prior)
+
+    def test_invalid_identity_scope_and_artifacts_fall_back_to_ordinary(self):
+        original = copy.deepcopy(self.request)
+        for changes in ({"authorized_by": "other"}, {"request_id": "other"}, {"state": "done"},
+                        {"batch": "existing"}, {"character": "ironclad"}, {"dispatch_runs": []},
+                        {"dispatch_runs": RUNS + RUNS}, {"dispatch_runs": ["SILENT000099"]},
+                        {"work_spec_sha256": "0" * 64}, {"work_spec": "../outside.md"},
+                        {"source_report": {}}, {"task": "fix-batch"}):
+            with self.subTest(changes=changes):
+                self.request = {**original, **changes}
+                self.save()
+                self.state = {"batches": {}}
+                result = self.check()
+                self.assertEqual(self.state["batches"][result["experience"][0]]["runs"], ORDINARY)
+        self.request = original
+        self.save()
+        (self.root / "paper/materials/report.md").write_text("Changed report")
+        self.assertIsNone(jobs.pending_experience_integration(str(self.root), "silent"))
+
+    def test_ironclad_and_missing_request_keep_ordinary_behavior(self):
+        result = self.check(character="ironclad")
+        self.assertEqual(self.state["batches"][result["experience"][0]]["runs"], ORDINARY)
+        self.path.unlink()
+        self.state = {"batches": {}}
+        result = self.check()
+        self.assertEqual(self.state["batches"][result["experience"][0]]["runs"], ORDINARY)
+
+
+if __name__ == "__main__":
+    unittest.main()
