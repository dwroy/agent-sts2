diff --git a/agent/tests/silent-apotheosis-predator.test.ts b/agent/tests/silent-apotheosis-predator.test.ts
new file mode 100644
index 000000000..a46c2c4c3
--- /dev/null
+++ b/agent/tests/silent-apotheosis-predator.test.ts
@@ -0,0 +1,130 @@
+import { resolve } from "node:path";
+import { expect, it, vi } from "vitest";
+import evidence from "./silent-apotheosis-predator-evidence.json";
+import { makeKnowledge } from "../src/knowledge/index.js";
+import { applyApotheosisUpgrade, modelHandCard, type CardModel } from "../src/reflex/card-model.js";
+import { replaySteps } from "../src/reflex/turn-solver.js";
+import { simulateFight, type RolloutInput } from "../src/reflex/rollout.js";
+import { parseGameState } from "../src/hand/mod/schema.js";
+import { boardRolloutInput } from "../src/reflex/rollout-live.js";
+import { board, card } from "./boss-sim-fixture.js";
+
+vi.mock("node:fs", async (original) => {
+  const fs = await original<typeof import("node:fs")>();
+  const { KNOWLEDGE_DIR } = await import("../src/knowledge/files.js");
+  const readFileSync = ((path: Parameters<typeof fs.readFileSync>[0], ...args: unknown[]) => {
+    if (typeof path === "string" && resolve(path).startsWith(resolve(KNOWLEDGE_DIR) + "/")) {
+      throw Object.assign(new Error("ENOENT: fixed Predator evidence"), { code: "ENOENT" });
+    }
+    return (fs.readFileSync as (...args: unknown[]) => unknown)(path, ...args);
+  }) as typeof fs.readFileSync;
+  return { ...fs, readFileSync, default: { ...fs, readFileSync } };
+});
+
+const knowledge = makeKnowledge({ cards: [{ id: "PREDATOR", type: "Attack" }, { id: "APOTHEOSIS", type: "Skill" }] }, "cache");
+const rawPlain = { ...evidence.plain, index: 1, playable: true, target_type: "AnyEnemy", valid_target_indices: [0] };
+const plain = () => modelHandCard(rawPlain, 1, knowledge, "silent", 10);
+const god = () => modelHandCard(evidence.apotheosis, 0, knowledge, "silent", 10);
+const step = (entry: CardModel) => ({ cardIndex: entry.index, cardId: entry.cardId, name: entry.name, upgraded: entry.upgraded,
+  ...(entry.target === "single" ? { target: 0 } : {}) });
+
+it("upgrades the recorded printed damage without drawing on the current turn", () => {
+  const original = plain();
+  const saved = JSON.stringify(original);
+  const upgraded = applyApotheosisUpgrade(original);
+  expect(upgraded).toMatchObject({ upgraded: true, known: true, damage: 20, cost: 2, draw: 0 });
+  expect(applyApotheosisUpgrade(upgraded)).toEqual(upgraded);
+  const input = board({ bossHp: 1000 }).solver;
+  input.player.energy = 4;
+  input.enemies[0]!.attacks = [];
+  input.hand = [god(), original];
+  const plan = replaySteps(input, input.hand.map(step))!;
+  expect(plan.outcome).toMatchObject({ apotheosisApplied: true, damageDealt: 20, cardsDrawn: 0, energyLeft: 0 });
+  expect(plan.outcome.unknownCards).not.toContain("猎杀者（神化升级未验证）");
+  expect(JSON.stringify(original)).toBe(saved);
+});
+
+function drawBoard(): RolloutInput {
+  const input = board({ bossHp: 1000 });
+  input.solver.player.energy = 4;
+  input.solver.enemies[0]!.attacks = [];
+  input.solver.hand = [god(), plain()];
+  input.piles = { handBase: input.solver.hand, draw: Array.from({ length: 30 }, (_, i) =>
+    card(100 + i, "FIXED_ATTACK", { cost: 0, damage: 1, upgraded: true })), discard: [] };
+  input.tables = { TEST_BOSS: { moves: { WAIT: { damage: 0, hits: 1, strength: 0, block: 0 } }, next: { WAIT: { WAIT: 1 } } } };
+  input.enemies[0]!.move = "WAIT";
+  return input;
+}
+
+it("carries the two observed extra draws to exactly the following turn", () => {
+  const input = drawBoard();
+  const saved = JSON.stringify(input);
+  const plan = replaySteps(input.solver, input.solver.hand.map(step))!;
+  const records = simulateFight(input, plan, 3, 1, false).records;
+  expect(records).toHaveLength(3);
+  expect(records.map((r) => r.dmg)).toEqual([20, 7, 5]);
+  expect(records[0]!.snap.pw["DRAW_CARDS_NEXT_TURN_POWER"]).toBe(2);
+  expect(records[1]!.snap.pw["DRAW_CARDS_NEXT_TURN_POWER"]).toBeUndefined();
+  expect(records[2]!.snap.pw["DRAW_CARDS_NEXT_TURN_POWER"]).toBeUndefined();
+  expect(JSON.stringify(input)).toBe(saved);
+});
+
+it("preserves other roles and levels and refuses unobserved upgrade modifiers", () => {
+  for (const [character, ascension] of [["ironclad", 10], ["silent", 9], ["silent", 11]] as const) {
+    const model = modelHandCard(rawPlain, 1, knowledge, character, ascension);
+    expect(model.apotheosisUpgrade).toBeUndefined();
+    expect(model.predatorDrawNext).toBeUndefined();
+  }
+  for (const raw of [
+    { ...rawPlain, energy_cost: 0 },
+    { ...rawPlain, enchantment: { id: "UNOBSERVED" } },
+    { ...rawPlain, resolved_rules_text: rawPlain.resolved_rules_text + " 重放。" },
+    { ...rawPlain, rules_text: "造成{Damage:diff()}点伤害。 在下个回合抽3张牌。" },
+  ]) {
+    const model = modelHandCard(raw, 1, knowledge, "silent", 10);
+    expect(model.apotheosisUpgrade).toBeUndefined();
+    expect(model.predatorDrawNext).toBeUndefined();
+  }
+});
+
+
+it("matches the recorded upgraded cast and its pending two-card power", () => {
+  const raw = evidence.upgraded;
+  const model = modelHandCard(raw, raw.index, knowledge, "silent", 10);
+  expect(model).toMatchObject({ damage: 21, cost: 2, draw: 0, predatorDrawNext: 2 });
+  expect(evidence.cast_before.player.energy - evidence.cast_after.player.energy).toBe(2);
+  expect(evidence.cast_before.enemies[0]!.current_hp - evidence.cast_after.enemies[0]!.current_hp).toBe(21);
+  expect(evidence.cast_after.player.powers.find((p) => p.power_id === "DRAW_CARDS_NEXT_TURN_POWER")?.amount).toBe(2);
+  expect(modelHandCard(evidence.plain_cast, 0, knowledge, "silent", 10)).toMatchObject({ damage: 17, draw: 0, predatorDrawNext: 2 });
+});
+
+it("reads a native pending power only for the observed role and level", () => {
+  for (const [character, ascension, expected] of [["silent", 10, 7], ["ironclad", 10, 5], ["silent", 9, 5]] as const) {
+    const input = drawBoard();
+    input.solver.hand = [card(0, "FIXED_WAIT", { type: "Skill", target: "self", damage: null, cost: 0 })];
+    input.piles.handBase = input.solver.hand;
+    const raw = { state_version: 16, screen: "COMBAT", in_combat: true, turn: 1,
+      session: { mode: "singleplayer", phase: "run" },
+      available_actions: ["play_card", "end_turn"],
+      run: { character_id: character.toUpperCase(), ascension, floor: 36, act_id: "1", deck: [], relics: [], potions: [] },
+      combat: { player: evidence.cast_after.player, enemies: [] } };
+    const context = boardRolloutInput(parseGameState(raw), knowledge, input.solver, ascension, {}, {});
+    input.observedSilentPredator = context.observedSilentPredator;
+    input.playerPowers = context.playerPowers;
+    const plan = replaySteps(input.solver, [])!;
+    const records = simulateFight(input, plan, 3, 1, false).records;
+    expect(records.map((r) => r.dmg)).toEqual([0, expected, 5]);
+  }
+});
+
+
+it("upgrades a later pile draw before that cast schedules its following-turn draw", () => {
+  const input = drawBoard();
+  input.solver.hand = [god()];
+  input.piles.handBase = input.solver.hand;
+  input.piles.draw.unshift(plain());
+  input.piles.drawTop = [0];
+  const plan = replaySteps(input.solver, [step(input.solver.hand[0]!)])!;
+  const records = simulateFight(input, plan, 4, 1, false).records;
+  expect(records.map((r) => r.dmg)).toEqual([0, 24, 7, 5]);
+});
