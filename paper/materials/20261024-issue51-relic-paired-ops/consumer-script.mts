import {readFileSync,writeFileSync} from 'node:fs';
import {pathToFileURL} from 'node:url';
import {join,resolve} from 'node:path';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const [contentArg,consumerArg,output,assemblyPath]=process.argv.slice(2);
const content=resolve(contentArg),consumer=resolve(consumerArg),A=JSON.parse(readFileSync(assemblyPath,'utf8'));
const load=(p:string)=>import(pathToFileURL(join(consumer,p)).href),read=(p:string)=>JSON.parse(readFileSync(p,'utf8'));
const {parseStrategyLibrary}=await load('agent/src/knowledge/strategy-entries.ts');
const {setKnowledgeCharacter}=await load('agent/src/knowledge/files.ts');
const {loadV6Knowledge}=await load('agent/src/v6/knowledge.ts');
const {evaluatePredicate}=await load('agent/src/v6/predicate.ts');
const {combatPredicateFacts}=await load('agent/src/reflex/jev/predicate-context.ts');
const {parseGameState}=await load('agent/src/hand/mod/schema.ts');
const {buildKnowledgeTools}=await load('agent/src/brain/tools/agent-knowledge.ts');
const {ToolHost}=await load('agent/src/brain/tools/mcp-server.ts');
const knowledgeDir=join(content,'knowledge'),library=parseStrategyLibrary(read(join(knowledgeDir,'characters/silent/strategy-entries.json'))),loaded=loadV6Knowledge(knowledgeDir,'silent');
assert.equal(loaded.reflex.status,'loaded');assert.equal(loaded.vocab.status,'loaded');assert.equal(loaded.reflex.value.length,A.snapshots.live.after_reflex_count);
const sourceStrategy=read(resolve(A.source_files.strategy.path)),sourceRk=read(resolve(A.source_files.rk.path));
const before=read(resolve(assemblyPath,'../preimages/live/knowledge/characters/silent/reflex.json'));
assert.deepEqual(loaded.reflex.value.filter((e:any)=>before.entries.some((o:any)=>o.id===e.id)),before.entries);
const beforeStrategy=read(resolve(assemblyPath,'../preimages/live/knowledge/characters/silent/strategy-entries.json'));
for(const old of beforeStrategy.entries)assert.deepEqual(library.entries.find((e:any)=>e.id===old.id),old);
const beforeVocab=read(resolve(assemblyPath,'../preimages/live/knowledge/characters/silent/reflex-vocab.json'));
for(const [dim,old] of Object.entries(beforeVocab.dimensions) as any)assert.deepEqual(loaded.vocab.value.dimensions[dim].slice(0,old.length),old);
setKnowledgeCharacter('silent');const rows=[];
for(const pair of A.selected_pairs){
 const bytes=readFileSync(pair.original_case.state.path);assert.equal(createHash('sha256').update(bytes).digest('hex'),pair.original_case.state.sha256);
 const original=JSON.parse(bytes.toString()).state,state=parseGameState(original),payload={facts:{act:Number(state.run.act_id)+1,floor:state.run.floor,act_boss:original.run.boss_id}};
 const ctx={ascension:10,knowledgeDir,logsDir:'/unused',label:'shop/plan',payload,state};
 const host=new ToolHost(buildKnowledgeTools(ctx),ctx),text=await host.call('kb_strategies',{query:pair.strategy_id});assert(!text.isError,text.text);
 const strategy=JSON.parse(text.text).entries.find((e:any)=>e.id===pair.strategy_id);assert(strategy,pair.strategy_id);const wanted=sourceStrategy.entries.find((e:any)=>e.id===pair.strategy_id);
 for(const key of ['id','version','trigger','strategy','evidence','source','confidence','evidence_status'])assert.deepEqual(strategy[key],wanted[key],key);
 assert.equal(strategy.source,'own');
 const result=await host.call('kb_reflex',{query:pair.rk_id,applies_to:'shop'});assert(!result.isError,result.text);
 const body=JSON.parse(result.text);assert.equal(body.representation,'construction_summary');assert.equal(body.predicate_evaluation,'not_evaluated');assert.equal(body.entries.length,1);assert.equal(body.entries[0].id,pair.rk_id);
 const fullCtx={...ctx,label:'fight-plan'},full=await new ToolHost(buildKnowledgeTools(fullCtx),fullCtx).call('kb_reflex',{query:pair.rk_id,applies_to:'shop'});assert(!full.isError,full.text);
 const fullBody=JSON.parse(full.text),expected=sourceRk.entries.find((e:any)=>e.id===pair.rk_id);assert.equal(fullBody.entries.length,1);assert.deepEqual(fullBody.entries[0],expected);assert.equal(expected.signal.kind,'tag');
 const facts=combatPredicateFacts(state),observed=evaluatePredicate(expected.predicate,facts.context);
 const wrong={...ctx,ascension:11},no=await new ToolHost(buildKnowledgeTools(wrong),wrong).call('kb_reflex',{query:pair.rk_id,applies_to:'shop'});assert(!no.isError);assert.equal(JSON.parse(no.text).entries.length,0);
 rows.push({strategy_id:pair.strategy_id,strategy,rk_id:pair.rk_id,rk:fullBody.entries[0],construction_summary:body.entries[0],original_mod_state:pair.original_case.state,current_coarse_predicate_result:observed,dynamic_budget_and_removal_eligibility_not_proved:true,actual_fixed_production_tools:true,executable_comparison:false});
}
for(const character of ['ironclad','regent']){setKnowledgeCharacter(character);const ctx={ascension:10,knowledgeDir,logsDir:'/unused',label:'shop/plan',payload:{},state:{}};const host=new ToolHost(buildKnowledgeTools(ctx),ctx);for(const name of ['kb_strategies','kb_reflex']){const r=await host.call(name,{query:A.selected_strategy_ids[0]});if(name==='kb_reflex'){assert.equal(host.has(name),false);assert.equal(r.isError,true);}else{assert(!r.isError,r.text);assert.equal(JSON.parse(r.text).entries.length,0);}}}setKnowledgeCharacter('silent');
const textRows=[];
for(const item of A.text_only_contexts){
 const bytes=readFileSync(item.original_case.state.path);assert.equal(createHash('sha256').update(bytes).digest('hex'),item.original_case.state.sha256);
 const state=parseGameState(JSON.parse(bytes.toString()).state),ctx={ascension:10,knowledgeDir,logsDir:'/unused',label:item.label,payload:{},state};
 const result=await new ToolHost(buildKnowledgeTools(ctx),ctx).call('kb_strategies',{query:item.strategy_id});assert(!result.isError,result.text);
 const entry=JSON.parse(result.text).entries.find((e:any)=>e.id===item.strategy_id);assert(entry,item.strategy_id);
 const expected=sourceStrategy.entries.find((e:any)=>e.id===item.strategy_id);for(const key of ['id','version','trigger','strategy','evidence','source','confidence','evidence_status'])assert.deepEqual(entry[key],expected[key]);
 assert(!loaded.reflex.value.some((e:any)=>e.id==='silent-rk-relic-exchange-current-sacrifice'));
 textRows.push({strategy_id:item.strategy_id,strategy:entry,rk_waiting:true,actual_fixed_production_tool:true,original_mod_state:item.original_case.state});
}
writeFileSync(output,JSON.stringify({passed:true,content_root:content,consumer_root:consumer,strategy_count:library.entries.length,reflex_count:loaded.reflex.value.length,fixed_strategy_queries:rows.length+textRows.length,fixed_rk_construction_queries:rows.length,fixed_rk_full_queries:rows.length,current_coarse_predicate_true:rows.filter(r=>r.current_coarse_predicate_result===true).length,current_coarse_predicate_unknown:rows.filter(r=>r.current_coarse_predicate_result===null).length,wrong_ascension_cases:rows.length,other_role_cases:4,custom_knowledge_candidates_formal_consumer:'pending',new_executable_shop_comparisons:0,new_executable_card_pick_advice:0,natural_queries:0,model_or_jev_calls:0,rows,text_only_rows:textRows},null,2)+'\n');
console.log(JSON.stringify({passed:true,strategy:library.entries.length,rk:loaded.reflex.value.length,shop_construction_queries:rows.length,current_coarse_predicate_true:rows.filter(r=>r.current_coarse_predicate_result===true).length}));
