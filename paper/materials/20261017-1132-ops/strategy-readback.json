    "proposal_results": [
      {
        "id": "silent-proposal-89354805ee4d7e77",
        "state": "waiting",
        "reason": "缺实际施放在抽牌、选牌、用药、重问、SL及换战间的持续身份与生产读回；虚弱/脆弱/缩小/暗影等升级交互仍明确未知。现有配对转换和候选字段仅覆盖窄项，不能关闭整项。"
      },
      {
        "id": "silent-proposal-f2bfceddb1898dca",
        "state": "waiting",
        "reason": "缺完整模型下同起点、同随机池、同总预算的分阶段MC配对及样本成熟曲线，亦缺留药与另一focus完整后继。已发布H1工程截止不等于本提案药水分配、药价或击杀顺序的实盘验证。"
      },
      {
        "id": "silent-proposal-283a164780d11e69",
        "state": "waiting",
        "reason": "同源神化项仍缺跨中断的实际施放持续身份及未覆盖升级交互校准；只核窄源码祖先不足以将整个经验来源请求登记duplicate。"
      },
      {
        "id": "silent-proposal-ebbfe3b97548756d",
        "state": "waiting",
        "reason": "缺十五子项逐来源的全部属性/升级组合、状态期限及战斗—路线—休息消费者联合校准；本批端点未隔离出新的确定数值失配，不凭已有局部实现关闭复合项。"
      },
      {
        "id": "silent-proposal-e5b87be50f28f311",
        "state": "waiting",
        "reason": "已有三阶段预测、单动作回执和离线端点，但缺跨抽牌、选牌、用药、重问、SL的完整候选持续归属及本局全过程生产校准；113片段不能认证成长收益或整战改线因果。"
      },
      {
        "id": "silent-proposal-49632bc4878fb597",
        "state": "waiting",
        "reason": "缺同一冻结生产调用中逐击力量、正负敏捷、虚弱与蚌独立成长四路径联合校准；该局无正敏捷实测，不能凭局部步法或成长代码关闭整条复合经验。"
      },
      {
        "id": "silent-proposal-66532328a585941f",
        "state": "waiting",
        "reason": "缺同HP、牌组、药水、完整抽序下不同启动顺序的受控整战对照及可复现收益函数；无毒冒泡的局部端点不能确定启动阈值或构筑权重。"
      },
      {
        "id": "silent-proposal-43a76a31ba7bdcfa",
        "state": "waiting",
        "reason": "缺同起始HP/构筑/抽序下的完整生产整战配对与另一可核SL线路；负敏捷和毒端点只支持分项事实，不支持修改SL范围或阈值。"
      },
      {
        "id": "silent-proposal-5264153a4a4b0e5c",
        "state": "waiting",
        "reason": "缺A10召唤、航行、复现、退场全链的冻结生产校准及另一focus完整后继；既有召唤源码与T4净扣不能证明目标排序的整战收益。"
      },
      {
        "id": "silent-proposal-bddfa690a84e03d0",
