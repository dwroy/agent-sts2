{
  "repo": "dwroy/agent-sts2",
  "mode": "shadow",
  "custody": {
    "enabled": false,
    "schema": "sts2-k-custody-v1",
    "handshake_seconds": 10
  },
  "main_ref": "refs/heads/main",
  "state": "ops/codex-ops/merge-queue",
  "max_batch": 3,
  "seal_seconds": 120,
  "max_diagnostics": 3,
  "max_attempts": 1,
  "review_owner": "integrator",
  "heavy_config": ".agents/board.yaml",
  "workspace_policy": ".agents/queue-workspace.json",
  "workspace_adapter": "ops/codex-ops/agent-board-kit/queue_workspace.py",
  "check": [
    "python3",
    "{root}/ops/board_queue_checks.py"
  ],
  "required_checks": [
    "root-tsc",
    "runtime-tsc",
    "live-tsc",
    "host",
    "consumers",
    "full"
  ],
  "policy_files": [
    ".agents/board-kit-pin.json",
    ".agents/board.yaml",
    ".agents/queue-checks.json",
    ".agents/queue-workspace.json",
    "ops/board_queue_pin.py",
    "ops/board_queue_checks.py",
    "ops/board_queue_custody.py",
    "ops/board_queue_control.py",
    "ops/board_queue_strict.py",
    "ops/board_refresh_queue.py",
    "ops/board_download.py",
    "ops/report.py",
    "ops/refresh-costs.py",
    "ops/global_build_funnel.py",
    "knowledge/builders/refresh_driver.py",
    "eval/spire_codex.py",
    "eval/spire_codex_download.py",
    "ops/board_queue_finalize.mjs",
    "ops/board_queue_admission.py",
    "ops/board_heavy.py",
    "ops/board_resources.py",
    "ops/disk_capacity.py",
    "ops/shared_tools.py",
    "ops/worktree_checkout.py",
    "ops/learner_retention.py",
    "ops/issue_session_support.py",
    "ops/publication_gate.py",
    "ops/board_queue_leases.mjs",
    "ops/board_queue_records.py",
    "ops/codex-ops/agent-board-kit/MACHINE-PROTOCOL.md",
    "ops/codex-ops/agent-board-kit/README.md",
    "ops/codex-ops/agent-board-kit/board.py",
    "ops/codex-ops/agent-board-kit/conversation.py",
    "ops/codex-ops/agent-board-kit/docs/gitlink-compatibility.md",
    "ops/codex-ops/agent-board-kit/docs/merge-queue.md",
    "ops/codex-ops/agent-board-kit/heavy.py",
    "ops/codex-ops/agent-board-kit/machine.py",
    "ops/codex-ops/agent-board-kit/merge_queue.py",
    "ops/codex-ops/agent-board-kit/polling.py",
    "ops/codex-ops/agent-board-kit/queue_checks.py",
    "ops/codex-ops/agent-board-kit/queue_workspace.py",
    "ops/codex-ops/agent-board-kit/scanner_adapter.py",
    "ops/codex-ops/agent-board-kit/watchdog.py",
    "ops/learner_checks.py"
  ]
}
