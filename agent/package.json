{
  "name": "jev-sts2",
  "version": "0.1.0",
  "private": true,
  "description": "Play Slay the Spire 2 with Jev (TypeSafe System One) through the STS2-Agent mod's local HTTP API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor",
    "shadow": "tsx src/index.ts shadow",
    "play": "tsx src/index.ts play",
    "record": "tsx src/index.ts record",
    "replay": "tsx src/index.ts replay",
    "explain": "tsx src/index.ts explain",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "check:imports": "tsx tools/check-imports.ts",
    "test": "vitest run",
    "test:sandbox": "bash tools/test-sandbox.sh",
    "test:watch": "vitest",
    "fake-mod": "node tools/fake-mod.mjs",
    "knowledge:stats": "python3 ../knowledge/builders/build-outcome-stats.py"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.0.4"
  }
}
