new file mode 100644
index 000000000..cc549a375
--- /dev/null
+++ b/agent/src/reflex/silent-potion-reference.ts
@@ -0,0 +1,75 @@
+import { asRecord, str, type JsonValue } from "../core/util/json.js";
+import type { GameState } from "../hand/mod/schema.js";
+import { drunkIds, type PotionCost } from "./potion-cost.js";
+import type { Plan } from "./turn-solver.js";
+
+// The combat planner owns rollout-live; this formatter only reads its existing estimates.
+interface PotionEstimate {
+  horizon: number;
+  samples: number;
+  hpLoss: number;
+  wins: number;
+  deaths: number;
+  winProb: number;
+  turnsToWin: number | null;
+  laterDrinks?: Record<string, number>;
+}
+type PotionRollout = { available: false } | {
+  available: true;
+  result: { horizon: number; degraded: string[] };
+  byPlan: ReadonlyMap<Plan, PotionEstimate>;
+  noPotion: { line: Plan; base: Plan; merged: boolean } | null;
+};
+
+/** 751FN9QM9MHQ F13 T3, silent-0019: an absent held value is not a measured zero. */
+export function silentPotionReference(
+  state: GameState,
+  costs: ReadonlyMap<string, PotionCost>,
+  shown: { key: string; plan: Plan }[],
+  rollout: PotionRollout | null,
+): Record<string, JsonValue> {
+  if (str(asRecord(state.run?.raw)["character_id"]).toLowerCase() !== "silent" || state.run?.ascension !== 10) return {};
+  const unknown = [...costs.values()].filter((cost) => cost.holdHp === null);
+  if (unknown.length === 0) return {};
+  const active = rollout?.available ? rollout : null;
+  const forecast = active !== null && active.result.horizon > 1 && !active.result.degraded.includes("1-turn");
+  const dry = active?.noPotion;
+  const reference = dry ? (dry.merged ? dry.base : dry.line) : null;
+  const finite = (value: number | null): number | null => value !== null && Number.isFinite(value) ? value : null;
+  const options = shown.map(({ key, plan }) => {
+    const drinks = drunkIds(plan);
+    const estimate = active?.byPlan.get(plan);
+    const sampled = forecast && estimate !== undefined && estimate.horizon > 1 && estimate.samples > 0;
+    const later = sampled ? Object.entries(estimate.laterDrinks ?? {}).filter(([, count]) => count > 0)
+      .map(([id, count]) => ({ potion: id, samples_using: count })) : null;
+    const noPotionFight = sampled && plan === reference && drinks.length === 0 && later?.length === 0;
+    return {
+      key,
+      drinks_now: drinks,
+      no_potion_scope: drinks.length > 0 ? "drinks_now" : noPotionFight ? "sampled_fight_reference" : "current_turn_only",
+      prediction: {
+        hp_loss: finite(plan.outcome.hpLoss), damage: finite(plan.outcome.damageDealt),
+        cards_drawn: plan.outcome.cardsDrawn, unmodelled_cards: [...plan.outcome.unknownCards],
+      },
+      rollout_scope: sampled ? "sampled_horizon" : estimate ? "current_turn_and_clock" : "unavailable",
+      horizon: estimate?.horizon ?? null,
+      samples: sampled ? estimate.samples : null,
+      sampled_wins: sampled ? estimate.wins : null,
+      sampled_deaths: sampled ? estimate.deaths : null,
+      forecast_hp_loss: sampled ? finite(estimate.hpLoss) : null,
+      estimated_win_probability: sampled ? finite(estimate.winProb) : null,
+      mean_end_turn_surviving_samples: sampled ? finite(estimate.turnsToWin) : null,
+      later_drinks: later,
+    };
+  });
+  return { potion_value_reference: {
+    scope: "same_question_model_comparison",
+    unknown_held_values: unknown.map((cost) => ({
+      potion: cost.id, hold_hp: null, charged_hp: finite(cost.hp), zero_reason: cost.zero, source: cost.source,
+    })),
+    no_potion_now: options.filter((option) => option.drinks_now.length === 0).map((option) => option.key),
+    no_potion_fight_reference: options.filter((option) => option.no_potion_scope === "sampled_fight_reference").map((option) => option.key),
+    options,
+    note: "持有价值未知：成本记0不等于已证实留药价值为0。同题只对照已展示牌线的当轮预测与已有抽样；本轮不喝的线后续仍可能喝，整战无药参考单列。胜数只属所列回合样本，预计胜率含模型估计，终结回合仅对存活样本取均值。时钟估计不作抽样胜负；未知效果、抽牌重算、随机药水及实际执行仍须另核。未执行的无药或留药支线不是实盘反事实，不据本栏要求喝药或留药。",
+  } };
+}
diff --git a/agent/src/reflex/silent-razor-snakebite.ts b/agent/src/reflex/silent-razor-snakebite.ts
new file mode 100644
index 000000000..41729aa51
--- /dev/null
+++ b/agent/src/reflex/silent-razor-snakebite.ts
@@ -0,0 +1,35 @@
+import { asArray, asRecord, num, str } from "../core/util/json.js";
+
+// W1YY8PEWGUF9 F33 T10 / F45 T1, silent-0477/0478: certify the complete action, not upgrade order.
+export function observedRazorSnakebiteCard(raw: Record<string, unknown>, character: string, ascension: number | null): boolean {
+  const values = asArray(raw["dynamic_values"]).map(asRecord);
+  return character.toLowerCase() === "silent" && ascension === 10 && raw["card_id"] === "SNAKEBITE" &&
+    raw["upgraded"] === false && raw["energy_cost"] === 2 && raw["costs_x"] === false &&
+    raw["star_costs_x"] === false && raw["star_cost"] === 0 && raw["target_type"] === "AnyEnemy" &&
+    raw["requires_target"] === true && raw["enchantment"] == null &&
+    raw["rules_text"] === "给予{PoisonPower:diff()}层中毒。" &&
+    str(raw["resolved_rules_text"]).replace(/\s+/g, "") === "保留。给予7层中毒。重放1。" &&
+    values.length === 1 && values[0]?.["name"] === "PoisonPower" &&
+    ["base_value", "current_value", "enchanted_value"].every((field) => values[0]?.[field] === 7) &&
+    values[0]?.["is_modified"] === false && values[0]?.["was_just_upgraded"] === false;
+}
+
+const PLAYER_POWERS = new Set(["DEXTERITY_POWER", "INFINITE_BLADES_POWER", "DEMON_FORM_POWER", "MIND_ROT_POWER",
+  "STRENGTH_POWER", "SLOTH_POWER", "DISINTEGRATION_POWER"]);
+const ENEMY_POWERS = new Set(["STRENGTH_POWER", "WEAK_POWER"]);
+
+/** undefined: outside this evidence's role/relic; false: held, but the current board is unverified. */
+export function observedRazorSnakebiteScope(run: unknown, combat: Record<string, unknown>, ascension: number | null): boolean | undefined {
+  const raw = asRecord(run);
+  if (str(raw["character_id"]).toLowerCase() !== "silent" || ascension !== 10 ||
+      !asArray(raw["relics"]).some((entry) => {
+        const relic = asRecord(entry);
+        return relic["relic_id"] === "RAZOR_TOOTH" && relic["is_melted"] === false;
+      })) return undefined;
+  const player = asRecord(combat["player"]);
+  const enemies = asArray(combat["enemies"]).map(asRecord).filter((enemy) => num(enemy["current_hp"]) > 0);
+  // Unknown powers may alter the action; a missing list is not evidence of their absence.
+  return Array.isArray(player["powers"]) && asArray(player["powers"]).every((power) => PLAYER_POWERS.has(str(asRecord(power)["power_id"]))) &&
+    enemies.length === 1 && Array.isArray(enemies[0]!["powers"]) &&
+    asArray(enemies[0]!["powers"]).every((power) => ENEMY_POWERS.has(str(asRecord(power)["power_id"])));
+}
diff --git a/agent/src/reflex/silent-selection-audit.ts b/agent/src/reflex/silent-selection-audit.ts
new file mode 100644
index 000000000..cfe8132ed
--- /dev/null
+++ b/agent/src/reflex/silent-selection-audit.ts
@@ -0,0 +1,76 @@
+import { asRecord, str, type JsonValue } from "../core/util/json.js";
+import type { GameState } from "../hand/mod/schema.js";
+import type { ActionRequest } from "../hand/mod/client.js";
+import type { Plan } from "./turn-solver.js";
+import { silentHeldLossFacts } from "./silent-held-loss.js";
+
+export interface SelectionCandidate {
+  text: string;
+  plan: Plan | null;
+  sampled?: boolean;
+  rollout?: { horizon: number; samples: number; deaths: number; hpLoss: number };
+}
+
+/** 8JRE/YF0L/XP2S, silent-0079: a selected forecast is not an executed turn. */
+export function silentSelectionAudit(
+  state: GameState,
+  attempt: number | null,
+  stages: { answer: SelectionCandidate | null; beforeSl: SelectionCandidate | null; afterSl: SelectionCandidate | null },
+  requested: ActionRequest | null,
+): JsonValue | null {
+  if (str(asRecord(state.run?.raw)["character_id"]).toLowerCase() !== "silent" || state.run?.ascension !== 10) return null;
+  const snapshot = (candidate: SelectionCandidate | null): JsonValue => {
+    if (!candidate) return null;
+    const plan = candidate.plan;
+    return {
+      line: candidate.text,
+      outcome_kind: candidate.sampled ? "sampled_potion_median" : plan ? "turn_model" : "unavailable",
+      planned_steps: plan?.steps.map((step) => ({ card_id: step.cardId, upgraded: step.upgraded, card_index: step.cardIndex, target_index: step.target })) ?? null,
+      turn: plan ? {
+        ...(!candidate.sampled ? silentHeldLossFacts(state, plan) : {}),
+        hp_loss: plan.outcome.hpLoss,
+        damage: plan.outcome.damageDealt,
+        block_gained: plan.outcome.blockGained,
+        strength_gained: plan.outcome.strengthGained,
+        lasting_value: plan.outcome.lasting,
+        cards_drawn: plan.outcome.cardsDrawn,
+        sandpit_after: plan.outcome.sandpitAfter,
+        unmodelled_cards: [...plan.outcome.unknownCards],
+      } : null,
+      rollout: candidate.rollout ? {
+        scope: candidate.rollout.horizon > 1 ? "sampled_horizon" : "current_turn_and_clock",
+        horizon: candidate.rollout.horizon,
+        samples: candidate.rollout.horizon > 1 ? candidate.rollout.samples : null,
+        deaths: candidate.rollout.horizon > 1 ? candidate.rollout.deaths : null,
+        further_hp_loss: candidate.rollout.hpLoss,
+      } : null,
+    };
+  };
+  const original = stages.beforeSl?.plan;
+  const final = stages.afterSl?.plan;
+  return {
+    schema: 1,
+    scope: "predicted_candidates",
+    run_id: str(state.raw["run_id"]),
+    turn: state.turn,
+    attempt,
+    answer: snapshot(stages.answer),
+    before_sl: snapshot(stages.beforeSl),
+    after_sl: snapshot(stages.afterSl),
+    sl_delta: original && final ? {
+      hp_loss: final.outcome.hpLoss - original.outcome.hpLoss,
+      damage: final.outcome.damageDealt - original.outcome.damageDealt,
+      strength_gained: final.outcome.strengthGained - original.outcome.strengthGained,
+      lasting_value: final.outcome.lasting - original.outcome.lasting,
+    } : null,
+    requested_action: requested ? {
+      action: requested.action,
