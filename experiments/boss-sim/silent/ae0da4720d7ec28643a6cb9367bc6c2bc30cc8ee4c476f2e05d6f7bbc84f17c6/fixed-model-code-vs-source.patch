+  private readonly active: Set<string>;
+  private readonly used = new Map<string, { samples: number; rounds: number; stop: "eliminated" | "leader" | "max" }>();
+  private n = 0;
+  private finished = false;
+  private final: { leader: string; group: string[] } | null = null;
