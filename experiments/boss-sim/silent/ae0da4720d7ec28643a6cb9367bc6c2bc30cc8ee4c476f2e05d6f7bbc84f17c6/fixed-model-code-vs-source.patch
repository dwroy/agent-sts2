+  status: "complete" | "complete_adaptive" | "pending" | "degraded";
+  attempts: number;
+  reasons: string[];
+  samples: number;
+  requested: number;
+  failure: boolean;
+  key: string | null;
+}
+
+export function beginComputation(memory: ScreenMemory, state: GameState, label: string, inputKey: string | null): SimAttempt {
+  const key = inputKey === null ? null : memoKey("sim-failure-v1", {
+    run: state.raw["run_id"], floor: state.run?.floor, turn: state.turn, label,
+    board: fingerprint(state), inputKey,
+  });
+  if (!key || memory.simFailure?.key !== key) memory.simFailure = undefined;
+  const policy = simFailurePolicy(String(state.run?.raw["character_id"] ?? ""));
+  return new SimAttempt(memory, key, policy.enabled && (memory.simFailure?.count ?? 0) >= policy.retries);
+}
+
+export class SimAttempt {
+  private readonly id = randomUUID();
+  private readonly previous: { count: number; reasons: string[] };
+  constructor(private readonly memory: ScreenMemory, private readonly key: string | null, readonly degraded: boolean) {
+    this.previous = { count: memory.simFailure?.count ?? 0, reasons: [...(memory.simFailure?.reasons ?? [])] };
+  }
+  finish(samples: number, requested: number, reason?: string, adaptive = false): SimCompletion {
+    const reasons = reason ? [...this.previous.reasons, reason].slice(-32) : this.previous.reasons;
+    const attempts = this.previous.count + 1;
+    this.memory.simFailure = reason && this.key ? { key: this.key, count: attempts, reasons } : undefined;
+    return { required: true, attempt_id: this.id, status: this.degraded ? "degraded" : reason ? "pending" : adaptive ? "complete_adaptive" : "complete",
+      attempts, reasons, samples, requested, failure: reason !== undefined, key: this.key };
+  }
+}
diff --git a/agent/src/sim/computation-wait.ts b/agent/src/sim/computation-wait.ts
new file mode 100644
index 000000000..69c6db00d
--- /dev/null
+++ b/agent/src/sim/computation-wait.ts
@@ -0,0 +1,46 @@
+/** Progress callbacks also work inside B2's synchronous worker polling loop. */
+import { mkdirSync, renameSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+
+export type SimProgress = (done: number, requested: number) => void;
+export interface SimWait {
+  start(context: { run: string; floor: number | null; label: string }): { progress: SimProgress; finish(): void };
+}
+
+export function fileSimWait(path: string, note: (text: string) => void, now = Date.now): SimWait {
+  return { start(context) {
+    const started = now();
+    let emitted = started;
+    let previous = 0;
+    let done = 0;
+    let requested = 0;
+    let lastProgress = emitted;
+    const write = (active: boolean) => {
+      const ts = now();
+      const row = { ts: new Date(ts).toISOString(), ...context, pid: process.pid, active,
+        samples_done: done, requested, previous_samples: previous, elapsed_ms: ts - started,
+        progress_ts: new Date(lastProgress).toISOString(), unit: "sample-outcomes" };
+      try {
+        mkdirSync(dirname(path), { recursive: true });
+        const temp = `${path}.${process.pid}.tmp`;
+        writeFileSync(temp, JSON.stringify(row) + "\n");
+        renameSync(temp, path);
+      } catch (error) { note(`simulation heartbeat write failed: ${String(error)}`); }
+      if (active) note(`required simulation ${context.label}: ${done}/${requested} sample outcomes, ${Math.round((ts - started) / 1000)} s`);
+      emitted = ts;
+      previous = done;
+    };
+    // Inactive until a real progress callback; an old computation cannot keep a new one alive.
+    write(false);
+    return {
+      progress(count, total) {
+        if (total !== requested || count < done) { previous = 0; done = 0; }
+        if (count > done) lastProgress = now();
+        done = count;
+        requested = total;
+        if (now() - emitted >= 60_000) write(true);
+      },
+      finish() { write(false); },
+    };
+  } };
+}
