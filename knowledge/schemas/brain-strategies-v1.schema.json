{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-strategies-v1.schema.json",
  "title": "Brain text strategies v1",
  "description": "Runtime additionally validates unique ids, min<=max, whitespace-only text, UTF-8 byte caps and file size.",
  "type": "object",
  "required": [
    "schema",
    "character",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "brain-strategies-v1"
    },
    "character": {
      "const": "silent"
    },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "trigger",
          "strategy",
          "evidence",
          "source",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_types"
            ],
            "properties": {
              "question_types": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "card_reward",
                    "event",
                    "rest",
                    "shop",
                    "act_plan"
                  ]
                }
              },
              "acts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                }
              },
              "floor": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "bosses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hp_ratio": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "deck_size": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "deck_cards": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "count"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "min": {
                          "type": "number",
                          "minimum": 0
                        },
                        "max": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "strategy": {
            "type": "string",
            "minLength": 1,
            "description": "Runtime also enforces <=1200 UTF-8 bytes."
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "run",
                "floor"
              ],
              "properties": {
                "run": {
                  "type": "string",
                  "minLength": 1
                },
                "floor": {
                  "type": "integer",
                  "minimum": 0
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "source": {
            "type": "string",
            "pattern": "^(own|external:.+)$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance": {
            "type": "object",
            "required": [
              "url",
              "version",
              "sha256",
              "license"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "license": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "pattern": "^external:"
                }
              }
            },
            "then": {
              "required": [
                "provenance"
              ]
            }
          }
        ]
      }
    }
  }
}
