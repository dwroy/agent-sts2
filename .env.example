# --- Jev (TypeSafe System One) -------------------------------------------------
# Required. Create one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Optional gateway/proxy override; defaults to https://api.typesafe.ai
#TYPESAFE_BASE_URL=
# Pinned on purpose: aliases move when a new release ships (PLAN.md §9)
JEV_MODEL=jev-1.13.0

# --- Slay the Spire 2 / STS2-Agent mod -----------------------------------------
# The mod's real port can differ when 8080 is taken; we re-read it from /health.
STS2_BASE_URL=http://127.0.0.1:8080
STS2_PORT_SCAN=8080-8090
STS2_TIMEOUT_MS=10000

# --- Decision policy (used from M2 onward) -------------------------------------
CONFIDENCE_ACT=0.55
CONFIDENCE_STRONG=0.75
MAX_REQUESTS=2000
MAX_TOKENS=20M

# --- Optional OpenAI-compatible enricher (PLAN.md §5.4) ------------------------
# Off by default, and never used on the decision path.
ENRICHER_ENABLED=false
#ENRICHER_BASE_URL=http://127.0.0.1:11434/v1
#ENRICHER_API_KEY=
#ENRICHER_MODEL=qwen3:8b
ENRICHER_TASKS=run_brief

# --- Runtime -------------------------------------------------------------------
# shadow | play | record | replay
MODE=shadow
LOG_LEVEL=info
DECISION_LOG=./logs/decisions.jsonl

# --- New-run behaviour ---------------------------------------------------------
# auto: continue an existing run when the mod offers it, otherwise start a new one
# new:  always start a fresh run      continue: only ever continue
RUN_START=auto
# Character id or name to pick when starting a run (e.g. IRONCLAD); empty = first unlocked
#CHARACTER=IRONCLAD
# Prompts that turn tutorials on are never answered automatically; set true to allow that
ALLOW_FTUE_MODALS=false
# Trust Jev completely: act on its answer even when its confidence is low, and never substitute a
# code-chosen action (the legality gate still applies). false restores the code fallback.
STRICT_JEV=true
# Potion ids or names to drop when entering a shop before browsing (comma separated).
SHOP_DISCARD_POTIONS=FOUL_POTION

# --- Phase 2 -------------------------------------------------------------------
# turn: whole-turn combat solver, Jev decides close calls | card: original per-card question
COMBAT_PLANNER=turn
# DeepSeek escalation for Jev's near-guesses on high-stakes calls (off when no key).
#DEEPSEEK_API_KEY=
#DEEPSEEK_API_KEY_FILE=~/path/to/deepseek.key
#DEEPSEEK_MODEL=deepseek-chat
# Per play process (one run). BUILD_DECIDER=deepseek asks ~25-80 build/route/rest questions a run.
#DEEPSEEK_MAX_CALLS=300
# deepseek (default): DeepSeek decides card rewards, shops, removals/upgrades, events, relics, rest sites
# and plans each act's route (code follows it); Jev then code when DeepSeek fails. jev: the old escalation.
#BUILD_DECIDER=deepseek
# on (default): with BUILD_DECIDER=deepseek, a shop visit (one shopping list), a rest site (heal or smith a named
# card), an event option that picks deck cards, and the act-2/3 Ancient with the act's route are one question
# each; code plays the steps. off: the step-by-step questions (one purchase / the card on the next screen).
#BUILD_ONESHOT=on
# v1: DeepSeek sets the run's strategy (src/strategy/run-plan.ts) at the run start, each new act, a heavy HP loss and
# every 8 floors; code weighs build/route/rest choices by it and Jev and the brain see it. off (default): no run plan.
#RUN_PLAN=v1
# on (default; Dai 2026-10-02, notes/run-plan-merge.md): with RUN_PLAN=v1 and BUILD_DECIDER=deepseek, a due run plan
# rides on the next DeepSeek question (the act-start Ancient, a card reward, a rest site, a shop, an event; the run
# start on the run's first question) instead of its own call at the map; its own call only when no question carried it
# within 2 floors or the act boss is next. off: the run plan's own call at the map, exactly as before.
#RUN_PLAN_MERGE=on
# on: in-combat card picks may still escalate to DeepSeek on Jev's near-guesses (default off with
# BUILD_DECIDER=deepseek: combat stays with code and Jev; turn plans never escalate).
#COMBAT_DEEPSEEK=off
# on (default; docs/thief.md): while a Thieving Hopper (a stolen card) or a Gremlin Merc / Fat Gremlin (stolen gold)
# carries something, the combat question says what, and how many turns are left to kill it before it leaves; the
# rollout lets an enemy whose Escape resolves leave the fight; a line that kills it before it leaves stays among the
# options. No HP cost is put on the loss. off: the combat question exactly as before.
#THIEF_FACTS=on
# on (the default since 2026-10-02; docs/thief.md §7, needs THIEF_FACTS=on): the loot a thief may take away counts as HP in the
# rollout's ranking, like a potion's cost (deaths first): the Hopper's stolen card at its worth in this act's boss
# fight (whole-fight simulation, with and without the card and at 10 HP less; once per fight, up to ~15 s), the gold
# at the potion table's rate (potion price and held value). off: everything exactly as with THIEF_FACTS alone.
#THIEF_COST=on
# on (default; docs/mechanics-learning.md): mechanics learned from the logs (monster-db.json `observed`) are used. A line that
# strips an enemy power whose strip to 0 stunned that enemy in the logs (the Thieving Hopper's last Flutter) cancels its
# move this turn in the turn solver and the rollout (its attack out of hp_lost, an Escape a turn later), the option says
# so, Jev's enemy powers carry the observation, and the knowledge prefix renders the notable ones. off: the combat
# question and the knowledge prefix exactly as before.
#MECH_RULES=on
# on (default; docs/mechanics-learning.md §8; needs MECH_RULES=on): the second learned class, "a power removed or lowered ->
# the enemy's move changes" (an Axebot killed with Stock left revives into Boot Up, no attack), in the solver, the rollout,
# the option's fact, the enemy powers' note and the knowledge prefix; and the Kaiser Crab's back attack (x1.5 from the claw
# behind us) only while both claws live. off: the combat question and the knowledge prefix exactly as with MECH_RULES alone.
#MECH_MOVE_RULES=on
# on (default; docs/mechanics-learning.md §9; needs MECH_RULES=on): the class learned from the logged multi-enemy fights, "an
# ally's death changes a survivor's move" (the Torch Head Amalgam dying: the Queen's Burn Bright For Me becomes Enrage at once,
# Off With Your Head next turn), in the solver, the rollout, the whole-fight boss sim and the option's fact. off: the combat
# question as without it.
#MECH_DEATH_MOVE=on
# on (default; src/strategy/passive-pieces.ts): the passive damage and block pieces (Thorns, Flame Barrier, Mercury Hourglass,
# Inferno, Sai, Crimson Mantle, Plating, Orichalcum, Ripple Basin, Horn Cleat, Letter Opener, Ornamental Fan, Parrying Shield)
# in the rollout's later turns, the whole-fight boss sim and the boss clock; the clock's passive damage is not cut by the
# Queen's Weak; Orichalcum, Ripple Basin, Letter Opener, Ornamental Fan and Parrying Shield in the live solver's current turn
# too (Plating does not stop Orichalcum). off: all of them exactly as before.
#PASSIVE_PIECES=on
# on (default; rollout.ts RolloutOptions.sandpitStart): the Insatiable's turn-1 Liquify Ground starts its Sandpit (4) in the 5-turn
# rollout's later turns too, with its Frantic Escapes 3 into the draw pile, as the whole-fight sim does. off: as before, a
# turn-1 rollout played the boss without its Sandpit (no Sandpit death in any later turn, the 6 Escapes dead cards).
#SANDPIT_START=on
# Lessons from past runs, appended to DeepSeek's system prompt after the strategy guide (skipped when missing).
#DEEPSEEK_HANDBOOK_FILE=src/knowledge/ds-handbook.md
# --- V4 brain engine (src/brain/router.ts) --------------------------------------------
# Which engine answers the strategy questions (deepseek by default: v3 behaviour); BRAIN_FALLBACK answers a question the
# engine fails or times out on. codex: `codex exec` under the ChatGPT login in ~/.codex (src/brain/engines/codex.ts:
# isolated from codex's user setup, no tools; a used-up plan sends every question to the fallback for the process).
#BRAIN_ENGINE=codex
#BRAIN_FALLBACK=deepseek
#BRAIN_CODEX_MODEL=gpt-6.1-sol
#BRAIN_CODEX_EFFORT=xhigh
# Per call (default 10 minutes); no call limit by default.
#BRAIN_CODEX_TIMEOUT_MS=600000
# Stalls: after the first output token (codex's telemetry), a stream silent this long is killed and asked once more
# (BRAIN_CODEX_STALL_RETRIES), then the fallback answers; BRAIN_CODEX_FIRST_TOKEN_MS caps the thinking before it (off by
# default). Every codex run leaves a row in codex-calls.jsonl next to brain.jsonl (its event timeline, no prompt).
#BRAIN_CODEX_STALL_MS=120000
#BRAIN_CODEX_FIRST_TOKEN_MS=240000
#BRAIN_CODEX_STALL_RETRIES=1
# exec (default): one `codex exec` per question. session: one `codex app-server` per process with one saved thread that
# holds the system prompt; each question is a turn reverted after it (the prompt cache holds within a question kind).
# It falls back to exec for the process when ~/.codex/config.toml has more than model / model_reasoning_effort / [tui],
# when the thread loads an instruction file, or when its server fails twice. Its thread is deleted at exit.
#BRAIN_CODEX_MODE=session
# Session mode: a streamed answer longer than this is given up on as a stall (asked once more, then the fallback).
#BRAIN_CODEX_MAX_ANSWER_CHARS=2000
# Session mode: so is one with this many whitespace characters in a row between its JSON tokens (the runaways' form:
# whitespace without end after the reason; answered turns pad at most ~9). off: none.
#BRAIN_CODEX_MAX_ANSWER_BLANKS=100
# Codex's answer schema (both modes): route_reason left out (drop, default; only logged; the runaways were in it) or kept
# (keep, capped at 60 characters), and a maxLength on every free-text field (default 600; off: none).
#BRAIN_CODEX_ROUTE_REASON=drop
#BRAIN_CODEX_MAX_FIELD_CHARS=600
# Codex's answer schema: used (default) holds only the fields the question uses (route with a route review or an act
# route, cards with eligible_cards, discard with a discard option, run_plan with a due run plan); all is the kind's whole
# stable schema, every unused field answered null (its picks without a route ran away 5 of 10 in the 2026-10-03 A/B, the
# used schema 0 of 10). reason last: tested, not better (off).
#BRAIN_CODEX_SCHEMA_FIELDS=used
#BRAIN_CODEX_REASON_LAST=off
# Codex's route field takes only "keep" or space-separated node ids (a pattern strict mode enforces): at xhigh codex
# wrote its route_reason or second thoughts into route ("keep fin? No must exact keep"). A route of "keep" plus words
# without a node id is read as keep either way (logged in brain.jsonl's notes).
#BRAIN_CODEX_ROUTE_PATTERN=on
# Session mode: a runaway cut whose streamed prefix already closes into a whole answer (every required field, the
# question's checks pass) is taken instead of asking again; brain.jsonl's row notes it (5 of 5 in the A/B were whole).
#BRAIN_CODEX_ACCEPT_CUT=on
#BRAIN_CODEX_MAX_CALLS=off
# The program (default: codex on PATH, else ~/.local/node/bin/codex) and its home with the login (default ~/.codex).
#BRAIN_CODEX_BIN=/home/dw/.local/node/bin/codex
#BRAIN_CODEX_HOME=/home/dw/.codex
# priority: Fast (about 2x speed, more usage); unset: the standard tier.
#BRAIN_CODEX_SERVICE_TIER=priority
# Usage guard (src/brain/engines/codex-usage.ts, experiments/brain-replay/codex-usage.md): the plan's windows and credits
# are read (account/rateLimits/read, a short-lived `codex app-server`, ~0.9 s) at process start and before a call every
# EVERY_CALLS calls or EVERY_MIN minutes. Codex is off for the rest of the process once any window is at STOP_PCT % or
# credits are in use (balance falling, plan usage not allowed, a limit reached); past the plan's limit the backend
# spends credits by itself. A read that fails is said once and codex stays on, unless REQUIRED=on: then codex is off
# until a read works (its questions to the fallback; read again after 30 s, 2 min, 5 min, then every 10 min). A read
# refused on the login (401, an expired token) first has codex refresh its token (account/read), then reads again.
#BRAIN_CODEX_USAGE_STOP_PCT=80
#BRAIN_CODEX_USAGE_EVERY_CALLS=3
#BRAIN_CODEX_USAGE_EVERY_MIN=10
#BRAIN_CODEX_USAGE_REQUIRED=off
# Escalation order: claude = the supervising Claude session answers via logs/escalation files
ESCALATION_CHAIN=claude,deepseek
CLAUDE_ESCALATION_TIMEOUT_MS=90000
# --- SL (docs/sl.md) ---------------------------------------------------------------
# on: a boss fight, or one of the hard fights in src/sl/sl-elites.json (any room), whose enemy turn certainly kills us is
# reloaded (save_and_quit, continue_run: the game restarts the fight from its room-entry save) instead of played.
# On by default (Dai 2026-10-02); off: no SL at all.
#SL_ENABLED=on
# Retries per fight: a boss fight gets at most 1 + SL_BOSS_RETRIES attempts, a listed elite 1 + SL_ELITE_RETRIES.
#SL_BOSS_RETRIES=5
#SL_ELITE_RETRIES=3
# on: an act-3 fight with no boss (hallway, elite, ? room) entered with HP strictly below SL_ACT3_LOW_HP_PCT percent of
# max HP gets SL like a listed hard fight (1 + SL_ELITE_RETRIES attempts, certain death only; docs/sl.md §3). Default on
# (Dai 2026-10-03), line 40; off: as before.
#SL_ACT3_LOW_HP=on
#SL_ACT3_LOW_HP_PCT=50
# SL_ACT2_LOW_HP (default on, Dai 2026-10-04): the same rule for an act-2 fight with no boss (PEGL F30 entered 12/80, untracked).
#SL_ACT2_LOW_HP=on
#SL_ACT2_LOW_HP_PCT=50
# on: a retried boss fight shows the whole-fight simulation even for a low-trust boss (labelled 低可信; ranking unchanged).
#SL_RETRY_SHOW_SIM=on
# on: on a retry the draw pile's next cards are the order the earlier attempt drew them in (the solver, the rollout, the
# random potions and B2 use it; Jev is told), until a reshuffle or a different draw (docs/sl.md §10). Default on.
#SL_RETRY_KNOWN_DRAWS=on
# on: attempts after the first get more compute: rollout samples x3 and its time budget up to 20 s a decision (30 s a turn),
# the random potions' samples x3, B2's samples x2 (docs/sl.md §10). Default on.
#SL_RETRY_COMPUTE=on
# on: on a retry, a rollout or B2 run on an input an earlier attempt computed (the same board, replayed) comes back from
# the fight's memo instead of being computed again: the same numbers and question, no time (docs/sl.md §10.6). Default on.
#SL_RETRY_MEMO=on
# on: a playable card that draws does not veto the certain-death judge's least-loss tier when the retry's known draws
# covered every draw the planner's lines made (docs/sl.md §2). Default on.
#SL_JUDGE_KNOWN_DRAWS=on
# on: reload at the planner's least-loss verdict (every simulated line dies), before its line is played card by card, when
# the judge is certain on that board and the line ends as simulated; otherwise at end_turn (docs/sl.md §2). Default on.
#SL_RELOAD_EARLY=on
# on: a turn end where only a revive held (Fairy in a Bottle, Lizard Tail) would save us is judged as without it: the fight
# reloads instead of burning the revive. Off (default; Dai deciding): the judge plays the revives out hit by hit and
# reloads only when they cannot stop the death (docs/sl.md §2.7).
#SL_RELOAD_ON_REVIVE=off
# on: cards added to the draw pile at random places (the Insatiable's Frantic Escape, Dazed, Metamorphosis) keep the
# known draw order; the samples put them at random places among the known cards (docs/sl.md §10). Default on.
#SL_RETRY_KNOWN_INSERTS=on
# on (with SL_RETRY_KNOWN_INSERTS): a card moved onto the draw pile (Headbutt, Thinking Ahead) is on top, the next one
# drawn: the known order goes on through it, exactly (docs/sl.md §10). Default on.
#SL_RETRY_KNOWN_TOP=on
# on (with SL_RETRY_KNOWN_INSERTS): cards played off the top of the draw pile (Distilled Chaos, Havoc, Cascade) were its
# next cards, and Hellraiser's Strikes played as drawn were among the step's draws: the known order goes on past them
# (docs/sl.md §10.2). Default on.
#SL_RETRY_KNOWN_OFF_TOP=on
# on (with SL_RETRY_KNOWN_INSERTS): a card drawn while a copy of it was played in the same step is read by the hand's
# order, not taken for one that left the pile otherwise (docs/sl.md §10.2). Default on.
#SL_RETRY_KNOWN_HAND_ORDER=on
# on (with SL_RETRY_EXPLORE_REPLAY): before the deviation point, a board whose reference line is not among the options
# plays the reference attempt's logged plays from there when they are legal (docs/sl.md §11.2). Default on.
#SL_RETRY_EXPLORE_REPLAY_PLAYS=on
# on (with SL_RETRY_EXPLORE_REPLAY): a replay that cannot go on deviates where it stopped, on the first board a failed
# attempt decided on, instead of playing on into a failed attempt's fight (docs/sl.md §11.2). Default on.
#SL_RETRY_EXPLORE_REPLAY_DEVIATE=on
# on: in the board key a relic counter that wraps to 0 (Happy Flower 3, Kunai 3, Nunchaku 10, ...) shown at its count reads 0
# (the frame came before the reset showed; docs/sl.md §11.12). Default on.
#SL_RETRY_EXPLORE_KEY_COUNTERS=on
# on (with SL_RETRY_EXPLORE_CANON): attempt 2 deviates where it is still on attempt 1's path from the turn attempt 1 lost the
# most HP (docs/sl.md §11.13). Default on.
#SL_RETRY_EXPLORE_SECOND=on
# on (with SL_RETRY_EXPLORE_REPLAY_PLAYS): a board of the reference path where a line has the reference's turn in another
# order plays the reference's logged plays in their order (the order changes the board; docs/sl.md §11.14). Default on.
#SL_RETRY_EXPLORE_REPLAY_ORDER=on
# on (with SL_RETRY_EXPLORE_REPLAY_PLAYS): a board of the reference path where code plays its own line and that line is not
# the reference's plays from there plays the reference's logged plays instead (docs/sl.md §11.16). Default on.
#SL_RETRY_EXPLORE_REPLAY_CODE=on
# on (with SL_RETRY_EXPLORE_REPLAY_DEVIATE): an attempt off the reference path before its point still deviates on the
# point's turn, the point's lines and failed turns kept off (docs/sl.md §11.14). Default on.
#SL_RETRY_EXPLORE_TARGET_TURN=on
# on: a deviation whose turn still ended with a failed attempt's plays aims at a later point of the reference path in the
# same attempt (docs/sl.md §11.15). Default on.
#SL_RETRY_EXPLORE_REARM=on
# on: a deviation's turn repeats a failed one also when it differs only by card upgrades, when it is a failed attempt's turn
# from the same turn start, or when the next turn begins on a failed attempt's board; REARM uses it, off the path too
# (docs/sl.md §11.17). Default on.
#SL_RETRY_EXPLORE_WASTED=on
# on: the reference path of attempts 3+ is the failed attempt that lived longest (latest turn, then least enemy HP left);
# attempt 1 records its decision points for it, its decisions unchanged (docs/sl.md §11.16). Default on.
#SL_RETRY_EXPLORE_ANCHOR=on
# on: attempts 3 and later change the line at one decision point a failed attempt played (the question closest to the
# death first, then one further back each attempt) to the best line no failed attempt played there; every other board
# plays as usual, Jev's questions unchanged (docs/sl.md §11). Default on; off: retries as before.
#SL_RETRY_EXPLORE=on
# One row per attempt (default next to the decision log; off: none). Each reload step's wait (main menu, then the fight).
#SL_LOG=./logs/sl-attempts.jsonl
#SL_STEP_TIMEOUT_MS=60000
