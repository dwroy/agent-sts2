# --- Jev (TypeSafe System One) -------------------------------------------------
# Required. Create one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Optional gateway/proxy override; defaults to https://api.typesafe.ai
#TYPESAFE_BASE_URL=
# Pinned on purpose: aliases move when a new release ships (PLAN.md §9)
JEV_MODEL=jev-1.13.0

# --- Slay the Spire 2 / STS2-Agent mod -----------------------------------------
# The mod's real port can differ when 8080 is taken; we re-read it from /health.
STS2_BASE_URL=http://127.0.0.1:8080
STS2_PORT_SCAN=8080-8090
STS2_TIMEOUT_MS=10000

# --- Decision policy (used from M2 onward) -------------------------------------
CONFIDENCE_ACT=0.55
CONFIDENCE_STRONG=0.75
MAX_REQUESTS=2000
MAX_TOKENS=20M

# --- Optional OpenAI-compatible enricher (PLAN.md §5.4) ------------------------
# Off by default, and never used on the decision path.
ENRICHER_ENABLED=false
#ENRICHER_BASE_URL=http://127.0.0.1:11434/v1
#ENRICHER_API_KEY=
#ENRICHER_MODEL=qwen3:8b
ENRICHER_TASKS=run_brief

# --- Runtime -------------------------------------------------------------------
# shadow | play | record | replay
MODE=shadow
LOG_LEVEL=info
DECISION_LOG=./logs/decisions.jsonl

# --- New-run behaviour ---------------------------------------------------------
# auto: continue an existing run when the mod offers it, otherwise start a new one
# new:  always start a fresh run      continue: only ever continue
RUN_START=auto
# Character id or name to pick when starting a run (e.g. IRONCLAD); empty = first unlocked
#CHARACTER=IRONCLAD
# Prompts that turn tutorials on are never answered automatically; set true to allow that
ALLOW_FTUE_MODALS=false
# Trust Jev completely: act on its answer even when its confidence is low, and never substitute a
# code-chosen action (the legality gate still applies). false restores the code fallback.
STRICT_JEV=true
# Potion ids or names to drop when entering a shop before browsing (comma separated).
SHOP_DISCARD_POTIONS=FOUL_POTION

# --- Phase 2 -------------------------------------------------------------------
# turn: whole-turn combat solver, Jev decides close calls | card: original per-card question
COMBAT_PLANNER=turn
# DeepSeek escalation for Jev's near-guesses on high-stakes calls (off when no key).
#DEEPSEEK_API_KEY=
#DEEPSEEK_API_KEY_FILE=~/path/to/deepseek.key
#DEEPSEEK_MODEL=deepseek-chat
# Per play process (one run). BUILD_DECIDER=deepseek asks ~25-80 build/route/rest questions a run.
#DEEPSEEK_MAX_CALLS=300
# deepseek (default): DeepSeek decides card rewards, shops, removals/upgrades, events, relics, rest sites
# and plans each act's route (code follows it); Jev then code when DeepSeek fails. jev: the old escalation.
#BUILD_DECIDER=deepseek
# on (default): with BUILD_DECIDER=deepseek, a shop visit (one shopping list), a rest site (heal or smith a named
# card), an event option that picks deck cards, and the act-2/3 Ancient with the act's route are one question
# each; code plays the steps. off: the step-by-step questions (one purchase / the card on the next screen).
#BUILD_ONESHOT=on
# on: in-combat card picks may still escalate to DeepSeek on Jev's near-guesses (default off with
# BUILD_DECIDER=deepseek: combat stays with code and Jev; turn plans never escalate).
#COMBAT_DEEPSEEK=off
# on (default; docs/thief.md): while a Thieving Hopper (a stolen card) or a Gremlin Merc / Fat Gremlin (stolen gold)
# carries something, the combat question says what, and how many turns are left to kill it before it leaves; the
# rollout lets an enemy whose Escape resolves leave the fight; a line that kills it before it leaves stays among the
# options. No HP cost is put on the loss. off: the combat question exactly as before.
#THIEF_FACTS=on
# on (the default since 2026-10-02; docs/thief.md §7, needs THIEF_FACTS=on): the loot a thief may take away counts as HP in the
# rollout's ranking, like a potion's cost (deaths first): the Hopper's stolen card at its worth in this act's boss
# fight (whole-fight simulation, with and without the card and at 10 HP less; once per fight, up to ~15 s), the gold
# at the potion table's rate (potion price and held value). off: everything exactly as with THIEF_FACTS alone.
#THIEF_COST=on
# Lessons from past runs, appended to DeepSeek's system prompt after the strategy guide (skipped when missing).
#DEEPSEEK_HANDBOOK_FILE=src/knowledge/ds-handbook.md
# Escalation order: claude = the supervising Claude session answers via logs/escalation files
ESCALATION_CHAIN=claude,deepseek
CLAUDE_ESCALATION_TIMEOUT_MS=90000
# --- SL (docs/sl.md) ---------------------------------------------------------------
# on: a boss fight, or one of the hard fights in src/sl/sl-elites.json (any room), whose enemy turn certainly kills us is
# reloaded (save_and_quit, continue_run: the game restarts the fight from its room-entry save) instead of played.
# On by default (Dai 2026-10-02); off: no SL at all.
#SL_ENABLED=on
# Retries per fight: a boss fight gets at most 1 + SL_BOSS_RETRIES attempts, a listed elite 1 + SL_ELITE_RETRIES.
#SL_BOSS_RETRIES=5
#SL_ELITE_RETRIES=3
# on: a retried boss fight shows the whole-fight simulation even for a low-trust boss (labelled 低可信; ranking unchanged).
#SL_RETRY_SHOW_SIM=on
# One row per attempt (default next to the decision log; off: none). Each reload step's wait (main menu, then the fight).
#SL_LOG=./logs/sl-attempts.jsonl
#SL_STEP_TIMEOUT_MS=60000
